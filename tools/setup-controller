#!/usr/bin/env bash
# Turn a Debian 12 container into the NullBill controller (ADR 0006). Run as
# root inside the `nullbill` container, from the checkout at /opt/nullbill;
# install.sh does this. Safe to run again: each step checks first.
#
# Installs: Python packages (venv at /opt/nullbill/venv), the pinned
# community.proxmox collection, OpenTofu, sops (each checked against a pinned
# SHA-256), age from Debian, and an SSH key for root on the PVE host.
set -euo pipefail
cd "$(dirname "$0")/.."
root=$PWD

tofu_version=1.13.2
tofu_sha256=ac05d9952662c7db28dd57e93f0a68018837bfdf9342384ec0987977c16a9645
sops_version=3.13.3
sops_sha256=e5bec3346a873ae91d871550f3e698c1aad962aff462a080e40f25fde17fef6b
home=${NULLBILL_HOME:-/var/lib/nullbill}

fetch() { # url sha256 dest
  local tmp
  tmp=$(mktemp)
  curl -fsSLo "$tmp" "$1"
  echo "$2  $tmp" | sha256sum -c --quiet || { rm -f "$tmp"; echo "checksum mismatch for $1" >&2; exit 1; }
  mv "$tmp" "$3"
}

export DEBIAN_FRONTEND=noninteractive
apt-get update -qq
apt-get install -y -qq --no-install-recommends python3-venv git openssh-client age curl ca-certificates >/dev/null

if [ ! -x "$root/venv/bin/python3" ]; then
  python3 -m venv "$root/venv"
fi
# shellcheck disable=SC1091
. "$root/venv/bin/activate"
pip install -q -e "$root"
COLLECTIONS_DIR="$root/.ansible/collections" tools/install-apply-deps

if ! /usr/local/bin/tofu version 2>/dev/null | grep -q "v$tofu_version"; then
  fetch "https://github.com/opentofu/opentofu/releases/download/v$tofu_version/tofu_${tofu_version}_linux_amd64.tar.gz" "$tofu_sha256" /tmp/tofu.tar.gz
  tar -xzf /tmp/tofu.tar.gz -C /usr/local/bin tofu
  rm -f /tmp/tofu.tar.gz
fi
if ! echo "$sops_sha256  /usr/local/bin/sops" | sha256sum -c --quiet 2>/dev/null; then
  fetch "https://github.com/getsops/sops/releases/download/v$sops_version/sops-v$sops_version.linux.amd64" "$sops_sha256" /usr/local/bin/sops
  chmod 0755 /usr/local/bin/sops
fi

install -d -m 0700 "$home" /root/.ssh
if [ ! -f /root/.ssh/id_ed25519 ]; then
  ssh-keygen -q -t ed25519 -N '' -C "nullbill@$(hostname)" -f /root/.ssh/id_ed25519
fi
echo "controller ready: $(python3 --version), tofu $tofu_version, sops $sops_version, $(age --version 2>&1 | head -1)"
