#!/usr/bin/env bash
# Turn a Debian 13 container into the NullBill controller (ADR 0006). Run as
# root inside the `nullbill` container, from the checkout at /opt/nullbill;
# install.sh does this. Safe to run again: each step checks first.
#
# Installs: Python packages (venv at /opt/nullbill/venv), the pinned
# community.proxmox collection, OpenTofu, sops (each checked against a pinned
# SHA-256), age from Debian, an SSH key for root on the PVE host, and the
# page's agent: the agent CLI the operator pins (docs/adr/0002-agent-cli.md),
# run by the page as the unprivileged user nbagent (docs/adr/0010-page-agent.md).
set -euo pipefail
cd "$(dirname "$0")/.."
root=$PWD
# The page's agent runs as nbagent and reads this checkout: its tools are
# `python -m nullbill agent-tools`. Updates checked out under the page's
# UMask=0077 left changed files root-only and the tools did not start, so
# make everything here readable again (no secrets live here) and write the
# rest with the usual umask.
umask 022
chmod -R go+rX "$root"

tofu_version=1.13.2
tofu_sha256=ac05d9952662c7db28dd57e93f0a68018837bfdf9342384ec0987977c16a9645
sops_version=3.13.3
sops_sha256=e5bec3346a873ae91d871550f3e698c1aad962aff462a080e40f25fde17fef6b
home=${NULLBILL_HOME:-/var/lib/nullbill}

fetch() { # url sha256 dest [sha512sum]
  local tmp
  tmp=$(mktemp)
  curl -fsSLo "$tmp" --retry 4 "$1"
  echo "$2  $tmp" | "${4:-sha256sum}" -c --quiet || { rm -f "$tmp"; echo "checksum mismatch for $1" >&2; exit 1; }
  mv "$tmp" "$3"
}

export DEBIAN_FRONTEND=noninteractive
apt-get update -qq
apt-get install -y -qq --no-install-recommends python3-venv git openssh-client age curl ca-certificates >/dev/null

# Made again when its Python is gone, as after a Debian upgrade.
if ! "$root/venv/bin/python3" -c 'import pip' 2>/dev/null; then
  rm -rf "$root/venv"
  python3 -m venv "$root/venv"
fi
# shellcheck disable=SC1091
. "$root/venv/bin/activate"
pip install -q -e "$root"
COLLECTIONS_DIR="$root/.ansible/collections" tools/install-apply-deps

if ! /usr/local/bin/tofu version 2>/dev/null | grep -q "v$tofu_version"; then
  fetch "https://github.com/opentofu/opentofu/releases/download/v$tofu_version/tofu_${tofu_version}_linux_amd64.tar.gz" "$tofu_sha256" /tmp/tofu.tar.gz
  tar -xzf /tmp/tofu.tar.gz -C /usr/local/bin tofu
  rm -f /tmp/tofu.tar.gz
fi
if ! echo "$sops_sha256  /usr/local/bin/sops" | sha256sum -c --quiet 2>/dev/null; then
  fetch "https://github.com/getsops/sops/releases/download/v$sops_version/sops-v$sops_version.linux.amd64" "$sops_sha256" /usr/local/bin/sops
  chmod 0755 /usr/local/bin/sops
fi

# The page's agent. One pin for it and the operator's: the role's defaults.
pins=ansible/roles/operator/defaults/main.yml
claude_version=$(sed -n 's/^operator_claude_code_version: *//p' "$pins")
claude_sha512=$(sed -n 's/^operator_claude_code_sha512: *//p' "$pins")
claude_dir=/opt/claude-code/$claude_version
install_agent_cli() {
  install -d -m 0755 "$claude_dir" &&
    fetch "https://registry.npmjs.org/@anthropic-ai/claude-code-linux-x64/-/claude-code-linux-x64-$claude_version.tgz" \
      "$claude_sha512" "$claude_dir/package.tgz" sha512sum &&
    tar -xzf "$claude_dir/package.tgz" -C "$claude_dir" package/claude &&
    rm -f "$claude_dir/package.tgz"
}
# The page works without its agent: a failed download is a warning, and the
# next Update NullBill tries again. The page says the agent is not installed.
if [ ! -x "$claude_dir/package/claude" ] && ! (install_agent_cli); then
  echo "warning: the agent CLI $claude_version did not install; the page runs without its agent until Update NullBill" >&2
fi
if [ -x "$claude_dir/package/claude" ]; then
  ln -sfn "$claude_dir/package/claude" /usr/local/bin/claude
fi
if ! id nbagent >/dev/null 2>&1; then
  useradd --system --home-dir /var/lib/nullbill-agent --create-home --shell /usr/sbin/nologin nbagent
fi
chmod 0700 /var/lib/nullbill-agent

install -d -m 0700 "$home" /root/.ssh
if [ ! -f /root/.ssh/id_ed25519 ]; then
  ssh-keygen -q -t ed25519 -N '' -C "nullbill@$(hostname)" -f /root/.ssh/id_ed25519
fi
echo "controller ready: $(python3 --version), tofu $tofu_version, sops $sops_version, $(age --version 2>&1 | head -1), agent CLI $claude_version"
