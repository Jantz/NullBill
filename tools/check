#!/usr/bin/env bash
# Every check CI runs, runnable locally. Needs gitleaks on PATH and the
# packages in requirements-dev.txt.
#
# Arguments name the parts to run: static (lint, tests, gitleaks) and the
# container checks apply install firewall guests host release roles tofu. None runs
# them all. CI runs them in parallel jobs; ROLES limits roles to those roles.
#
# CI_SKIP names container checks to leave out, space or comma separated,
# or docker for all of them. static always runs when asked for. CI sets it
# from a "CI-Skip:" line in the pull request body.
set -euo pipefail
cd "$(git rev-parse --show-toplevel)"

docker_checks=(apply install firewall guests host release roles tofu)
parts=("$@")
((${#parts[@]})) || parts=(static "${docker_checks[@]}")
for part in "${parts[@]}"; do
  if [[ $part != static && " ${docker_checks[*]} " != *" $part "* ]]; then
    echo "tools/check: unknown part '$part'; known: static ${docker_checks[*]}" >&2
    exit 2
  fi
done
wanted() { [[ " ${parts[*]} " == *" $1 "* ]]; }
requested="${CI_SKIP:-}"
read -ra requested <<<"${requested//,/ }"
skip=" "
for name in "${requested[@]}"; do
  if [[ $name == docker ]]; then
    skip+="${docker_checks[*]} "
  elif [[ " ${docker_checks[*]} " == *" $name "* ]]; then
    skip+="$name "
  else
    echo "CI_SKIP: unknown check '$name'; known: ${docker_checks[*]} docker" >&2
    exit 2
  fi
done

if wanted static; then
  # Python scripts the roles install, which have no .py suffix.
  scripts=(ansible/roles/monitoring/files/nb-alert-relay ansible/roles/log_shipper/files/nb-log-shipper
    ansible/roles/host_baseline/files/nb-power ansible/roles/updates/files/nb-busy ansible/roles/qbittorrent/files/nb-torrents)
  ruff check . "${scripts[@]}"
  ruff format --check . "${scripts[@]}"
  shellcheck -x hooks/* install.sh tools/check-install tools/install-check/check.sh tools/install-check/fakes/* tools/check tools/check-apply tools/install-apply-deps tools/setup-controller tools/finish-upgrade tools/check-firewall tools/check-guests tools/check-host tools/check-roles tools/check-tofu tools/guest-check/check.sh tools/guest-check/portmap.sh tools/guest-check/tunnel.sh tools/host-check/check.sh tools/host-check/legacy-disk.sh tools/tofu-check/check.sh tools/role-check/role-check.sh ansible/roles/*/tests/check.sh ansible/roles/updates/files/nb-update-metrics ansible/roles/host_baseline/files/nb-pve-api-cert ansible/roles/host_baseline/files/nb-backup-disk ansible/roles/host_baseline/files/nb-legacy-disk ansible/roles/host_baseline/files/nb-legacy-copy ansible/roles/host_baseline/files/nb-storage-disk ansible/roles/egress_proxy/files/nb-squid-check ansible/roles/agent_ssh/files/nb-agent-command ansible/roles/custom_service/files/nb-custom-setup tools/denylist-scan tools/install-hooks tools/ci-passed-on-pr tools/check-release tools/release-check/check.sh tools/release-check/controller.sh tools/upgrade-controller src/nullbill/data/nb-release-upgrade
  python3 -m pytest -q
  gitleaks dir --no-banner --redact -c .gitleaks.toml .
  gitleaks git --no-banner --redact -c .gitleaks.toml .
fi

run=()
for name in "${docker_checks[@]}"; do
  if ! wanted "$name"; then
    continue
  elif [[ $skip == *" $name "* ]]; then
    echo "SKIP: check-$name (CI_SKIP)"
  else
    run+=("$name")
  fi
done
if ((${#run[@]} == 0)); then
  :
elif docker info >/dev/null 2>&1; then
  for name in "${run[@]}"; do
    if [[ $name == roles ]]; then
      # shellcheck disable=SC2086 # role names, split on purpose
      tools/check-roles ${ROLES:-}
    else
      "tools/check-$name"
    fi
  done
else
  echo "SKIP: ${run[*]/#/check-} need docker"
fi
