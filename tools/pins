# One edit: the file, the key in it, the new value.
Edit = tuple[str, str, object]


def get(url: str) -> bytes:
    request = urllib.request.Request(url, headers={"User-Agent": "nullbill-pins"})
    with urllib.request.urlopen(request, timeout=300) as response:
        return response.read()


def sha256(url: str) -> str:
    return hashlib.sha256(get(url)).hexdigest()


def newest(versions: list[str]) -> str:
    return max(versions, key=pins.numbers)


def defaults(role: str) -> str:
    return f"ansible/roles/{role}/defaults/main.yml"


def plain(what: str, value: object, pattern: str = pins.VERSION) -> str:
    """A vendor's answer that goes into an address or a file, refused unless
    it looks like what it should be."""
    if not isinstance(value, str) or not re.fullmatch(pattern, value) or ".." in value:
        raise SystemExit(f"{what}: the vendor answered {str(value)[:80]!r}")
    return value


def verified(keys: bytes, data: bytes, signature: bytes | None = None) -> tuple[bytes, list[str]]:
    """What a valid signature by one of these keys covers, and the primary
    keys that made one: data with its detached signature, or clear-signed
    data alone (an apt InRelease)."""
    with tempfile.TemporaryDirectory() as home:
        ring = f"{home}/trusted.kbx"
        subprocess.run(
            ["gpg", "--homedir", home, "--batch", "--quiet", "--no-default-keyring", "--keyring", ring, "--import"],
            input=keys,
            check=True,
            capture_output=True,
        )
        (Path(home) / "data").write_bytes(data)
        files = [f"{home}/data"]
        if signature is not None:
            (Path(home) / "data.sig").write_bytes(signature)
            files = [f"{home}/data.sig", f"{home}/data"]
        done = subprocess.run(
            ["gpgv", "--homedir", home, "--keyring", ring, "--status-fd", "1", "--output", f"{home}/out", *files],
            capture_output=True,
            check=False,
        )
        out = (Path(home) / "out").read_bytes() if (Path(home) / "out").exists() else b""
    # VALIDSIG ends with the primary key's fingerprint; a subkey signs.
    found = re.findall(rb"^\[GNUPG:\] VALIDSIG .* ([0-9A-F]{40})$", done.stdout, re.M)
    if done.returncode != 0 or not found:
        raise SystemExit("no valid signature by the pinned key")
    return (data if signature is not None else out), [f.decode() for f in found]


def pinned_key(url: str, role: str, key: str) -> bytes:
    """A key file, refused unless it is the one the role pins by SHA-256."""
    data, want = get(url), pins.value((ROOT / defaults(role)).read_text(), defaults(role), key)
    if hashlib.sha256(data).hexdigest() != want:
        raise SystemExit(f"{url} is not the key {defaults(role)} pins as {key}")
    return data


def signed(url: str, fingerprint: str) -> str:
    """The SHA-256 of a download whose detached signature (url + .asc) is
    by this key."""
    data = get(url)
    try:
        _, by = verified(get(KEYSERVER.format(fingerprint)), data, get(url + ".asc"))
    except SystemExit:
        by = []
    if fingerprint not in by:
        raise SystemExit(f"{url}: no valid signature by {fingerprint}")
    return hashlib.sha256(data).hexdigest()


def forgejo_release(listing: str, key: str, name: str, role: str, file: str) -> list[Edit]:
    tags = [r["tag_name"] for r in json.loads(get(listing)) if re.fullmatch(r"v\d+\.\d+\.\d+", r["tag_name"]) and not r["prerelease"]]
    version = newest(tags).removeprefix("v")
    url = f"{listing.split('/api/v1/repos/')[0]}/{name}/releases/download/v{version}/{file}-{version}-linux-amd64"
    return [(defaults(role), f"{key}_version", version), (defaults(role), f"{key}_sha256", signed(url, FORGEJO_SIGNED_BY))]


def forgejo() -> list[Edit]:
    return forgejo_release(FORGEJO, "forgejo", "forgejo/forgejo", "forgejo", "forgejo")


def forgejo_runner() -> list[Edit]:
    return forgejo_release(RUNNER, "ci_runner", "forgejo/runner", "ci_runner", "forgejo-runner")


def stanzas(text: str) -> list[dict[str, str]]:
    return [
        dict(line.split(": ", 1) for line in stanza.splitlines() if ": " in line and not line.startswith(" "))
        for stanza in text.split("\n\n")
    ]


def packages(repository: tuple[str, str, str, str]) -> list[dict[str, str]]:
    """An apt repository's amd64 Packages index of main, one dict per
    package, as the InRelease that the role's pinned key signs names it."""
    dists, key_url, role, key = repository
    release, _ = verified(pinned_key(key_url, role, key), get(dists + "InRelease"))
    sums = re.search(r"^SHA256:\n((?:[ \t].*\n?)+)", release.decode(), re.M)
    listed = {}
    for line in (sums[1] if sums else "").splitlines():
        digest, size, name = line.split()
        listed[name] = (digest, int(size))
    for name, unpack in (("main/binary-amd64/Packages", bytes), ("main/binary-amd64/Packages.gz", gzip.decompress)):
        if name in listed:
            data = get(dists + name)
            if (hashlib.sha256(data).hexdigest(), len(data)) != listed[name]:
                raise SystemExit(f"{dists}{name} is not the index the signed InRelease names")
            return stanzas(unpack(data).decode())
    raise SystemExit(f"{dists}InRelease names no main/binary-amd64/Packages")


def apt_newest(index: list[dict[str, str]], package: str, like: str = pins.VERSION) -> str:
    found = [p["Version"] for p in index if p.get("Package") == package and re.fullmatch(like, p.get("Version", ""))]
    if not found:
        raise SystemExit(f"no {package} in the repository's index")
    return plain(package, newest(found))


