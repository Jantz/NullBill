#!/usr/bin/env python3
"""Render apply's build directory for every fixture class into OUT/<class>.

Used by the container checks, which parse the rendered files with the real
tools. Run from the repo root with the package installed.
"""

import sys
from pathlib import Path

sys.path.insert(0, str(Path(__file__).resolve().parent.parent / "tests"))
from conftest import CLASSES, fixture_config, write_raw  # noqa: E402

from nullbill.artifacts import render_all, write_build  # noqa: E402
from nullbill.model import build_model  # noqa: E402
from nullbill.plan import build_plan  # noqa: E402
from nullbill.probe import parse  # noqa: E402

out = Path(sys.argv[1])
for cls in CLASSES:
    model = build_model(fixture_config(cls))
    facts = parse(write_raw(out / "raw" / cls, cls))
    write_build(render_all(build_plan(model, facts), model), out / cls)
    print(cls)
