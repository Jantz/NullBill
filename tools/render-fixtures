#!/usr/bin/env python3
"""Render apply's build directory for every fixture class into OUT/<class>,
the large class with a GPU passed to a VM into OUT/large-gpu-vm, with its
old disk kept, shared (the files guest) and played (Jellyfin) into
OUT/large-legacy, with every game server and a friend given two of them
into OUT/large-games, with two services of the owner's own (a container
and a VM, custom.py) into OUT/large-custom, with the download client behind
a VPN (torrents.py) into OUT/large-torrents, and the mid class with every workload that can run on
demand doing so into OUT/mid-on-demand.

Used by the container checks, which parse the rendered files with the real
tools. Run from the repo root with the package installed.
"""

import sys
from pathlib import Path

sys.path.insert(0, str(Path(__file__).resolve().parent.parent / "tests"))
from fixturedata import CLASSES, custom_config, fixture_config, games_config, legacy_config, torrents_config, write_raw  # noqa: E402

from nullbill.artifacts import render_all, write_build  # noqa: E402
from nullbill.model import build_model  # noqa: E402
from nullbill.plan import build_plan  # noqa: E402
from nullbill.probe import parse  # noqa: E402

out = Path(sys.argv[1])
variants = [(cls, cls, fixture_config(cls)) for cls in CLASSES]
variants.append(("large-gpu-vm", "large", {**fixture_config("large"), "gpus": {"0000:65:00.0": {"owner": "vm:windows-dev"}}}))
variants.append(("large-legacy", "large", legacy_config()))
variants.append(("large-games", "large", games_config()))
variants.append(("large-custom", "large", custom_config()))
variants.append(("large-torrents", "large", torrents_config()))
on_demand = dict.fromkeys(["agents", "linux-ci", "inference", "windows-dev"], {"run": "on-demand"})
variants.append(("mid-on-demand", "mid", {**fixture_config("mid"), "power": on_demand}))
for name, cls, config in variants:
    model = build_model(config)
    facts = parse(write_raw(out / "raw" / name, cls))
    write_build(render_all(build_plan(model, facts), model), out / name)
    print(name)
