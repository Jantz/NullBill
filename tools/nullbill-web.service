[Unit]
Description=NullBill setup and status page
After=network-online.target
Wants=network-online.target

[Service]
Environment=NULLBILL_HOME=/var/lib/nullbill
Environment=PATH=/opt/nullbill/venv/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
ExecStart=/opt/nullbill/venv/bin/nullbill web --listen 0.0.0.0:8443
Restart=on-failure
RestartSec=5
UMask=0077
NoNewPrivileges=yes
ProtectSystem=full
PrivateTmp=yes

[Install]
WantedBy=multi-user.target
