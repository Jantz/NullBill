#!/usr/bin/env bash
# Run each guest role's container check (ansible/roles/*/tests/check.sh) in
# a fresh Debian 13 container, the release every Linux guest runs, or a
# Fedora one for a role whose tests/image says fedora (the desktop).
# Arguments name the roles to check; none checks them all. Needs docker and
# network access.
set -euo pipefail
cd "$(git rev-parse --show-toplevel)"

roles=("$@")
if ((${#roles[@]} == 0)); then
  for check in ansible/roles/*/tests/check.sh; do
    roles+=("$(basename "$(dirname "$(dirname "$check")")")")
  done
fi
for role in "${roles[@]}"; do
  [[ -f ansible/roles/$role/tests/check.sh ]] || {
    echo "check-roles: $role has no tests/check.sh" >&2
    exit 2
  }
done

ctx=$(mktemp -d)
trap 'rm -rf "$ctx"' EXIT
cp tools/role-check/Dockerfile tools/role-check/Dockerfile.fedora tools/role-check/role-check.sh requirements-apply.txt "$ctx/"
cat "${EXTRA_CA_FILE:-/dev/null}" > "$ctx/extra-ca.crt"
image() { # the image a role's check runs in
  if [[ "$(cat "ansible/roles/$1/tests/image" 2>/dev/null)" == fedora ]]; then echo nullbill-role-check-fedora; else echo nullbill-role-check; fi
}
built=()
for role in "${roles[@]}"; do
  name=$(image "$role")
  [[ " ${built[*]} " == *" $name "* ]] && continue
  file=Dockerfile
  [[ $name == nullbill-role-check-fedora ]] && file=Dockerfile.fedora
  docker build -q -f "$ctx/$file" -t "$name" "$ctx" >/dev/null
  built+=("$name")
done
# PBS refuses to run unless /run/proxmox-backup is a tmpfs. Its certificate
# takes the host's FQDN as CN, limited to 64 bytes, so give the container a
# short name and drop the runner's DNS search domain.
# nft -c needs CAP_NET_ADMIN, in the container's own network namespace.
# /downloads stands in for the kept disk's folder in the download client's
# guest (qbittorrent): a mount with a few GiB free, which takes no memory
# until something is written.
for role in "${roles[@]}"; do
  echo "$role:"
  docker run --rm --cap-add NET_ADMIN --hostname role-check --dns-search . --tmpfs /run/proxmox-backup --tmpfs /downloads:size=4g -v "$PWD/ansible:/ansible:ro" "$(image "$role")" bash "/ansible/roles/$role/tests/check.sh"
done
