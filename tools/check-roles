#!/usr/bin/env bash
# Run each guest role's container check (ansible/roles/*/tests/check.sh) in
# a fresh Debian 12 container. Needs docker and network access.
set -euo pipefail
cd "$(git rev-parse --show-toplevel)"

ctx=$(mktemp -d)
trap 'rm -rf "$ctx"' EXIT
cp tools/role-check/Dockerfile tools/role-check/role-check.sh "$ctx/"
cat "${EXTRA_CA_FILE:-/dev/null}" > "$ctx/extra-ca.crt"
docker build -q -t nullbill-role-check "$ctx" >/dev/null
# PBS refuses to run unless /run/proxmox-backup is a tmpfs. Its certificate
# takes the host's FQDN as CN, limited to 64 bytes, so give the container a
# short name and drop the runner's DNS search domain.
# nft -c needs CAP_NET_ADMIN, in the container's own network namespace.
for check in ansible/roles/*/tests/check.sh; do
  role=$(basename "$(dirname "$(dirname "$check")")")
  echo "$role:"
  docker run --rm --cap-add NET_ADMIN --hostname role-check --dns-search . --tmpfs /run/proxmox-backup -v "$PWD/ansible:/ansible:ro" nullbill-role-check bash "/ansible/roles/$role/tests/check.sh"
done
