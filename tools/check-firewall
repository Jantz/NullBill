#!/usr/bin/env bash
# Render the firewall for every fixture class and parse it with the stock
# pve-firewall parser in a container. Needs docker.
set -euo pipefail
cd "$(git rev-parse --show-toplevel)"

out=$(mktemp -d)
trap 'rm -rf "$out"' EXIT

# Sandboxes that intercept TLS pass their CA in through EXTRA_CA_FILE.
mkdir "$out/context"
cp tools/pve-firewall/Dockerfile tools/pve-firewall/check.pl "$out/context/"
cat "${EXTRA_CA_FILE:-/dev/null}" > "$out/context/extra-ca.crt"
docker build -q -t nullbill-pve-firewall "$out/context" >/dev/null
tools/render-fixtures "$out/build" >/dev/null
for cls in small mid large large-legacy large-games; do
  echo "$cls:"
  docker run --rm -v "$out/build/$cls/firewall:/fw:ro" nullbill-pve-firewall /fw
done
