#!/usr/bin/env bash
# Apply the Ansible host baseline to a Debian 13 container standing in for a
# PVE 9 host and check the result. Needs docker and network access.
set -euo pipefail
cd "$(git rev-parse --show-toplevel)"

ctx=$(mktemp -d)
trap 'rm -rf "$ctx"' EXIT
cp tools/host-check/Dockerfile tools/host-check/check.sh tools/host-check/legacy-disk.sh requirements-apply.txt "$ctx/"
cat "${EXTRA_CA_FILE:-/dev/null}" > "$ctx/extra-ca.crt"
docker build -q -t nullbill-host-check "$ctx" >/dev/null
# The storage disk's thin pool needs the dm-thin target, which only the
# host's kernel can load; without it that part of the check is skipped.
if ! grep -qs '^dm_thin_pool ' /proc/modules; then
  modprobe dm_thin_pool 2>/dev/null || sudo -n modprobe dm_thin_pool 2>/dev/null || true
fi
# Privileged for loop devices, which stand in for the backup disk and the
# kept disks, and for /dev/fuse, which ntfs-3g mounts through.
docker run --rm --privileged -v "$PWD/ansible:/ansible:ro" -v "$PWD/src:/src:ro" nullbill-host-check
