#!/usr/bin/env bash
# Apply the Ansible host baseline to a Debian 12 container standing in for a
# PVE 8 host and check the result. Needs docker and network access.
set -euo pipefail
cd "$(git rev-parse --show-toplevel)"

ctx=$(mktemp -d)
trap 'rm -rf "$ctx"' EXIT
cp tools/host-check/Dockerfile tools/host-check/check.sh "$ctx/"
cat "${EXTRA_CA_FILE:-/dev/null}" > "$ctx/extra-ca.crt"
docker build -q -t nullbill-host-check "$ctx" >/dev/null
# Privileged for a loop device, which stands in for the backup disk.
docker run --rm --privileged -v "$PWD/ansible:/ansible:ro" nullbill-host-check
