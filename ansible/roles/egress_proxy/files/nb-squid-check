#!/bin/sh
# Generated by nullbill. squid -k parse exits 0 on WARNING and ERROR lines,
# so fail on those too. Used to validate squid.conf before it is placed.
out=$(squid -k parse -f "$1" 2>&1) || { printf '%s\n' "$out" >&2; exit 1; }
if printf '%s\n' "$out" | grep -E 'WARNING|ERROR|FATAL' >&2; then
  exit 1
fi
