# Generated by nullbill.
[Unit]
Description=llama.cpp serving {{ inference_model_name }} to the model gateway
After=network-online.target
Wants=network-online.target

[Service]
User=llama
Group=llama
# PVE gives the container the card's device nodes with group video.
SupplementaryGroups=video
# The Vulkan driver's compiled shaders, kept between starts.
CacheDirectory=llama
Environment=XDG_CACHE_HOME=/var/cache/llama
{% if inference_vulkan_devices %}
Environment=GGML_VK_VISIBLE_DEVICES={{ inference_vulkan_devices }}
{% endif %}
ExecStart={{ inference_server }} --model {{ inference_model_path }} --alias {{ inference_model_name }} --host {{ inference_listen }} --port {{ inference_port }} --ctx-size {{ inference_context }} --parallel 1 --n-gpu-layers all --api-key-file /etc/llama/api-key --no-webui
Restart=always
RestartSec=5
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
