# Generated by nullbill.
[Unit]
Description=NullBill internal CA (step-ca)
After=network-online.target
Wants=network-online.target

[Service]
User=step
Group=step
Environment=STEPPATH={{ step_ca_home }}
ExecStart=/usr/bin/step-ca {{ step_ca_home }}/config/ca.json --password-file {{ step_ca_home }}/secrets/password
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths={{ step_ca_home }}/db
PrivateTmp=true
Restart=on-failure

[Install]
WantedBy=multi-user.target
