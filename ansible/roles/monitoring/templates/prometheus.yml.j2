# Generated by nullbill.
global:
  scrape_interval: 30s
  evaluation_interval: 30s

alerting:
  alertmanagers:
    - static_configs:
        - targets: ["127.0.0.1:9093"]

rule_files:
  - /etc/prometheus/rules/*.yml

scrape_configs:
  - job_name: prometheus
    static_configs:
      - targets: ["127.0.0.1:9090"]
  - job_name: node
    static_configs:
      - targets: {{ monitoring_node_targets | to_json }}
    # forgejo.nullbill.internal:9100 shows as "forgejo" in alerts and on the page.
    relabel_configs:
      - source_labels: [__address__]
        regex: "([^.:]+)[.:].*"
        target_label: instance
{% if monitoring_host_target %}
  - job_name: host
    static_configs:
      - targets: {{ [monitoring_host_target] | to_json }}
    # forgejo.nullbill.internal:9100 shows as "forgejo" in alerts and on the page.
    relabel_configs:
      - source_labels: [__address__]
        regex: "([^.:]+)[.:].*"
        target_label: instance
{% endif %}
  - job_name: tls
    metrics_path: /probe
    params:
      module: [tls]
    static_configs:
      - targets: {{ monitoring_tls_targets | to_json }}
    relabel_configs:
      - source_labels: [__address__]
        target_label: __param_target
      - source_labels: [__param_target]
        target_label: instance
      - target_label: __address__
        replacement: 127.0.0.1:9115
