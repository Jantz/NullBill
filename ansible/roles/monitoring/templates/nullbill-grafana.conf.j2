# Generated by nullbill. Grafana over HTTPS; Grafana itself listens on localhost.
{% set cert = '/etc/nginx/nullbill/browser' if monitoring_browser_cert | length > 0 else '/etc/nullbill/tls/' ~ monitoring_tls_name %}
server {
    listen {{ monitoring_grafana_port }} ssl;
    server_name _;
    ssl_certificate {{ cert }}.crt;
    ssl_certificate_key {{ cert }}.key;
    ssl_protocols TLSv1.2 TLSv1.3;

    location / {
        proxy_pass http://127.0.0.1:{{ monitoring_grafana_internal_port }};
        proxy_set_header Host $http_host;
    }

    # Grafana Live's websocket.
    location /api/live/ {
        proxy_pass http://127.0.0.1:{{ monitoring_grafana_internal_port }};
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_set_header Host $http_host;
    }
}
