# Generated by nullbill.
[Unit]
Description=NullBill alert relay (Alertmanager to ntfy and Healthchecks.io)
After=network-online.target
Wants=network-online.target

[Service]
ExecStart=/usr/local/bin/nb-alert-relay %d/config
LoadCredential=config:/etc/nullbill/alert-relay.json
{% if monitoring_https_proxy %}
Environment=https_proxy={{ monitoring_https_proxy }}
{% endif %}
DynamicUser=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
NoNewPrivileges=yes
Restart=always
RestartSec=10

[Install]
WantedBy=multi-user.target
