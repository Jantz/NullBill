# Generated by nullbill. Every alert goes to nb-alert-relay, which sends it
# to the owner's ntfy topic; Watchdog's repeats ping Healthchecks.io.
route:
  receiver: relay
  group_by: [alertname, instance]
  group_wait: 30s
  group_interval: 5m
  repeat_interval: 12h
  routes:
    - matchers: ['alertname="Watchdog"']
      receiver: relay
      group_wait: 0s
      group_interval: 1m
      repeat_interval: {{ monitoring_watchdog_interval }}
receivers:
  - name: relay
    webhook_configs:
      - url: http://127.0.0.1:{{ monitoring_relay_port }}/alertmanager
        send_resolved: true
