# Generated by nullbill. The only way to Loki from other guests.
server {
    listen {{ monitoring_loki_port }} ssl;
    server_name _;
    ssl_certificate /etc/nullbill/tls/{{ monitoring_tls_name }}.crt;
    ssl_certificate_key /etc/nullbill/tls/{{ monitoring_tls_name }}.key;
    ssl_protocols TLSv1.2 TLSv1.3;
    # Shippers present a certificate; readers need none.
    ssl_client_certificate /etc/nginx/nullbill/shipper-ca.crt;
    ssl_verify_client optional;
    client_max_body_size 4m;

    # Writes: log shippers only.
    location = /loki/api/v1/push {
        if ($ssl_client_verify != SUCCESS) {
            return 403;
        }
        limit_except POST {
            deny all;
        }
        proxy_pass http://127.0.0.1:{{ monitoring_loki_internal_port }};
    }

    # Reads: queries, labels, series and tail. GET only, so deletes and
    # ruler changes never reach Loki.
    location /loki/api/v1/ {
        limit_except GET {
            deny all;
        }
        proxy_pass http://127.0.0.1:{{ monitoring_loki_internal_port }};
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
    }

    location / {
        return 403;
    }
}
