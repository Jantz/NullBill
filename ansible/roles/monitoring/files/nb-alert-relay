#!/usr/bin/python3
"""Generated by nullbill. Alertmanager's webhook, relayed to the owner.

Alertmanager posts each group of alerts here (127.0.0.1 only). The always
firing Watchdog pings Healthchecks.io, which alerts the owner when the pings
stop: power cut, lost uplink, dead monitoring. Every other alert, firing or
resolved, goes to the owner's ntfy topic. Both leave through the egress
proxy (https_proxy in the unit's environment). Answers 502 when a send
fails, so Alertmanager tries again.

Usage: nb-alert-relay CONFIG, where CONFIG is JSON with listen (host:port),
ntfy_url (https://ntfy.sh/<topic>, empty to stay silent) and
healthchecks_url (a ping URL, empty for none).
"""

import json
import sys
import urllib.request
from http.server import BaseHTTPRequestHandler, ThreadingHTTPServer

PRIORITY = {"page": "high", "warn": "default"}


def send(url: str, body: bytes = b"", headers: dict | None = None) -> None:
    request = urllib.request.Request(url, data=body, headers=headers or {}, method="POST")
    with urllib.request.urlopen(request, timeout=15) as response:
        response.read()


def notification(alert: dict) -> tuple[bytes, dict]:
    labels, annotations = alert.get("labels", {}), alert.get("annotations", {})
    name = labels.get("alertname", "alert")
    text = annotations.get("summary") or name
    if alert.get("status") == "resolved":
        return f"Resolved: {text}".encode(), {"Title": f"NullBill: {name} resolved", "Priority": "low", "Tags": "white_check_mark"}
    priority = PRIORITY.get(labels.get("severity", ""), "low")
    return text.encode(), {"Title": f"NullBill: {name}", "Priority": priority, "Tags": "warning"}


def relay(config: dict, payload: dict) -> None:
    for alert in payload.get("alerts", []):
        if alert.get("labels", {}).get("alertname") == "Watchdog":
            if config.get("healthchecks_url") and alert.get("status") == "firing":
                send(config["healthchecks_url"])
        elif config.get("ntfy_url"):
            body, headers = notification(alert)
            send(config["ntfy_url"], body, headers)


def handler(config: dict) -> type[BaseHTTPRequestHandler]:
    class Handler(BaseHTTPRequestHandler):
        def do_POST(self) -> None:
            if self.path != "/alertmanager":
                self.send_error(404)
                return
            try:
                payload = json.loads(self.rfile.read(int(self.headers.get("Content-Length", 0))))
                relay(config, payload)
            except (OSError, ValueError) as exc:
                self.log_message("relay failed: %s", exc)
                self.send_error(502)
                return
            self.send_response(200)
            self.end_headers()

    return Handler


def main() -> None:
    with open(sys.argv[1]) as f:
        config = json.load(f)
    host, port = config.get("listen", "127.0.0.1:9097").rsplit(":", 1)
    ThreadingHTTPServer((host, int(port)), handler(config)).serve_forever()


if __name__ == "__main__":
    main()
