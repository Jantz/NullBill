#!/usr/bin/python3
"""Generated by nullbill. Says whether this guest is in use, one reason per
line, nothing when it is idle. The host's nb-power asks every minute and
stops a guest that runs on demand once it has been idle for long enough
(docs/adr/0013-on-demand.md).

In use means any of:
  - someone is signed in over SSH, or left a tmux or screen session;
  - updates are installing: a guest stopped under dpkg comes back with
    half-installed packages;
  - a program in /etc/nullbill/busy.d prints a reason. A service's role
    puts one there that knows what use of that service is (a film playing,
    a request answered). One that fails, or takes over ten seconds, counts
    as a reason: a guest is not stopped because it could not be asked;
  - where no such program exists: a TCP connection from outside to one of
    the service's ports (/etc/nullbill/busy-ports, from the catalog).

  nb-busy                     the reasons
  nb-busy connections PORT..  how many connections from outside those
                              local TCP ports have right now, for the
                              programs in busy.d
"""

import os
import re
import subprocess
import sys

SCRIPTS = "/etc/nullbill/busy.d"
PORTS = "/etc/nullbill/busy-ports"
# sshd's process for one session: "sshd: name@pts/0", "sshd: name@notty";
# OpenSSH 10 calls it sshd-session.
SESSION = re.compile(r"^sshd(-session)?: \S+@")
MULTIPLEXER = re.compile(r"^(tmux|screen|SCREEN)( |: |$)")
# apt at work, by hand or from its timers. Not unattended-upgrade-shutdown,
# which waits all day for the guest to stop.
UPDATING = re.compile(r"(^|[ /])(apt-get|apt|dpkg|unattended-upgrade|apt\.systemd\.daily)( |$)")
LOCAL = ("127.", "[::1]", "[::ffff:127.")


def count(n: int, one: str, many: str) -> str:
    return f"1 {one}" if n == 1 else f"{n} {many}"


def sessions() -> list[str]:
    """Shells and commands over SSH, terminal sessions left running, and apt at work."""
    try:
        out = subprocess.run(["ps", "-eo", "args="], capture_output=True, text=True, timeout=10).stdout
    except (OSError, subprocess.TimeoutExpired):
        return ["cannot list the processes"]
    lines = [line.strip() for line in out.splitlines()]
    reasons = []
    ssh = sum(1 for line in lines if SESSION.match(line))
    if ssh:
        reasons.append(count(ssh, "SSH session", "SSH sessions"))
    if any(MULTIPLEXER.match(line) for line in lines):
        reasons.append("a tmux or screen session is open")
    if any(UPDATING.search(line) for line in lines):
        reasons.append("updates are installing")
    return reasons


def connections(ports: list[int]) -> int:
    """Established TCP connections to these local ports from another machine."""
    if not ports:
        return 0
    wanted = " or ".join(f"sport = :{port}" for port in ports)
    argv = ["ss", "-Htn", "state", "established", *f"( {wanted} )".split()]
    out = subprocess.run(argv, capture_output=True, text=True, timeout=10, check=True).stdout
    return sum(1 for line in out.splitlines() if line.split() and not line.split()[-1].startswith(LOCAL))


def scripts() -> tuple[bool, list[str]]:
    """(whether any exists, the reasons they print)."""
    try:
        names = sorted(n for n in os.listdir(SCRIPTS) if os.access(os.path.join(SCRIPTS, n), os.X_OK))
    except OSError:
        names = []
    reasons = []
    for name in names:
        try:
            done = subprocess.run([os.path.join(SCRIPTS, name)], capture_output=True, text=True, timeout=10)
        except subprocess.TimeoutExpired:
            reasons.append(f"cannot tell: {name} gave no answer")
            continue
        except OSError as e:
            reasons.append(f"cannot tell: {name} did not run ({e.strerror})")
            continue
        if done.returncode != 0:
            reasons.append(f"cannot tell: {name} failed ({(done.stderr.strip().splitlines() or [f'exit {done.returncode}'])[-1][:80]})")
        reasons += [line.strip() for line in done.stdout.splitlines() if line.strip()]
    return bool(names), reasons


def service_ports() -> list[int]:
    try:
        with open(PORTS) as f:
            return [int(line) for line in f.read().split() if line.isdigit()]
    except OSError:
        return []


def main(argv: list[str]) -> int:
    if argv[:1] == ["connections"] and all(a.isdigit() for a in argv[1:]):
        print(connections([int(a) for a in argv[1:]]))
        return 0
    if argv:
        print("usage: nb-busy | nb-busy connections PORT..", file=sys.stderr)
        return 2
    reasons = sessions()
    known, found = scripts()
    reasons += found
    if not known:
        try:
            n = connections(service_ports())
        except (OSError, subprocess.SubprocessError):
            reasons.append("cannot tell: ss did not list the connections")
        else:
            if n:
                reasons.append(count(n, "connection", "connections"))
    print("\n".join(reasons), end="\n" if reasons else "")
    return 0


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
