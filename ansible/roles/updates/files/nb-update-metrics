#!/bin/sh
# Generated by nullbill. Update health for node_exporter's textfile
# collector, next to the apt metrics Debian's collector writes. Runs after
# each apt metrics collection.
set -eu
dir=/var/lib/prometheus/node-exporter
# apt.systemd.daily touches this only when unattended-upgrade succeeded.
# Until the first run, the time this role set updates up stands in, so a
# guest that never manages one alerts like one whose runs keep failing.
stamp=/var/lib/apt/periodic/upgrade-stamp
[ -e "$stamp" ] || stamp=/var/lib/nullbill/updates-since
enabled=0
if apt-config dump APT::Periodic::Unattended-Upgrade | grep -q '"1";' \
  && systemctl is-enabled --quiet apt-daily-upgrade.timer 2>/dev/null; then
  enabled=1
fi
tmp=$(mktemp "$dir/.nullbill-updates.XXXXXX")
cat >"$tmp" <<METRICS
# HELP nb_unattended_upgrade_success_timestamp_seconds Last unattended-upgrade run that succeeded.
# TYPE nb_unattended_upgrade_success_timestamp_seconds gauge
nb_unattended_upgrade_success_timestamp_seconds $(stat -c %Y "$stamp")
# HELP nb_unattended_upgrade_enabled 1 when unattended upgrades are switched on and their timer is enabled.
# TYPE nb_unattended_upgrade_enabled gauge
nb_unattended_upgrade_enabled $enabled
METRICS
chmod 0644 "$tmp"
mv "$tmp" "$dir/nullbill-updates.prom"
