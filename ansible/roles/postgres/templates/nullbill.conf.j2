# Generated by nullbill.
listen_addresses = '{{ (['localhost'] + postgres_listen) | join(',') }}'
password_encryption = 'scram-sha-256'
ssl = on
ssl_cert_file = '/etc/nullbill/tls/{{ postgres_tls_name }}.crt'
ssl_key_file = '/etc/nullbill/tls/{{ postgres_tls_name }}.key'
ssl_min_protocol_version = 'TLSv1.2'
log_connections = on
log_disconnections = on
