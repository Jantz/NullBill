#!/bin/sh
# Generated by nullbill. Runs after each renewal of {{ tls_cert_name }}:
# step writes the new certificate 0600, so give it back to its readers,
# then let the service pick it up.
set -e
chmod 0644 /etc/nullbill/tls/{{ tls_cert_name }}.crt
chown root:{{ tls_cert_group }} /etc/nullbill/tls/{{ tls_cert_name }}.key
chmod 0640 /etc/nullbill/tls/{{ tls_cert_name }}.key
{{ tls_cert_reload }}
