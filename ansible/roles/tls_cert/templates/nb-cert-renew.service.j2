# Generated by nullbill. Renews {{ tls_cert_name }} with step-ca when two
# thirds of its lifetime has passed, using the current certificate.
[Unit]
Description=Renew the {{ tls_cert_name }} certificate
After=network-online.target
Wants=network-online.target

[Service]
Environment=STEPPATH=/etc/nullbill/tls/step
ExecStart=/usr/bin/step ca renew --daemon --ca-url {{ tls_cert_ca_url }} --root /etc/nullbill/tls/root_ca.crt --exec /usr/local/sbin/nb-cert-renewed-{{ tls_cert_name }} /etc/nullbill/tls/{{ tls_cert_name }}.crt /etc/nullbill/tls/{{ tls_cert_name }}.key
Restart=always
RestartSec=60

[Install]
WantedBy=multi-user.target
