#!/bin/sh
# Generated by nullbill. Disks kept from a previous OS
# (docs/adr/0007-legacy-disks.md).
#
#   nb-legacy-disk mount DISK_ID PARTN UUID FSTYPE MODE NAME UID GID [JOURNAL]
#   nb-legacy-disk unmount NAME
#   nb-legacy-disk list
#   nb-legacy-disk metrics
#
# mount keeps partition PARTN of DISK_ID mounted at /mnt/nb-legacy/NAME
# through a systemd mount unit by the partition's by-id name (which names
# the disk's serial; a UUID can repeat on cloned disks), owned by UID:GID, read-only (MODE
# ro) or read-write (rw, NTFS only). It refuses a partition whose probed
# filesystem or UUID differs from the plan's, and read-write on an NTFS
# volume that Windows left hibernated, unclean or marked for a disk check.
# The empty mount point is immutable, so nothing lands on the system disk
# while the disk is missing. Prints "kept" or "mounted".
#
# JOURNAL (rw NTFS only) is the fingerprint of the one journal the owner
# said may be discarded (disks.<id>.discard_journal, read by the probe):
# when Windows left the volume's journal open and it is still that journal,
# ntfsfix -d empties it before the mount, and "discarded" is printed first.
#
# metrics writes nb_legacy_disk_mounted for node_exporter's textfile
# collector (LegacyDiskMissing); mount and unmount run it too.
#
# Nothing here formats or repairs the partition: no wipefs, mkfs or fsck.
# A read-write mount writes, through the filesystem; apart from it only
# discard_journal does, to the journal and the volume's flags.
set -eu
base=${NB_LEGACY_DIR:-/mnt/nb-legacy}
units=${NB_UNIT_DIR:-/etc/systemd/system}
disks=${NB_DISK_DIR:-/dev/disk/by-id}
systemctl=${NB_SYSTEMCTL:-systemctl}
textfiles=${NB_TEXTFILE_DIR:-/var/lib/prometheus/node-exporter}
discarded=${NB_DISCARDED:-/var/lib/nullbill/discarded-journals}
marker="# nb-legacy-disk:"

die() {
  echo "nb-legacy-disk: $*" >&2
  exit 1
}

# Refuse, putting back what was mounted before this run, if anything.
refuse() {
  if [ -n "${was_mounted:-}" ]; then
    "$systemctl" start "$unit" 2>/dev/null || true
  fi
  die "$@"
}

unit_of() {
  # systemd-escape -p --suffix=mount for the names plan allows ([a-z0-9-]).
  printf '%s.mount' "$(printf '%s' "${base#/}/$1" | sed -e 's/-/\\x2d/g' -e 's|/|-|g')"
}

# The mode a mount point is mounted with now: ro, rw, or nothing.
mounted_mode() {
  findmnt -rno OPTIONS --mountpoint "$1" 2>/dev/null | head -1 | cut -d, -f1
}

unmount() {
  name=$1
  unit=$(unit_of "$name")
  dir=$base/$name
  if [ -n "$(mounted_mode "$dir")" ]; then
    "$systemctl" stop "$unit" 2>/dev/null || true
    [ -z "$(mounted_mode "$dir")" ] || umount "$dir"
  fi
  if [ -e "$units/$unit" ]; then
    "$systemctl" disable -q "$unit" 2>/dev/null || true
    rm -f "$units/$unit"
    "$systemctl" daemon-reload
  fi
  if [ -d "$dir" ]; then
    chattr -i "$dir"
    rmdir "$dir"
  fi
  echo removed
}

list() {
  for f in "$units"/*.mount; do
    [ -e "$f" ] || continue
    line=$(grep -m1 "^$marker" "$f" || true)
    [ -n "$line" ] || continue
    # shellcheck disable=SC2086
    set -- ${line#"$marker"}
    state=unmounted
    [ "$(mounted_mode "$base/$1")" = "$3" ] && state=mounted
    echo "$1 $2 $3 $4 $state"
  done
}

metrics() {
  out=$textfiles/nullbill-legacy.prom
  lines=$(list | while read -r name _ mode _ state; do
    [ "$state" = mounted ] && up=1 || up=0
    echo "nb_legacy_disk_mounted{name=\"$name\",mode=\"$mode\"} $up"
  done)
  if [ -z "$lines" ]; then
    rm -f "$out"
    return
  fi
  mkdir -p "$textfiles"
  printf '# HELP nb_legacy_disk_mounted 1 while a disk kept from a previous OS is mounted as planned.\n# TYPE nb_legacy_disk_mounted gauge\n%s\n' "$lines" >"$out.tmp"
  mv "$out.tmp" "$out"
}

# A mount that is not what was asked for goes, unit and all, so a reboot
# does not bring it back.
take_down() {
  "$systemctl" stop "$unit" 2>/dev/null || true
  [ -z "$(mounted_mode "$dir")" ] || umount "$dir"
  "$systemctl" disable -q "$unit" 2>/dev/null || true
  rm -f "$units/$unit"
  "$systemctl" daemon-reload
  die "$@"
}

# ntfs-3g.probe exits 14 for a hibernated Windows on the volume itself
# (hiberfil.sys) and for a journal Windows keeps open; its words tell which.
hibernated() {
  case $1 in *"Windows is hibernated"*) return 0 ;; esac
  return 1
}

ntfs_refusal() {
  case $1 in
    12) echo "it holds no valid NTFS" ;;
    13) echo "its NTFS is inconsistent or the disk is failing; run chkdsk /f on it in Windows" ;;
    14 | 15)
      if hibernated "$2"; then
        echo "it holds a hibernated Windows (hiberfil.sys); start that Windows and shut it down fully (shutdown /s /t 0), or keep the disk read-only"
      else
        echo "Windows did not shut it down fully (Fast Startup, hibernation, or it was unplugged while in use); connect it to a Windows PC and shut that down fully (shutdown /s /t 0), or say on the page's Setup, What to run, that what Windows left unfinished may be discarded, or keep the disk read-only"
      fi
      ;;
    16) echo "it is already in use by another program" ;;
    *) echo "ntfs-3g.probe refused it (exit $1)" ;;
  esac
}

# The journal's two restart pages, hashed: they name the Windows session
# that wrote them, so a pin to discard one journal discards no later one.
# The probe computes the same (probe.py's NTFS_CHECK).
journal_of() {
  echo "j$(ntfscat -f -i 2 "$1" 2>/dev/null | head -c 8192 | sha256sum | cut -c1-12)"
}

# Windows left the journal open (ntfs-3g.probe exit 14 or 15, no hibernated
# Windows on the volume itself, not marked for chkdsk) and the owner pinned
# this very journal: empty it. ntfsfix -d resets $LogFile and leaves the
# volume's dirty flag clear; no file's record or contents change, so the
# files stay as a read-only mount showed them. What Windows had logged or
# cached and not yet written in place is lost.
discard_journal() {
  found=$(journal_of "$real")
  # The hash of nothing: the journal could not be read.
  [ "$found" != je3b0c44298fc ] || refuse "$dev: its journal could not be read; nothing was changed"
  [ "$found" = "$journal" ] ||
    refuse "$dev: the journal on it now ($found) is not the one you said may be discarded ($journal), so Windows has used the disk since; read the hardware and confirm again. Nothing was changed"
  out=$(ntfsfix -d "$real" 2>&1) || refuse "$dev: ntfsfix could not empty the journal: $(printf '%s' "$out" | tail -n 1)"
  mkdir -p "$(dirname "$discarded")"
  echo "$(date -u +%Y-%m-%dT%H:%M:%SZ) $id-part$partn $journal" >>"$discarded"
  echo discarded
}

mount_disk() {
  [ $# = 8 ] || [ $# = 9 ] || die "usage: nb-legacy-disk mount DISK_ID PARTN UUID FSTYPE MODE NAME UID GID [JOURNAL]"
  id=$1 partn=$2 uuid=$3 fstype=$4 mode=$5 name=$6 uid=$7 gid=$8 journal=${9:-}
  case $mode in ro | rw) ;; *) die "mode must be ro or rw, not $mode" ;; esac
  case $fstype in
    ntfs) type=ntfs-3g extra="" ;;
    exfat) type=exfat extra="" ;;
    vfat) type=vfat extra=",utf8,shortname=mixed" ;;
    *) die "$fstype cannot be kept; NTFS, exFAT or FAT only" ;;
  esac
  [ "$mode" = ro ] || [ "$fstype" = ntfs ] || die "$fstype stays read-only: Windows' hibernation cannot be told on it"
  printf '%s' "$name" | grep -Eqx '[a-z][a-z0-9-]{0,30}' || die "bad name $name"
  if [ -n "$journal" ]; then
    [ "$mode" = rw ] || die "a journal is discarded only for a read-write mount"
    printf '%s' "$journal" | grep -Eqx 'j[0-9a-f]{12}' || die "bad journal fingerprint $journal"
  fi
  dev=$disks/$id-part$partn
  [ -b "$dev" ] || die "no partition $dev; is the disk connected?"
  real=$(readlink -f "$dev")
  # Probed on the partition itself, not taken from udev's records.
  found=$(blkid -p -o value -s TYPE "$real" 2>/dev/null || true)
  [ "$found" = "$fstype" ] || die "$dev holds ${found:-no filesystem}, the plan says $fstype; probe and plan again"
  found=$(blkid -p -o value -s UUID "$real" 2>/dev/null || true)
  [ "$found" = "$uuid" ] || die "$dev has UUID ${found:-none}, the plan says $uuid; probe and plan again"

  unit=$(unit_of "$name")
  dir=$base/$name
  # Names Windows cannot open are refused, so the disk stays usable there.
  if [ "$fstype" = ntfs ] && [ "$mode" = rw ]; then extra=",windows_names"; fi
  want=$(cat <<UNIT
$marker $name $uuid $mode $fstype
# Generated by nullbill: partition $partn of $id, kept from a previous OS.
# Not backed up by NullBill. Wanted, not required: a missing disk leaves
# the immutable empty directory, and boot goes on.
[Unit]
Description=NullBill kept disk $name
Before=pve-guests.service

[Mount]
What=$dev
Where=$dir
Type=$type
Options=$mode,noatime,uid=$uid,gid=$gid,dmask=0077,fmask=0177$extra

[Install]
WantedBy=multi-user.target
UNIT
)

  current=$(mounted_mode "$dir")
  if [ -n "$current" ]; then
    source=$(findmnt -rno SOURCE --mountpoint "$dir" | head -1)
    if [ "$current" = "$mode" ] && [ "$(readlink -f "$source")" = "$real" ] && [ -e "$units/$unit" ] &&
      [ "$(cat "$units/$unit")" = "$want" ]; then
      echo kept
      return
    fi
    "$systemctl" stop "$unit" 2>/dev/null || true
    [ -z "$(mounted_mode "$dir")" ] || umount "$dir"
    [ ! -e "$units/$unit" ] || was_mounted=1
  fi
  elsewhere=$(findmnt -rno TARGET --source "$real" 2>/dev/null || true)
  [ -z "$elsewhere" ] || die "$dev is mounted at $elsewhere; unmount it first"

  if [ "$fstype" = ntfs ]; then
    rc=0
    ntfs-3g.probe --readonly "$real" >/dev/null 2>&1 || rc=$?
    [ "$rc" = 0 ] || refuse "$dev: $(ntfs_refusal "$rc" "")"
    if [ "$mode" = rw ]; then
      # ntfs-3g.probe passes a volume Windows marked for chkdsk; ntfsinfo
      # refuses it. Both only read.
      marked="$dev cannot be read-write: Windows marked it for a disk check; run chkdsk /f on it in Windows, or keep it read-only"
      ntfsinfo -m "$real" >/dev/null 2>&1 || refuse "$marked"
      said=$(ntfs-3g.probe --readwrite "$real" 2>&1) || rc=$?
      if [ -n "$journal" ] && { [ "$rc" = 14 ] || [ "$rc" = 15 ]; } && ! hibernated "$said"; then
        discard_journal
        rc=0
        said=$(ntfs-3g.probe --readwrite "$real" 2>&1) || rc=$?
        ntfsinfo -m "$real" >/dev/null 2>&1 || refuse "$marked"
      fi
      [ "$rc" = 0 ] || refuse "$dev cannot be read-write: $(ntfs_refusal "$rc" "$said")"
    fi
  fi

  mkdir -p "$base"
  [ -d "$dir" ] || mkdir -m 0755 "$dir"
  [ -z "$(ls -A "$dir")" ] || die "$dir is not empty; something wrote there while the disk was missing"
  chattr +i "$dir"
  if [ ! -e "$units/$unit" ] || [ "$(cat "$units/$unit")" != "$want" ]; then
    printf '%s\n' "$want" >"$units/$unit"
    "$systemctl" daemon-reload
  fi
  "$systemctl" enable -q "$unit"
  "$systemctl" start "$unit" || true
  now=$(mounted_mode "$dir")
  # ntfs-3g mounts an unsafe volume read-only instead of read-write.
  [ "$now" = "$mode" ] || take_down "$dev mounted ${now:-not at all} instead of $mode; nothing kept mounted (journalctl -u $unit)"
  source=$(findmnt -rno SOURCE --mountpoint "$dir" | head -1)
  [ "$(readlink -f "$source")" = "$real" ] || take_down "$dir came up holding $source, not $dev; nothing kept mounted"
  echo mounted
}

case ${1:-} in
  mount) shift && mount_disk "$@" && metrics ;;
  unmount) [ $# = 2 ] || die "usage: nb-legacy-disk unmount NAME" && unmount "$2" && metrics ;;
  list) list ;;
  metrics) metrics ;;
  *) die "usage: nb-legacy-disk mount|unmount|list|metrics" ;;
esac
