#!/bin/sh
# Generated by nullbill. Copies a disk kept from a previous OS before it is
# converted (docs/adr/0007-legacy-disks.md, phase 2).
#
#   nb-legacy-copy copy NAME STORAGE VMID SIZE_GIB DISK_ID
#   nb-legacy-copy list
#
# copy makes a SIZE_GIB volume on the LVM storage STORAGE, owned by the
# files guest VMID, puts ext4 on it and copies /mnt/nb-legacy/NAME into it
# with rsync. It then compares the two trees entry by entry (type, size,
# link target) and the SHA-256 of a sample of the files: at least 200, and
# at least 1 % of them, or all if there are fewer. Only a copy that passes
# is recorded in /var/lib/nullbill/kept-copies (NAME VOLUME SIZE_GIB FILES
# BYTES DISK_ID), which apply reads before it lets the disk be wiped. A copy
# that fails is freed and nothing is recorded. Prints "kept VOLUME" or
# "copied VOLUME".
#
# The kept disk is only read. Named data streams (ntfs-3g shows them as
# extended attributes, such as Windows' "downloaded from the internet"
# mark) are not copied: ext4 cannot hold large ones.
set -eu
base=${NB_LEGACY_DIR:-/mnt/nb-legacy}
records=${NB_COPIES:-/var/lib/nullbill/kept-copies}
work=${NB_COPY_DIR:-/run/nb-legacy-copy}
pvesm=${NB_PVESM:-pvesm}
pvesh=${NB_PVESH:-pvesh}
pending=$records.pending

die() {
  echo "nb-legacy-copy: $*" >&2
  exit 1
}

recorded() { # name -> its record line, if any
  [ -e "$records" ] || return 1
  awk -v n="$1" '$1 == n {print; found=1} END {exit !found}' "$records"
}

# A volume this script made and never finished: the files guest has no use
# for it, so it is freed before trying again.
free_pending() {
  [ -e "$pending" ] || return 0
  while read -r left_name left_volume; do
    [ -n "$left_volume" ] || continue
    if ! recorded "$left_name" >/dev/null; then
      "$pvesm" free "$left_volume" >/dev/null 2>&1 || true
      echo "nb-legacy-copy: freed $left_volume, left over from an unfinished copy of $left_name" >&2
    fi
  done <"$pending"
  rm -f "$pending"
}

# Compare two trees and hash a sample; print FILES BYTES SAMPLED.
compare() {
  python3 -I - "$1" "$2" <<'PY'
import hashlib, math, os, stat, sys

def manifest(root):
    out = {}
    for top, dirs, files in os.walk(root):
        for name in dirs + files:
            path = os.path.join(top, name)
            rel = os.path.relpath(path, root)
            st = os.lstat(path)
            if stat.S_ISLNK(st.st_mode):
                out[rel] = ("l", os.readlink(path))
            elif stat.S_ISDIR(st.st_mode):
                out[rel] = ("d", "")
            elif stat.S_ISREG(st.st_mode):
                out[rel] = ("f", st.st_size)
            else:
                out[rel] = ("o", "")
    return out

def sha(path):
    h = hashlib.sha256()
    with open(path, "rb") as f:
        for block in iter(lambda: f.read(1 << 20), b""):
            h.update(block)
    return h.hexdigest()

src, dst = sys.argv[1], sys.argv[2]
a, b = manifest(src), manifest(dst)
if a != b:
    missing = sorted(set(a) - set(b))[:3]
    extra = sorted(set(b) - set(a))[:3]
    differ = sorted(k for k in set(a) & set(b) if a[k] != b[k])[:3]
    sys.exit(f"the copy differs: missing {missing}, extra {extra}, different {differ}")
files = sorted(k for k, v in a.items() if v[0] == "f")
want = min(len(files), max(200, math.ceil(len(files) / 100)))
step = len(files) / want if want else 1
sample = [files[int(i * step)] for i in range(want)]
for rel in sample:
    if sha(os.path.join(src, rel)) != sha(os.path.join(dst, rel)):
        sys.exit(f"the copy differs: {rel!r} has other contents")
print(len(files), sum(a[k][1] for k in files), len(sample))
PY
}

copy() {
  [ $# = 5 ] || die "usage: nb-legacy-copy copy NAME STORAGE VMID SIZE_GIB DISK_ID"
  name=$1 storage=$2 vmid=$3 size=$4 disk=$5
  printf '%s' "$name" | grep -Eqx '[a-z][a-z0-9-]{0,30}' || die "bad name $name"
  printf '%s' "$vmid$size" | grep -Eqx '[0-9]+' || die "VMID and SIZE_GIB are numbers"
  if line=$(recorded "$name"); then
    echo "kept $(echo "$line" | cut -d' ' -f2)"
    return
  fi
  src=$base/$name
  # The disk itself, not the empty mount point under it.
  [ -n "$(findmnt -rno TARGET --mountpoint "$src" 2>/dev/null)" ] || die "$src is not mounted; is the disk connected?"
  free_pending

  status=$("$pvesh" get "/nodes/localhost/storage/$storage/status" --output-format json) || die "no storage $storage"
  # shellcheck disable=SC2046 # three words, split on purpose
  set -- $(printf '%s' "$status" | python3 -I -c 'import json,sys; s=json.load(sys.stdin); print(s.get("type"), int(s.get("total", 0)), int(s.get("avail", 0)))')
  type=$1 total=$2 avail=$3
  case $type in lvmthin | lvm) ;; *) die "$storage is $type; a copy goes on LVM or LVM-thin storage" ;; esac
  # Leave 5 % of the storage free: a thin pool that fills up stops every guest on it.
  need=$((size * 1073741824))
  [ "$need" -le $((avail - total / 20)) ] || die "$storage has $((avail / 1073741824)) GiB free; the copy needs $size GiB and 5 % must stay free"

  n=0
  while "$pvesm" list "$storage" --vmid "$vmid" 2>/dev/null | grep -q "^$storage:vm-$vmid-disk-$n "; do n=$((n + 1)); done
  volume=$storage:vm-$vmid-disk-$n
  mkdir -p "$(dirname "$records")"
  printf '%s %s\n' "$name" "$volume" >>"$pending"
  "$pvesm" alloc "$storage" "$vmid" "vm-$vmid-disk-$n" "${size}G" >/dev/null
  dst=$work/$name
  # From here on a failure frees the volume: it holds nothing but this copy.
  trap 'kill "${ticker:-}" 2>/dev/null || true; umount "$dst" 2>/dev/null || true; "$pvesm" free "$volume" >/dev/null 2>&1 || true; sed -i "\|^$name $volume\$|d" "$pending"; [ -s "$pending" ] || rm -f "$pending"' EXIT
  dev=$("$pvesm" path "$volume")
  [ -z "$(blkid -p -o value -s TYPE "$dev" 2>/dev/null || true)" ] || die "the new volume $volume is not empty"
  mkfs.ext4 -q -m 0 "$dev"
  mkdir -p "$dst"
  mount "$dev" "$dst"
  # Not part of the owner's files; fsck makes it again when it needs it.
  rmdir "$dst/lost+found"
  total=$(findmnt -bno USED --mountpoint "$src" | head -1)
  echo "nb-legacy-copy: copying $src ($((${total:-0} / 1048576)) MiB) to $volume" >&2
  # A line a minute while it copies: hours, for a full disk.
  (while sleep 60; do
    done_bytes=$(findmnt -bno USED --mountpoint "$dst" | head -1)
    echo "nb-legacy-copy: $((${done_bytes:-0} / 1048576)) MiB copied" >&2
  done) &
  ticker=$!
  rc=0
  rsync -aH --numeric-ids "$src/" "$dst/" >&2 || rc=$?
  kill "$ticker" 2>/dev/null || true
  [ "$rc" = 0 ] || die "rsync failed (exit $rc); nothing recorded, the disk is as it was"
  sync
  result=$(compare "$src" "$dst") || die "the copy of $name did not verify; nothing recorded, the disk is as it was"
  umount "$dst"
  rmdir "$dst"
  # shellcheck disable=SC2086 # FILES BYTES SAMPLED
  set -- $result
  tmp=$records.tmp
  { [ ! -e "$records" ] || cat "$records"; echo "$name $volume $size $1 $2 $disk"; } >"$tmp"
  mv "$tmp" "$records"
  trap - EXIT
  sed -i "\|^$name $volume\$|d" "$pending"
  [ -s "$pending" ] || rm -f "$pending"
  echo "nb-legacy-copy: $1 files, $2 bytes; $3 compared by SHA-256" >&2
  echo "copied $volume"
}

case ${1:-} in
  copy) shift && copy "$@" ;;
  list) [ ! -e "$records" ] || cat "$records" ;;
  *) die "usage: nb-legacy-copy copy|list" ;;
esac
