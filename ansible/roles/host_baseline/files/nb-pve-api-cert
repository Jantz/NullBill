#!/bin/sh
# Generated by nullbill. usage: nb-pve-api-cert NAME ADDRESS [CERT KEY]
#
# Guests reach the PVE API as NAME (pve.<domain>) at ADDRESS on the mgmt
# bridge, but PVE's own certificate names only the host's LAN name and
# address. This issues one from PVE's own CA that names both as well, and
# installs it in pvenode's custom-certificate slot (pveproxy-ssl.pem), so
# every client that trusts pve-root-ca.pem still does. It is kept while
# PVE's CA signed it, it names both and has 30 days left.
#
# With CERT and KEY (NullBill's browser CA, src/nullbill/browserca.py, once
# the home network is closed) it installs those instead, unless they are
# installed already. Prints "kept" or "issued".
#
# Its expiry goes to node_exporter's textfile collector, for the
# PveApiCertificateExpires alert.
set -eu
name=$1 addr=$2
pve=${NB_PVE_DIR:-/etc/pve}
textfile=${NB_TEXTFILE_DIR:-/var/lib/prometheus/node-exporter}
node=$(hostname)
current=$pve/nodes/$node/pveproxy-ssl.pem

names() { openssl x509 -in "$1" -noout -ext subjectAltName | tail -n +2 | tr -d ' ' | sed 's/IPAddress:/IP:/g'; }

has() { names "$current" | tr ',' '\n' | grep -qx "$1"; }

metric() {
  end=$(date -d "$(openssl x509 -in "$current" -noout -enddate | cut -d= -f2)" +%s)
  mkdir -p "$textfile"
  tmp=$(mktemp "$textfile/.nullbill-pve-api.XXXXXX")
  printf '# HELP nb_pve_api_cert_expiry_timestamp_seconds When the PVE API certificate guests use expires.\n# TYPE nb_pve_api_cert_expiry_timestamp_seconds gauge\nnb_pve_api_cert_expiry_timestamp_seconds %s\n' "$end" >"$tmp"
  chmod 0644 "$tmp"
  mv "$tmp" "$textfile/nullbill-pve-api.prom"
}

fp() { openssl x509 -in "$1" -noout -fingerprint -sha256; }

if [ $# -eq 4 ]; then
  if [ -f "$current" ] && [ "$(fp "$current")" = "$(fp "$3")" ]; then
    echo kept
  else
    pvenode cert set "$3" "$4" --force 1 --restart 1 >/dev/null
    echo issued
  fi
  metric
  exit 0
fi

if [ -f "$current" ] && openssl verify -CAfile "$pve/pve-root-ca.pem" "$current" >/dev/null 2>&1 &&
  has "DNS:$name" && has "IP:$addr" && openssl x509 -in "$current" -noout -checkend 2592000 >/dev/null; then
  metric
  echo kept
  exit 0
fi

work=$(mktemp -d)
trap 'rm -rf "$work"' EXIT
openssl req -new -newkey rsa:2048 -nodes -subj "/CN=$name" -keyout "$work/key.pem" -out "$work/req.csr" 2>/dev/null
{
  printf 'subjectAltName=%s,DNS:%s,IP:%s\n' "$(names "$pve/nodes/$node/pve-ssl.pem")" "$name" "$addr"
  printf 'basicConstraints=CA:FALSE\nkeyUsage=digitalSignature,keyEncipherment\nextendedKeyUsage=serverAuth\n'
} >"$work/ext"
openssl x509 -req -in "$work/req.csr" -CA "$pve/pve-root-ca.pem" -CAkey "$pve/priv/pve-root-ca.key" \
  -CAserial "$pve/priv/pve-root-ca.srl" -CAcreateserial -days 730 -sha256 -extfile "$work/ext" -out "$work/cert.pem" 2>/dev/null
pvenode cert set "$work/cert.pem" "$work/key.pem" --force 1 --restart 1 >/dev/null
metric
echo issued
