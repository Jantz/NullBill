#!/bin/sh
# Generated by nullbill. usage: nb-storage-disk DISK_ID WIPE NAME
#
# Makes a disk the plan pins as storage (disks.<id>.use: storage) an LVM
# volume group NAME holding one thin pool, data, and adds it to PVE as the
# LVM-thin storage NAME for images and container volumes. Guests stay where
# the plan puts them; the storage is for what the owner or apply moves there
# (docs/adr/0007-legacy-disks.md, phase 3).
#
# A disk that carries any signature is refused unless WIPE is 1
# (disks.<id>.wipe in config.yaml); then every signature on it and its
# partitions is erased first. A disk that already holds the group is kept as
# it is. A disk or partition that is mounted is never touched. Prints "kept"
# or "made".
set -eu
[ $# = 3 ] || { echo "usage: nb-storage-disk DISK_ID WIPE NAME" >&2; exit 1; }
id=$1 wipe=$2 vg=$3
dev=${NB_DISK_DIR:-/dev/disk/by-id}/$id
pool=data

die() {
  echo "nb-storage-disk: $*" >&2
  exit 1
}

printf '%s' "$vg" | grep -Eqx 'nb-[a-z][a-z0-9-]{0,30}' || die "bad storage name $vg"
[ -b "$dev" ] || die "no disk $dev"
real=$(readlink -f "$dev")

if vgs "$vg" >/dev/null 2>&1; then
  pvs --noheadings -o pv_name --select "vg_name=$vg" | tr -d ' ' | grep -qx "$real" \
    || die "volume group $vg exists, but not on $dev"
  status=kept
else
  if pvesm status --storage "$vg" >/dev/null 2>&1; then
    die "PVE already has a storage named $vg on something else"
  fi
  if lsblk -nro MOUNTPOINT "$real" | grep -q .; then
    die "$dev or a partition on it is mounted"
  fi
  # Probed on the disk itself, not taken from udev's records.
  signatures=$(for d in $(lsblk -nrpo NAME "$real"); do wipefs --noheadings -O TYPE "$d"; done | sort -u | tr '\n' ' ' | sed 's/ $//')
  if [ -n "$signatures" ]; then
    [ "$wipe" = 1 ] || die "$dev carries $signatures; set wipe: true for it in config.yaml to let apply erase it"
    for part in $(lsblk -nrpo NAME "$real" | tail -n +2); do
      wipefs -q -a "$part"
    done
    wipefs -q -a "$real"
  fi
  pvcreate -q "$real" >/dev/null
  vgcreate -q "$vg" "$real" >/dev/null
  status=made
fi

# The pool leaves 5 % of the group for its metadata to grow into.
if ! lvs "$vg/$pool" >/dev/null 2>&1; then
  lvcreate -q -y -l 95%FREE --thinpool "$pool" "$vg" >/dev/null
fi
if ! pvesm status --storage "$vg" >/dev/null 2>&1; then
  pvesm add lvmthin "$vg" --vgname "$vg" --thinpool "$pool" --content images,rootdir
fi
echo "$status"
