## Generated by nullbill. Changes to identity, SSH, sudo and apt sources,
## kernel module loads, and every command a login runs as root.
-w /etc/passwd -p wa -k identity
-w /etc/group -p wa -k identity
-w /etc/shadow -p wa -k identity
-w /etc/gshadow -p wa -k identity
-w /etc/ssh/sshd_config -p wa -k sshd
-w /etc/ssh/sshd_config.d/ -p wa -k sshd
-w /etc/sudoers -p wa -k sudo
-w /etc/sudoers.d/ -p wa -k sudo
-w /etc/apt/sources.list.d/ -p wa -k apt-sources
-a always,exit -F arch=b64 -S init_module,finit_module,delete_module -k modules
## Daemons have no login uid, so this records people, not services.
-a always,exit -F arch=b64 -S execve -F euid=0 -F auid!=unset -k root-exec
