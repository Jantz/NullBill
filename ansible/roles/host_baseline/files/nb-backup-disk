#!/bin/sh
# Generated by nullbill. usage: nb-backup-disk DISK_ID WIPE
#
# Makes the disk the plan pins for PBS an LVM volume group with a PVE
# storage of the same name, on which OpenTofu gives the pbs VM its
# datastore disk. A disk that carries any signature is refused unless WIPE
# is 1 (disks.<id>.wipe in config.yaml); then every signature on it and its
# partitions is erased first. A disk that already holds the group is kept
# as it is. Prints "kept" or "made".
set -eu
id=$1 wipe=$2
vg=${NB_BACKUP_VG:-nb-pbs-disk}
dev=${NB_DISK_DIR:-/dev/disk/by-id}/$id

[ -b "$dev" ] || { echo "nb-backup-disk: no disk $dev" >&2; exit 1; }
real=$(readlink -f "$dev")

if vgs "$vg" >/dev/null 2>&1; then
  pvs --noheadings -o pv_name --select "vg_name=$vg" | tr -d ' ' | grep -qx "$real" \
    || { echo "nb-backup-disk: volume group $vg exists, but not on $dev" >&2; exit 1; }
  status=kept
else
  if lsblk -nro MOUNTPOINT "$real" | grep -q .; then
    echo "nb-backup-disk: $dev or a partition on it is mounted" >&2
    exit 1
  fi
  # Probed on the disk itself, not taken from udev's records.
  signatures=$(for d in $(lsblk -nrpo NAME "$real"); do wipefs --noheadings -O TYPE "$d"; done | sort -u | tr '\n' ' ' | sed 's/ $//')
  if [ -n "$signatures" ]; then
    if [ "$wipe" != 1 ]; then
      echo "nb-backup-disk: $dev carries $signatures; set wipe: true for it in config.yaml to let apply erase it" >&2
      exit 1
    fi
    for part in $(lsblk -nrpo NAME "$real" | tail -n +2); do
      wipefs -q -a "$part"
    done
    wipefs -q -a "$real"
  fi
  pvcreate -q "$real" >/dev/null
  vgcreate -q "$vg" "$real" >/dev/null
  status=made
fi

if ! pvesm status --storage "$vg" >/dev/null 2>&1; then
  pvesm add lvm "$vg" --vgname "$vg" --content images
fi
echo "$status"
