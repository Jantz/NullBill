#!/usr/bin/python3
"""Generated by nullbill. Backup health for node_exporter's textfile
collector, for the monitoring role's backup alerts (#13) and the page's
Backups page.

For each guest in the nightly job (src/nullbill/backups.py's JOB), the time
of its newest encrypted backup on the PBS storage. A guest with none yet
counts from when this script first saw it in the job, so one that never gets
a backup alerts like one whose backups stopped. Without the job (nowhere to
keep backups in the plan) it writes nothing. When PVE or PBS cannot be
asked, nb_backup_status_ok is 0 and no ages are written.

The restore test: once for each night's backups, one container's newest
backup is opened with the host's key and its /etc/hostname read back and
compared with the container's name; the container whose test is oldest
goes first, so each gets its turn. A failed test is tried again each hour.
Only files are read, into a temporary directory; no guest is touched.

A systemd timer runs it every hour.
"""

import json
import os
import subprocess
import tempfile
import time
from pathlib import Path

JOB = "nb-nightly"
STORAGE = "nb-pbs"
TEXTFILE = Path(os.environ.get("NB_TEXTFILE_DIR", "/var/lib/prometheus/node-exporter"))
STATE_DIR = Path(os.environ.get("NB_STATE_DIR", "/var/lib/nullbill"))
STATE = STATE_DIR / "backups-seen.json"
RESTORE = STATE_DIR / "restore-test.json"
# PVE keeps the storage's token secret (.pw) and encryption key (.enc) here.
PRIV = Path(os.environ.get("NB_PRIV_DIR", "/etc/pve/priv/storage"))
RESTORE_FILE = "etc/hostname"
RESTORE_TIMEOUT_S = 600
OUT = "nullbill-backups.prom"


class Unavailable(Exception):
    pass


def pvesh(path: str, *args: str):
    try:
        done = subprocess.run(
            ["pvesh", "get", path, "--output-format", "json", *args],
            capture_output=True,
            text=True,
            timeout=300,
        )
    except (OSError, subprocess.TimeoutExpired) as e:
        raise Unavailable(f"{path}: {e}") from e
    if done.returncode != 0:
        raise Unavailable(f"{path}: {(done.stderr or done.stdout).strip()[:200]}")
    return json.loads(done.stdout or "null")


def job_guests() -> list[int] | None:
    """The job's VMIDs, or None when there is no job."""
    for job in pvesh("/cluster/backup") or []:
        if job.get("id") == JOB:
            return sorted({int(v) for v in str(job.get("vmid", "")).split(",") if v.strip()})
    return None


def names() -> dict[int, str]:
    try:
        return {int(r["vmid"]): r.get("name", "") for r in pvesh("/cluster/resources", "--type", "vm") or []}
    except Unavailable:
        return {}


def newest(entries: list[dict]) -> dict[int, int]:
    best: dict[int, int] = {}
    for e in entries:
        if not e.get("encrypted") or "vmid" not in e:
            continue
        vmid, ctime = int(e["vmid"]), int(e["ctime"])
        best[vmid] = max(best.get(vmid, 0), ctime)
    return best


def seen(vmids: list[int], now: int) -> dict[int, int]:
    """When each VMID was first seen in the job, kept across runs."""
    try:
        known = {int(k): int(v) for k, v in json.loads(STATE.read_text()).items()}
    except (OSError, ValueError):
        known = {}
    current = {v: known.get(v, now) for v in vmids}
    if current != known:
        STATE.parent.mkdir(parents=True, exist_ok=True)
        STATE.write_text(json.dumps({str(k): v for k, v in current.items()}) + "\n")
    return current


def containers(entries: list[dict]) -> dict[int, dict]:
    """Each container's newest encrypted backup."""
    best: dict[int, dict] = {}
    for e in entries:
        if not e.get("encrypted") or "vmid" not in e or ":backup/ct/" not in str(e.get("volid", "")):
            continue
        vmid = int(e["vmid"])
        if vmid not in best or int(e["ctime"]) > int(best[vmid]["ctime"]):
            best[vmid] = e
    return best


def read_back(entry: dict) -> str:
    """One file from a backup, restored into a temporary directory with the
    host's token and key, as verify's restore test does."""
    storage = pvesh(f"/storage/{STORAGE}")
    snapshot = entry["volid"].split(":", 1)[1].removeprefix("backup/")
    repo = f"{storage['username']}@{storage['server']}:{storage['datastore']}"
    key = PRIV / f"{STORAGE}.enc"
    env = os.environ | {"PBS_PASSWORD": (PRIV / f"{STORAGE}.pw").read_text().strip(), "PBS_FINGERPRINT": storage["fingerprint"]}
    with tempfile.TemporaryDirectory(prefix="nb-restore-test.") as tmp:
        argv = ["proxmox-backup-client", "restore", "--repository", repo, snapshot, "root.pxar", tmp]
        argv += ["--pattern", RESTORE_FILE, "--keyfile", str(key)]
        done = subprocess.run(argv, env=env, capture_output=True, text=True, timeout=RESTORE_TIMEOUT_S)
        if done.returncode != 0:
            raise Unavailable(
                (done.stderr or done.stdout).strip().splitlines()[-1][:200] if (done.stderr or done.stdout).strip() else "failed"
            )
        return (Path(tmp) / RESTORE_FILE).read_text().strip()


def restore_test(entries: list[dict], vmids: list[int], guest: dict[int, str], now: int) -> dict | None:
    """The last restore test, after running one when a night's backups have
    not been tested yet or the last one failed. None before any."""
    try:
        state = json.loads(RESTORE.read_text())
    except (OSError, ValueError):
        state = {}
    newest = {v: e for v, e in containers(entries).items() if v in vmids}
    tested = {int(k): v for k, v in state.get("tested", {}).items()}
    last = state.get("last")
    if not newest:
        return last
    night = max(int(e["ctime"]) for e in newest.values())
    if last and last["ok"] and last["night"] >= night:
        return last
    # The container tested longest ago, or never; a failed one again first.
    retry = last["vmid"] if last and not last["ok"] and last["vmid"] in newest else None
    vmid = retry or min(newest, key=lambda v: (tested.get(v, 0), v))
    entry, want = newest[vmid], guest.get(vmid, "")
    try:
        got = read_back(entry)
        ok = bool(want) and got == want
        detail = "" if ok else f"{RESTORE_FILE} holds {got!r}, expected {want!r}"
    except (Unavailable, OSError, KeyError, subprocess.TimeoutExpired) as e:
        ok, detail = False, str(e)[:200]
    last = {"ok": ok, "at": now, "vmid": vmid, "guest": want, "backup": int(entry["ctime"]), "night": night, "detail": detail}
    if ok:
        tested[vmid] = now
    STATE_DIR.mkdir(parents=True, exist_ok=True)
    RESTORE.write_text(json.dumps({"tested": {str(k): v for k, v in tested.items() if k in vmids}, "last": last}) + "\n")
    return last


def store() -> dict | None:
    """How full the datastore is, as PVE reads it from PBS."""
    try:
        status = pvesh(f"/nodes/localhost/storage/{STORAGE}/status")
        return {"size": int(status["total"]), "used": int(status["used"])}
    except (Unavailable, KeyError, TypeError, ValueError):
        return None


def label(value: str) -> str:
    return value.replace("\\", "\\\\").replace('"', '\\"').replace("\n", " ")


def render(
    ok: bool,
    vmids: list[int],
    last: dict[int, int],
    since: dict[int, int],
    guest: dict[int, str],
    restore: dict | None = None,
    room: dict | None = None,
) -> str:
    lines = [
        "# HELP nb_backup_status_ok 1 when PVE listed the nightly job and the PBS storage's backups.",
        "# TYPE nb_backup_status_ok gauge",
        f"nb_backup_status_ok {int(ok)}",
    ]
    if ok:
        lines += [
            "# HELP nb_backup_last_success_timestamp_seconds Newest encrypted backup of a guest in the nightly job; "
            "until its first, when the guest joined the job.",
            "# TYPE nb_backup_last_success_timestamp_seconds gauge",
        ]
        for vmid in vmids:
            when = last.get(vmid, since[vmid])
            lines.append(f'nb_backup_last_success_timestamp_seconds{{vmid="{vmid}",guest="{label(guest.get(vmid, ""))}"}} {when}')
            lines.append(f'nb_backup_exists{{vmid="{vmid}",guest="{label(guest.get(vmid, ""))}"}} {int(vmid in last)}')
    if ok and restore:
        who = f'vmid="{restore["vmid"]}",guest="{label(restore["guest"])}"'
        lines += [
            "# HELP nb_backup_restore_ok 1 when a file read back from the newest backup of this container was what it should be.",
            "# TYPE nb_backup_restore_ok gauge",
            f"nb_backup_restore_ok{{{who}}} {int(restore['ok'])}",
            "# HELP nb_backup_restore_timestamp_seconds When that restore test ran.",
            "# TYPE nb_backup_restore_timestamp_seconds gauge",
            f"nb_backup_restore_timestamp_seconds{{{who}}} {restore['at']}",
            "# HELP nb_backup_restore_backup_timestamp_seconds When the backup it read from was made.",
            "# TYPE nb_backup_restore_backup_timestamp_seconds gauge",
            f"nb_backup_restore_backup_timestamp_seconds{{{who}}} {restore['backup']}",
        ]
    if ok and room:
        lines += [
            "# HELP nb_backup_store_bytes The datastore's size and what the backups use of it.",
            "# TYPE nb_backup_store_bytes gauge",
            f'nb_backup_store_bytes{{kind="size"}} {room["size"]}',
            f'nb_backup_store_bytes{{kind="used"}} {room["used"]}',
        ]
    return "\n".join(lines) + "\n"


def write(text: str | None) -> None:
    path = TEXTFILE / OUT
    if text is None:
        path.unlink(missing_ok=True)
        return
    TEXTFILE.mkdir(parents=True, exist_ok=True)
    fd, tmp = tempfile.mkstemp(dir=TEXTFILE, prefix=".nullbill-backups.")
    with os.fdopen(fd, "w") as f:
        f.write(text)
    os.chmod(tmp, 0o644)
    os.replace(tmp, path)


def main() -> None:
    now = int(time.time())
    try:
        vmids = job_guests()
        if vmids is None:
            write(None)
            print("no nightly job")
            return
        entries = pvesh(f"/nodes/localhost/storage/{STORAGE}/content", "--content", "backup") or []
    except Unavailable as e:
        write(render(False, [], {}, {}, {}))
        print(f"unavailable: {e}")
        return
    last, guest = newest(entries), names()
    restore = restore_test(entries, vmids, guest, now)
    write(render(True, vmids, last, seen(vmids, now), guest, restore, store()))
    said = f"{len(vmids)} guests, {len([v for v in vmids if v in last])} with a backup"
    if restore:
        said += f"; restore test of {restore['guest'] or restore['vmid']} " + (
            "passed" if restore["ok"] else f"failed: {restore['detail']}"
        )
    print(said)


if __name__ == "__main__":
    main()
