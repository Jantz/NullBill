#!/usr/bin/python3
"""Generated by nullbill. Backup health for node_exporter's textfile
collector, for the monitoring role's backup alerts (#13).

For each guest in the nightly job (src/nullbill/backups.py's JOB), the time
of its newest encrypted backup on the PBS storage. A guest with none yet
counts from when this script first saw it in the job, so one that never gets
a backup alerts like one whose backups stopped. Without the job (no disk for
PBS in the plan) it writes nothing. When PVE or PBS cannot be asked,
nb_backup_status_ok is 0 and no ages are written.

A systemd timer runs it every hour.
"""

import json
import os
import subprocess
import tempfile
import time
from pathlib import Path

JOB = "nb-nightly"
STORAGE = "nb-pbs"
TEXTFILE = Path(os.environ.get("NB_TEXTFILE_DIR", "/var/lib/prometheus/node-exporter"))
STATE = Path(os.environ.get("NB_STATE_DIR", "/var/lib/nullbill")) / "backups-seen.json"
OUT = "nullbill-backups.prom"


class Unavailable(Exception):
    pass


def pvesh(path: str, *args: str):
    try:
        done = subprocess.run(
            ["pvesh", "get", path, "--output-format", "json", *args],
            capture_output=True,
            text=True,
            timeout=300,
        )
    except (OSError, subprocess.TimeoutExpired) as e:
        raise Unavailable(f"{path}: {e}") from e
    if done.returncode != 0:
        raise Unavailable(f"{path}: {(done.stderr or done.stdout).strip()[:200]}")
    return json.loads(done.stdout or "null")


def job_guests() -> list[int] | None:
    """The job's VMIDs, or None when there is no job."""
    for job in pvesh("/cluster/backup") or []:
        if job.get("id") == JOB:
            return sorted({int(v) for v in str(job.get("vmid", "")).split(",") if v.strip()})
    return None


def names() -> dict[int, str]:
    try:
        return {int(r["vmid"]): r.get("name", "") for r in pvesh("/cluster/resources", "--type", "vm") or []}
    except Unavailable:
        return {}


def newest(entries: list[dict]) -> dict[int, int]:
    best: dict[int, int] = {}
    for e in entries:
        if not e.get("encrypted") or "vmid" not in e:
            continue
        vmid, ctime = int(e["vmid"]), int(e["ctime"])
        best[vmid] = max(best.get(vmid, 0), ctime)
    return best


def seen(vmids: list[int], now: int) -> dict[int, int]:
    """When each VMID was first seen in the job, kept across runs."""
    try:
        known = {int(k): int(v) for k, v in json.loads(STATE.read_text()).items()}
    except (OSError, ValueError):
        known = {}
    current = {v: known.get(v, now) for v in vmids}
    if current != known:
        STATE.parent.mkdir(parents=True, exist_ok=True)
        STATE.write_text(json.dumps({str(k): v for k, v in current.items()}) + "\n")
    return current


def label(value: str) -> str:
    return value.replace("\\", "\\\\").replace('"', '\\"').replace("\n", " ")


def render(ok: bool, vmids: list[int], last: dict[int, int], since: dict[int, int], guest: dict[int, str]) -> str:
    lines = [
        "# HELP nb_backup_status_ok 1 when PVE listed the nightly job and the PBS storage's backups.",
        "# TYPE nb_backup_status_ok gauge",
        f"nb_backup_status_ok {int(ok)}",
    ]
    if ok:
        lines += [
            "# HELP nb_backup_last_success_timestamp_seconds Newest encrypted backup of a guest in the nightly job; "
            "until its first, when the guest joined the job.",
            "# TYPE nb_backup_last_success_timestamp_seconds gauge",
        ]
        for vmid in vmids:
            when = last.get(vmid, since[vmid])
            lines.append(f'nb_backup_last_success_timestamp_seconds{{vmid="{vmid}",guest="{label(guest.get(vmid, ""))}"}} {when}')
    return "\n".join(lines) + "\n"


def write(text: str | None) -> None:
    path = TEXTFILE / OUT
    if text is None:
        path.unlink(missing_ok=True)
        return
    TEXTFILE.mkdir(parents=True, exist_ok=True)
    fd, tmp = tempfile.mkstemp(dir=TEXTFILE, prefix=".nullbill-backups.")
    with os.fdopen(fd, "w") as f:
        f.write(text)
    os.chmod(tmp, 0o644)
    os.replace(tmp, path)


def main() -> None:
    now = int(time.time())
    try:
        vmids = job_guests()
        if vmids is None:
            write(None)
            print("no nightly job")
            return
        last = newest(pvesh(f"/nodes/localhost/storage/{STORAGE}/content", "--content", "backup") or [])
    except Unavailable as e:
        write(render(False, [], {}, {}, {}))
        print(f"unavailable: {e}")
        return
    write(render(True, vmids, last, seen(vmids, now), names()))
    print(f"{len(vmids)} guests, {len([v for v in vmids if v in last])} with a backup")


if __name__ == "__main__":
    main()
