#!/usr/bin/python3
"""Generated by nullbill. Starts and stops the guests that run on demand
(docs/adr/0013-on-demand.md), by the rules apply writes to
/etc/nullbill/power.json (src/nullbill/power.py).

A workload on demand stays installed and off until someone starts it.
What runs on demand shares the memory the always-on guests leave
(headroom_mib); each workload counts memory_mib while any of it runs.

  nb-power status [--json]
  nb-power start <workload> [--stop a,b] [--keep] [--by who] [--json]
      Start it if it fits. When it does not, workloads that stop by
      themselves (stop: auto) and are not in use are stopped to make room;
      if that is not enough nothing changes, exit 3, and the answer names
      what would have to stop. --stop names those the caller agreed to.
  nb-power stop <workload> [--by who] [--json]
  nb-power keep <workload> on|off
      On: it is not stopped for being idle, and nobody is asked, until it
      is next stopped.
  nb-power tick
      Every minute, from nb-power.timer: see what is in use, stop what
      has been idle for its idle_minutes (stop: auto), mark what should be
      asked about (stop: ask), write metrics for node_exporter.
  nb-power setup begin | ensure <guest>.. | setup end
      For apply. begin notes what is off; ensure has the guests apply is
      about to configure running together, stopping what the run started
      before and nobody uses when they do not fit; end stops again what was
      off and nobody uses. While a setup run holds, nothing is stopped for
      being idle.

Use: a container answers `nb-busy` (the updates role) with a line per
reason it is in use; a pool is in use while a clone runs; cpu_pct, when
the rules give one, counts a guest's CPU over the last minute. A probe that
fails counts as use: a guest is never stopped because it could not be asked.
"""

import argparse
import contextlib
import fcntl
import json
import os
import subprocess
import sys
import syslog
import tempfile
import time
from pathlib import Path

POLICY = Path(os.environ.get("NB_POWER_POLICY", "/etc/nullbill/power.json"))
STATE_DIR = Path(os.environ.get("NB_STATE_DIR", "/var/lib/nullbill"))
STATE = STATE_DIR / "power.json"
LOCK = STATE_DIR / "power.lock"
TEXTFILE = Path(os.environ.get("NB_TEXTFILE_DIR", "/var/lib/prometheus/node-exporter"))
CGROUP = Path(os.environ.get("NB_CGROUP_ROOT", "/sys/fs/cgroup"))
MEMINFO = Path(os.environ.get("NB_MEMINFO", "/proc/meminfo"))
OUT = "nullbill-power.prom"
BUSY = "/usr/local/sbin/nb-busy"
TLS = "/etc/nullbill/tls"
STEP = "/etc/step-ca"
HOLD_S = 6 * 3600
# Left to the host when apply starts a guest that the counted memory has
# no room for.
SPARE_MIB = 512
EVENTS = 40
NO_ROOM = 3


class Failed(Exception):
    pass


def sh(argv: list[str], timeout: int = 60, stdin: str | None = None) -> tuple[int, str, str]:
    try:
        done = subprocess.run(argv, capture_output=True, text=True, timeout=timeout, input=stdin)
    except subprocess.TimeoutExpired:
        return 124, "", f"{argv[0]} {argv[1] if len(argv) > 1 else ''}: no answer within {timeout} s"
    except OSError as e:
        return 127, "", str(e)
    return done.returncode, done.stdout, done.stderr


def load_policy() -> dict:
    try:
        policy = json.loads(POLICY.read_text())
    except (OSError, ValueError):
        return {"headroom_mib": 0, "groups": {}}
    policy.setdefault("groups", {})
    return policy


def load_state() -> dict:
    try:
        state = json.loads(STATE.read_text())
    except (OSError, ValueError):
        state = {}
    state.setdefault("groups", {})
    state.setdefault("events", [])
    return state


def save(path: Path, text: str, mode: int = 0o600) -> None:
    path.parent.mkdir(parents=True, exist_ok=True)
    fd, tmp = tempfile.mkstemp(dir=path.parent, prefix=f".{path.name}.")
    with os.fdopen(fd, "w") as f:
        f.write(text)
    os.chmod(tmp, mode)
    os.replace(tmp, path)


@contextlib.contextmanager
def locked(wait: bool = True):
    """One nb-power changes things at a time. The timer's run gives way."""
    STATE_DIR.mkdir(parents=True, exist_ok=True)
    with open(LOCK, "w") as handle:
        try:
            fcntl.flock(handle, fcntl.LOCK_EX | (0 if wait else fcntl.LOCK_NB))
        except BlockingIOError:
            yield False
            return
        yield True


def guest_states(policy: dict) -> dict[int, str]:
    """VMID -> running or stopped, for every container and VM on the host.
    Nothing is asked while no rule names a guest."""
    states: dict[int, str] = {}
    if not policy["groups"]:
        return states
    for tool, column in (("pct", 1), ("qm", 2)):
        rc, out, err = sh([tool, "list"])
        if rc != 0:
            raise Failed(f"{tool} list: {(err or out).strip()[:200]}")
        for line in out.splitlines():
            fields = line.split()
            if len(fields) > column and fields[0].isdigit():
                states[int(fields[0])] = "running" if fields[column] == "running" else "stopped"
    return states


def switches(group: dict) -> list[dict]:
    return [g for g in group["guests"] if g["kind"] != "vm-pool"]


def clones(group: dict, states: dict[int, str]) -> int:
    return sum(1 for g in group["guests"] if g["kind"] == "vm-pool" for v in range(g["first"], g["last"] + 1) if states.get(v) == "running")


def guest_state(guest: dict, states: dict[int, str]) -> str:
    return states.get(guest["vmid"], "missing")


def group_state(group: dict, states: dict[int, str]) -> str:
    """on, off, partly (some of it runs), or missing (setup has not made it)."""
    found = [guest_state(g, states) for g in switches(group)]
    if "missing" in found:
        return "missing"
    if all(s == "running" for s in found):
        return "on"
    if any(s == "running" for s in found) or clones(group, states):
        return "partly"
    return "off"


def takes(group: dict, states: dict[int, str]) -> int:
    return group["memory_mib"] if group_state(group, states) in ("on", "partly") else 0


def cpu_pct(guest: dict, record: dict, now: float) -> float | None:
    """Percent of one core the guest used since the last look, or None on
    the first look or when its cgroup cannot be read."""
    scope = f"lxc/{guest['vmid']}" if guest["kind"] == "lxc" else f"qemu.slice/{guest['vmid']}.scope"
    try:
        stat = dict(line.split() for line in (CGROUP / scope / "cpu.stat").read_text().splitlines())
        usage = int(stat["usage_usec"])
    except (OSError, ValueError, KeyError):
        record.pop(guest["name"], None)
        return None
    before = record.get(guest["name"])
    record[guest["name"]] = [usage, now]
    if not before or now <= before[1] or usage < before[0]:
        return None
    return (usage - before[0]) / 1e6 / (now - before[1]) * 100


def in_use(group: dict, states: dict[int, str], record: dict, now: float) -> list[str]:
    """Why the group counts as in use right now; empty when it is idle."""
    reasons = []
    for guest in switches(group):
        if guest_state(guest, states) != "running":
            continue
        if guest["kind"] == "lxc":
            rc, out, err = sh(["pct", "exec", str(guest["vmid"]), "--", BUSY], timeout=30)
            if rc == 0:
                reasons += [line.strip()[:120] for line in out.splitlines() if line.strip()]
            else:
                why = "nb-busy is not installed yet; run setup" if rc in (126, 127) else (err or out).strip()[:80] or f"exit {rc}"
                reasons.append(f"cannot tell whether {guest['name']} is in use ({why})")
        if "cpu_pct" in group:
            pct = cpu_pct(guest, record.setdefault("cpu", {}), now)
            if pct is not None and pct >= group["cpu_pct"]:
                reasons.append(f"{guest['name']} is working (CPU {pct:.0f}%)")
    jobs = clones(group, states)
    if jobs:
        reasons.append(f"{jobs} CI job{'' if jobs == 1 else 's'} running")
    return reasons


def event(state: dict, group: str, what: str, why: str = "") -> None:
    state["events"] = [*state["events"], {"at": int(time.time()), "group": group, "what": what, "why": why}][-EVENTS:]
    syslog.syslog(f"{group}: {what}{f' ({why})' if why else ''}")


def wait_ready(guest: dict) -> None:
    """Until a started container has booted, so what comes next finds its
    network and services up. A VM is left to boot by itself."""
    if guest["kind"] == "lxc":
        sh(["pct", "exec", str(guest["vmid"]), "--", "systemctl", "is-system-running", "--wait"], timeout=120)


def start_guest(guest: dict) -> None:
    tool = "pct" if guest["kind"] == "lxc" else "qm"
    rc, out, err = sh([tool, "start", str(guest["vmid"])], timeout=180)
    if rc != 0:
        raise Failed(f"{guest['name']} did not start: {(err or out).strip()[:300] or f'exit {rc}'}")
    wait_ready(guest)


def stop_guest(guest: dict) -> None:
    """A clean shutdown. A container gets two minutes for it (a game
    server saves its world on the way down) and is then stopped; a VM is
    not, since its disk may be mid-write."""
    vmid = str(guest["vmid"])
    if guest["kind"] == "lxc":
        rc, out, err = sh(["pct", "shutdown", vmid, "--timeout", "120", "--forceStop", "1"], timeout=210)
    else:
        rc, out, err = sh(["qm", "shutdown", vmid, "--timeout", "180"], timeout=240)
    if rc != 0:
        hint = "" if guest["kind"] == "lxc" else "; shut it down from inside, or stop it in Proxmox"
        raise Failed(f"{guest['name']} did not shut down: {(err or out).strip()[:300] or f'exit {rc}'}{hint}")


def refresh_certs(policy: dict, guest: dict) -> list[str]:
    """A step-ca certificate lasts 24 h and is renewed with itself, so one
    that ran out while the guest was off needs a new one: a one-time token
    made on the CA guest, as apply does. Returns what could not be done."""
    problems = []
    for name in guest.get("certs", []):
        vmid = str(guest["vmid"])
        crt, key = f"{TLS}/{name}.crt", f"{TLS}/{name}.key"
        if sh(["pct", "exec", vmid, "--", "test", "-s", crt])[0] != 0:
            continue  # setup has not given it one yet
        if sh(["pct", "exec", vmid, "--", "openssl", "x509", "-checkend", "3600", "-noout", "-in", crt])[0] == 0:
            continue
        ca = policy.get("ca")
        if not ca:
            problems.append(f"{name}'s certificate has run out; run setup")
            continue
        argv = ["pct", "exec", str(ca["vmid"]), "--", "env", f"STEPPATH={STEP}", "step", "ca", "token", name, "--san", name]
        argv += ["--ca-url", ca["url"], "--root", f"{STEP}/certs/root_ca.crt"]
        argv += ["--provisioner", "admin", "--provisioner-password-file", f"{STEP}/secrets/password"]
        rc, token, err = sh(argv)
        if rc != 0 or not token.strip():
            problems.append(f"{name}'s certificate has run out and step-ca gave no token ({err.strip()[:120] or f'exit {rc}'}); run setup")
            continue
        # The token goes in on stdin, never on a command line of the host.
        issue = (
            f'read -r token && STEPPATH={TLS}/step step ca certificate "$0" "$1" "$2" --token "$token" '
            f'--ca-url "$3" --root {TLS}/root_ca.crt --force >/dev/null && /usr/local/sbin/nb-cert-renewed-"$0" && '
            'systemctl restart nb-cert-renew-"$0"'
        )
        rc, out, err = sh(["pct", "exec", vmid, "--", "sh", "-c", issue, name, crt, key, ca["url"]], stdin=token.strip() + "\n")
        if rc != 0:
            problems.append(f"{name}'s certificate has run out and no new one could be issued ({(err or out).strip()[:120]}); run setup")
        else:
            syslog.syslog(f"{guest['name']}: new certificate for {name}; the old one ran out while it was off")
    return problems


def catch_up(guest: dict) -> None:
    """A guest that was off missed its nightly security updates, and one
    that is only ever on for an hour never reaches the next: have apt look
    now. apt keeps its own daily stamps, so this costs nothing the second
    time in a day; nb-busy counts installing updates as use."""
    sh(["pct", "exec", str(guest["vmid"]), "--", "systemctl", "start", "--no-block", "apt-daily.service", "apt-daily-upgrade.service"])


def start_group(policy: dict, group: dict, states: dict[int, str]) -> list[str]:
    problems = []
    for guest in switches(group):
        if guest_state(guest, states) != "running":
            start_guest(guest)
            if guest["kind"] == "lxc":
                problems += refresh_certs(policy, guest)
                catch_up(guest)
    return problems


def stop_group(group: dict, states: dict[int, str]) -> None:
    for guest in reversed(switches(group)):
        if guest_state(guest, states) == "running":
            stop_guest(guest)


def held(state: dict, now: float) -> bool:
    return bool(state.get("setup")) and now < state["setup"]["until"]


def held_by_setup(state: dict, name: str, now: float) -> bool:
    return held(state, now) and name in state["setup"]["was_off"] and state["groups"].get(name, {}).get("by") != "owner"


def guest_view(guest: dict, states: dict[int, str]) -> dict:
    found = {"name": guest["name"], "kind": guest["kind"]}
    if guest["kind"] != "vm-pool":
        found |= {"vmid": guest["vmid"], "state": guest_state(guest, states)}
    return found


def view(policy: dict, state: dict, states: dict[int, str], now: float) -> dict:
    groups = []
    for name, group in policy["groups"].items():
        record = state["groups"].get(name, {})
        current = group_state(group, states)
        entry = {
            "name": name,
            "title": group["title"],
            "stop": group["stop"],
            "idle_minutes": group["idle_minutes"],
            "memory_mib": group["memory_mib"],
            "state": current,
            "guests": [guest_view(g, states) for g in group["guests"]],
        }
        if current in ("on", "partly"):
            since = record.get("since", now)
            idle = max(0, int(now - max(since, record.get("last_busy", 0))))
            entry |= {
                "since": int(since),
                "busy": record.get("busy", []),
                "idle_s": idle,
                "keep": bool(record.get("keep")),
                "asks": bool(record.get("asks")),
                "setup": held_by_setup(state, name, now),
            }
            if group["stop"] == "auto" and not entry["keep"] and not entry["busy"] and not held(state, now):
                entry["stops_in_s"] = max(0, group["idle_minutes"] * 60 - idle)
        groups.append(entry)
    used = sum(takes(g, states) for g in policy["groups"].values())
    return {
        "now": int(now),
        "ticked": state.get("ticked"),
        "headroom_mib": policy.get("headroom_mib", 0),
        "used_mib": used,
        "free_mib": policy.get("headroom_mib", 0) - used,
        "setup": bool(held(state, now)),
        "groups": groups,
        "events": state["events"],
    }


def render_metrics(policy: dict, state: dict, states: dict[int, str], now: float) -> str:
    def label(value: str) -> str:
        return value.replace("\\", "\\\\").replace('"', '\\"').replace("\n", " ")

    lines = [
        "# HELP nb_power_tick_timestamp_seconds When nb-power last looked at what runs on demand.",
        "# TYPE nb_power_tick_timestamp_seconds gauge",
        f"nb_power_tick_timestamp_seconds {int(now)}",
        "# HELP nb_power_headroom_mib Memory the plan leaves to what runs on demand.",
        "# TYPE nb_power_headroom_mib gauge",
        f"nb_power_headroom_mib {policy.get('headroom_mib', 0)}",
        "# HELP nb_power_used_mib What the on-demand workloads that run now count for.",
        "# TYPE nb_power_used_mib gauge",
        f"nb_power_used_mib {sum(takes(g, states) for g in policy['groups'].values())}",
    ]
    series: dict[str, list[str]] = {"guest_off": [], "guest_started": [], "group_on": [], "group_idle": [], "group_asks": []}
    for name, group in policy["groups"].items():
        record = state["groups"].get(name, {})
        current = group_state(group, states)
        tags = f'group="{label(name)}",title="{label(group["title"])}"'
        on = current in ("on", "partly")
        series["group_on"].append(f"nb_power_group_on{{{tags}}} {int(on)}")
        if on:
            idle = max(0, int(now - max(record.get("since", now), record.get("last_busy", 0))))
            series["group_idle"].append(f"nb_power_group_idle_seconds{{{tags}}} {idle}")
            series["group_asks"].append(f"nb_power_group_asks{{{tags}}} {int(bool(record.get('asks')))}")
        for guest in switches(group):
            running = guest_state(guest, states) == "running"
            who = f'guest="{label(guest["name"])}",group="{label(name)}"'
            series["guest_off"].append(f"nb_power_guest_off{{{who}}} {int(not running)}")
            if running:
                series["guest_started"].append(f"nb_power_guest_started_timestamp_seconds{{{who}}} {int(record.get('since', now))}")
    helps = {
        "guest_off": ("nb_power_guest_off", "1 while a guest that runs on demand is off, so its alerts keep quiet."),
        "guest_started": ("nb_power_guest_started_timestamp_seconds", "When a guest that runs on demand was last found started."),
        "group_on": ("nb_power_group_on", "1 while any of an on-demand workload runs."),
        "group_idle": ("nb_power_group_idle_seconds", "How long a running on-demand workload has gone without use."),
        "group_asks": ("nb_power_group_asks", "1 when a workload that only the owner stops has been idle for its idle_minutes."),
    }
    for key, (metric, text) in helps.items():
        if series[key]:
            lines += [f"# HELP {metric} {text}", f"# TYPE {metric} gauge", *series[key]]
    return "\n".join(lines) + "\n"


def write_metrics(policy: dict, state: dict, states: dict[int, str], now: float) -> None:
    path = TEXTFILE / OUT
    if not policy["groups"]:
        path.unlink(missing_ok=True)
        return
    save(path, render_metrics(policy, state, states, now), 0o644)


def look(policy: dict, state: dict, states: dict[int, str], now: float) -> None:
    """Bring each group's record up to date with what runs and what is in use."""
    for name, group in policy["groups"].items():
        if group_state(group, states) not in ("on", "partly"):
            state["groups"].pop(name, None)
            continue
        record = state["groups"].setdefault(name, {})
        record.setdefault("since", now)
        record["busy"] = in_use(group, states, record, now)
        if record["busy"]:
            record["last_busy"] = now
            record.pop("asks", None)
    for name in set(state["groups"]) - set(policy["groups"]):
        del state["groups"][name]


def end_setup(policy: dict, state: dict, states: dict[int, str], now: float) -> list[str]:
    """Stop again what was off before the setup run and nobody took up."""
    said = []
    setup = state.pop("setup", None) or {}
    for name in setup.get("was_off", []):
        group = policy["groups"].get(name)
        if group is None or group_state(group, states) not in ("on", "partly"):
            continue
        record = state["groups"].setdefault(name, {"since": now})
        if record.get("by") == "owner":
            continue
        record["busy"] = in_use(group, states, record, now)
        if record["busy"]:
            record["last_busy"] = now
            event(state, name, "left on after setup", "; ".join(record["busy"]))
            said.append(f"{group['title']} stays on: {'; '.join(record['busy'])}")
            continue
        try:
            stop_group(group, states)
        except Failed as e:
            said.append(str(e))
            continue
        state["groups"].pop(name, None)
        event(state, name, "stopped", "it was off before setup")
        said.append(f"{group['title']} is off again, as it was before setup")
    return said


def tick() -> int:
    with locked(wait=False) as mine:
        if not mine:
            return 0
        policy, state, now = load_policy(), load_state(), time.time()
        states = guest_states(policy)
        look(policy, state, states, now)
        if state.get("setup") and not held(state, now):
            for line in end_setup(policy, state, states, now):
                syslog.syslog(f"setup gave no end: {line}")
            states = guest_states(policy)
        if not held(state, now):
            for name, group in policy["groups"].items():
                record = state["groups"].get(name)
                if record is None or record.get("keep") or record["busy"] or group["stop"] == "manual":
                    continue
                idle = now - max(record["since"], record.get("last_busy", 0))
                if idle < group["idle_minutes"] * 60:
                    continue
                if group["stop"] == "ask":
                    record["asks"] = True
                    continue
                try:
                    stop_group(group, states)
                except Failed as e:
                    syslog.syslog(f"{name}: {e}")
                    continue
                del state["groups"][name]
                event(state, name, "stopped", f"not used for {group['idle_minutes']} min")
            states = guest_states(policy)
        state["ticked"] = int(now)
        save(STATE, json.dumps(state))
        write_metrics(policy, state, states, now)
    return 0


def answer(args: argparse.Namespace, data: dict, text: str) -> None:
    print(json.dumps(data) if args.json else text)


def find(policy: dict, name: str) -> dict:
    if name not in policy["groups"]:
        known = ", ".join(policy["groups"]) or "nothing"
        raise Failed(f"{name!r} does not run on demand; what does: {known}")
    return policy["groups"][name]


def room_for(policy: dict, state: dict, states: dict[int, str], name: str, agreed: list[str], now: float) -> tuple[list[str], dict | None]:
    """(what to stop first, None) when `name` can start, or ([], the answer
    that says what would have to stop)."""
    group = policy["groups"][name]
    need = 0 if group_state(group, states) == "partly" else group["memory_mib"]
    free = policy.get("headroom_mib", 0) - sum(takes(g, states) for g in policy["groups"].values())
    if need <= free:
        return [], None
    others = []
    for other, g in policy["groups"].items():
        if other == name or not takes(g, states):
            continue
        record = state["groups"].setdefault(other, {"since": now})
        busy = in_use(g, states, record, now)
        if held_by_setup(state, other, now):
            busy = ["a setup run is using it", *busy]
        idle = int(now - max(record["since"], record.get("last_busy", 0)))
        spare = g["stop"] == "auto" and not busy and not record.get("keep")
        others.append({"name": other, "title": g["title"], "memory_mib": g["memory_mib"], "busy": busy, "idle_s": idle, "auto": spare})
    for other in agreed:
        if other not in [o["name"] for o in others]:
            raise Failed(f"{other!r} is not running on demand, so stopping it frees nothing")
    # Those the caller agreed to; else those that may stop by themselves,
    # longest idle first.
    chosen = [o for o in others if o["name"] in agreed] if agreed else sorted((o for o in others if o["auto"]), key=lambda o: -o["idle_s"])
    picked, freed = [], 0
    for o in chosen:
        if free + freed >= need and not agreed:
            break
        picked.append(o["name"])
        freed += o["memory_mib"]
    if free + freed >= need:
        return picked, None
    # Not enough: say the fewest that would do, idle ones first.
    order = sorted(others, key=lambda o: (bool(o["busy"]), not o["auto"], -o["idle_s"]))
    suggest, freed = [], 0
    for o in order:
        if free + freed >= need:
            break
        suggest.append(o)
        freed += o["memory_mib"]
    return [], {
        "ok": False,
        "error": "no-room",
        "name": name,
        "title": group["title"],
        "need_mib": need,
        "free_mib": free,
        "stop": suggest,
        "enough": free + freed >= need,
    }


def cmd_start(args: argparse.Namespace) -> int:
    with locked():
        policy, state, now = load_policy(), load_state(), time.time()
        group = find(policy, args.name)
        states = guest_states(policy)
        current = group_state(group, states)
        if current == "missing":
            raise Failed(f"{group['title']} is not made yet; run setup")
        agreed = [n for n in (args.stop or "").split(",") if n]
        stopped: list[str] = []
        problems: list[str] = []
        if current != "on":
            victims, refusal = room_for(policy, state, states, args.name, agreed, now)
            if refusal:
                save(STATE, json.dumps(state))
                names = ", ".join(o["title"] for o in refusal["stop"])
                text = f"{group['title']} needs {refusal['need_mib']} MiB and {refusal['free_mib']} MiB is free"
                text += f"; stopping {names} would make room" if refusal["enough"] else "; it does not fit even alone"
                answer(args, refusal, text)
                return NO_ROOM
            for other in victims:
                stop_group(policy["groups"][other], states)
                state["groups"].pop(other, None)
                event(state, other, "stopped", f"to make room for {group['title']}")
                stopped.append(policy["groups"][other]["title"])
            states = guest_states(policy) if victims else states
            problems = start_group(policy, group, states)
            event(state, args.name, "started", f"by {args.by}")
        record = state["groups"].setdefault(args.name, {})
        record.setdefault("since", now)
        if current != "on":
            record["since"] = now
        record["by"] = "owner"
        if args.keep:
            record["keep"] = True
        save(STATE, json.dumps(state))
        write_metrics(policy, state, guest_states(policy), now)
    text = f"{group['title']} is on" if current == "on" else f"started {group['title']}"
    if stopped:
        text += f"; stopped {', '.join(stopped)} to make room"
    for problem in problems:
        text += f"\nwarning: {problem}"
    answer(args, {"ok": True, "name": args.name, "already": current == "on", "stopped": stopped, "warnings": problems}, text)
    return 0


def cmd_stop(args: argparse.Namespace) -> int:
    with locked():
        policy, state, now = load_policy(), load_state(), time.time()
        group = find(policy, args.name)
        states = guest_states(policy)
        current = group_state(group, states)
        if current in ("on", "partly"):
            stop_group(group, states)
            event(state, args.name, "stopped", f"by {args.by}")
        state["groups"].pop(args.name, None)
        save(STATE, json.dumps(state))
        write_metrics(policy, state, guest_states(policy), now)
    text = f"stopped {group['title']}" if current in ("on", "partly") else f"{group['title']} is off"
    answer(args, {"ok": True, "name": args.name, "already": current not in ("on", "partly")}, text)
    return 0


def cmd_keep(args: argparse.Namespace) -> int:
    with locked():
        policy, state = load_policy(), load_state()
        group = find(policy, args.name)
        if group_state(group, guest_states(policy)) not in ("on", "partly"):
            raise Failed(f"{group['title']} is off; start it first")
        record = state["groups"].setdefault(args.name, {"since": time.time()})
        if args.value == "on":
            record["keep"] = True
            record.pop("asks", None)
        else:
            record.pop("keep", None)
        save(STATE, json.dumps(state))
    answer(args, {"ok": True, "name": args.name, "keep": args.value == "on"}, f"{group['title']}: keep on is {args.value}")
    return 0


def cmd_status(args: argparse.Namespace) -> int:
    policy, state, now = load_policy(), load_state(), time.time()
    found = view(policy, state, guest_states(policy), now)
    if args.json:
        print(json.dumps(found))
        return 0
    if not found["groups"]:
        print("nothing runs on demand")
        return 0
    print(f"on demand: {found['used_mib']} of {found['headroom_mib']} MiB in use, {found['free_mib']} MiB free")
    for g in found["groups"]:
        line = f"{g['name']:<14} {g['state']:<8} {g['memory_mib']:>6} MiB  {g['title']}"
        if g["state"] in ("on", "partly"):
            if g["busy"]:
                line += f": {'; '.join(g['busy'])}"
            elif "stops_in_s" in g:
                line += f": idle {g['idle_s'] // 60} min, stops in {g['stops_in_s'] // 60} min"
            else:
                line += f": idle {g['idle_s'] // 60} min"
            line += ", kept on" if g["keep"] else ""
        print(line)
    return 0


def unpaged_vm_mib() -> int:
    """Memory running VMs were given and have not touched yet: MemAvailable
    still counts it as free, and the VMs will take it."""
    rc, out, _ = sh(["qm", "list"])
    total = 0
    for line in out.splitlines() if rc == 0 else []:
        fields = line.split()
        if len(fields) < 4 or not fields[0].isdigit() or fields[2] != "running" or not fields[3].isdigit():
            continue
        try:
            current = int((CGROUP / "qemu.slice" / f"{fields[0]}.scope" / "memory.current").read_text()) // (1024 * 1024)
        except (OSError, ValueError):
            continue
        total += max(0, int(fields[3]) - current)
    return total


def really_free_mib() -> int | None:
    try:
        meminfo = dict(line.split(":", 1) for line in MEMINFO.read_text().splitlines() if ":" in line)
        available = int(meminfo["MemAvailable"].split()[0]) // 1024
    except (OSError, ValueError, KeyError):
        return None
    return available - unpaged_vm_mib()


def begin_setup(policy: dict, state: dict, states: dict[int, str], now: float) -> None:
    if held(state, now):
        state["setup"]["until"] = now + HOLD_S
        return
    was_off = [name for name, group in policy["groups"].items() if group_state(group, states) in ("off", "missing")]
    state["setup"] = {"since": now, "until": now + HOLD_S, "was_off": was_off}


def cmd_setup(args: argparse.Namespace) -> int:
    with locked():
        policy, state, now = load_policy(), load_state(), time.time()
        states = guest_states(policy)
        if args.what == "begin":
            begin_setup(policy, state, states, now)
            said = []
        else:
            said = end_setup(policy, state, states, now)
            write_metrics(policy, state, guest_states(policy), now)
        save(STATE, json.dumps(state))
    for line in said:
        print(line)
    return 0


def cmd_ensure(args: argparse.Namespace) -> int:
    """Have these guests running together, for apply. Prints what changed."""
    said = []
    with locked():
        policy, state, now = load_policy(), load_state(), time.time()
        states = guest_states(policy)
        wanted = []
        for asked in args.guests:
            found = [(name, group, g) for name, group in policy["groups"].items() for g in switches(group) if g["name"] == asked]
            if not found:
                continue  # it always runs
            if guest_state(found[0][2], states) == "missing":
                raise Failed(f"{asked} is not made yet")
            wanted.append(found[0])
        if not wanted:
            return 0
        begin_setup(policy, state, states, now)
        todo = [(name, group, g) for name, group, g in wanted if guest_state(g, states) != "running"]
        new = {name: group for name, group, _ in todo if not takes(group, states)}
        need = sum(group["memory_mib"] for group in new.values())

        def free() -> int:
            return policy.get("headroom_mib", 0) - sum(takes(g, states) for g in policy["groups"].values())

        # What this setup run started, is done with and nobody took up makes
        # room first.
        for other, group in policy["groups"].items():
            record = state["groups"].get(other, {})
            if need <= free():
                break
            if other in {name for name, _, _ in wanted} or record.get("by") != "setup" or not takes(group, states):
                continue
            if in_use(group, states, record, now):
                continue
            stop_group(group, states)
            del state["groups"][other]
            event(state, other, "stopped", "setup needed the room")
            said.append(f"stopped {group['title']}")
            states = guest_states(policy)
        # Counted memory first; past it, what the host really has free: a
        # container takes its memory only as it uses it, and setup needs it
        # up for minutes.
        if need > free():
            real = really_free_mib()
            lacking = sum(g["memory_mib"] for _, _, g in todo)
            if real is not None and real - lacking < SPARE_MIB:
                names = " and ".join(g["name"] for _, _, g in todo)
                running = ", ".join(g["title"] for g in policy["groups"].values() if takes(g, states)) or "the guests that always run"
                save(STATE, json.dumps(state))
                it, its = ("it", "its") if len(todo) == 1 else ("them", "their")
                raise Failed(
                    f"setup has to start {names} to configure {it}, and the host has {max(real, 0)} MiB really free "
                    f"for {its} {lacking} MiB beside {running}; stop one of them on the page (Services) and run setup again"
                )
        for name, _, guest in todo:
            start_guest(guest)
            if guest["kind"] == "lxc":
                refresh_certs(policy, guest)  # apply's own ca stage reports one it could not renew
            state["groups"].setdefault(name, {"since": now, "by": "setup"})
            event(state, name, "started", f"{guest['name']}, for setup")
            said.append(f"started {guest['name']}")
        save(STATE, json.dumps(state))
    for line in said:
        print(line)
    return 0


def main() -> int:
    parser = argparse.ArgumentParser(prog="nb-power")
    sub = parser.add_subparsers(dest="command", required=True)
    status = sub.add_parser("status")
    status.add_argument("--json", action="store_true")
    start = sub.add_parser("start")
    start.add_argument("name")
    start.add_argument("--stop", default="")
    start.add_argument("--keep", action="store_true")
    stop = sub.add_parser("stop")
    stop.add_argument("name")
    keep = sub.add_parser("keep")
    keep.add_argument("name")
    keep.add_argument("value", choices=["on", "off"])
    for command in (start, stop, keep):
        command.add_argument("--json", action="store_true")
        command.add_argument("--by", default="the owner")
    sub.add_parser("tick")
    setup = sub.add_parser("setup")
    setup.add_argument("what", choices=["begin", "end"])
    ensure = sub.add_parser("ensure")
    ensure.add_argument("guests", nargs="+")
    args = parser.parse_args()
    syslog.openlog("nb-power")
    commands = {"status": cmd_status, "start": cmd_start, "stop": cmd_stop, "keep": cmd_keep, "setup": cmd_setup, "ensure": cmd_ensure}
    try:
        return tick() if args.command == "tick" else commands[args.command](args)
    except Failed as e:
        if getattr(args, "json", False):
            print(json.dumps({"ok": False, "error": str(e)}))
        else:
            print(f"nb-power: {e}", file=sys.stderr)
        return 1


if __name__ == "__main__":
    sys.exit(main())
