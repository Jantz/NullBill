#!/usr/bin/python3
"""Generated by nullbill. The KDE desktop's own helpers (docs/adr/0023-desktop.md).

nb-desktop password USER   the password on stdin becomes USER's, unless it
                           already is: prints `same` or `changed`
nb-desktop busy            why the desktop is in use, a line per reason
                           (nb-busy's busy.d): someone on Remote Desktop,
                           the screen at the server unlocked, updates
                           installing
nb-desktop metrics         the update metrics the monitoring role's alerts
                           read, as the updates role's nb-update-metrics
                           writes them on Debian
nb-desktop report USER     what verify reads, as JSON
"""

import ctypes
import glob
import json
import os
import pwd
import re
import subprocess
import sys
import tempfile
import time

SHADOW = "/etc/shadow"
PORT_FILE = "/etc/nullbill/desktop-port"
TEXTFILE = "/var/lib/prometheus/node-exporter"
STATE = "/var/lib/nullbill"
SINCE = f"{STATE}/updates-since"
OK = f"{STATE}/updates-ok"
TIMER = "dnf5-automatic.timer"
# dnf or rpm at work: a VM stopped under it comes back with half-installed packages.
UPDATING = re.compile(r"(^|[ /])(dnf5?|rpm|packagekitd)( |$)")


def crypt(password: str, setting: str) -> str:
    """libxcrypt's crypt(3), whichever method the shadow entry names
    (yescrypt on Fedora): Python has no crypt module any more."""
    lib = ctypes.CDLL("libcrypt.so.2")
    lib.crypt.restype = ctypes.c_char_p
    lib.crypt.argtypes = [ctypes.c_char_p, ctypes.c_char_p]
    out = lib.crypt(password.encode(), setting.encode())
    return out.decode() if out else ""


def cmd_password(user: str) -> int:
    password = sys.stdin.read().rstrip("\n")
    if not password or "\n" in password or ":" in user:
        print("nb-desktop: a password of one line is needed", file=sys.stderr)
        return 2
    with open(SHADOW) as f:
        entry = next((line.split(":") for line in f if line.split(":")[0] == user), None)
    if entry is None:
        print(f"nb-desktop: no user {user}", file=sys.stderr)
        return 2
    current = entry[1]
    if current.startswith("$") and crypt(password, current) == current:
        print("same")
        return 0
    subprocess.run(["chpasswd"], input=f"{user}:{password}\n", text=True, check=True)
    print("changed")
    return 0


def port() -> int:
    try:
        with open(PORT_FILE) as f:
            return int(f.read().strip())
    except (OSError, ValueError):
        return 3389


def remote() -> int:
    out = subprocess.run(["/usr/local/sbin/nb-busy", "connections", str(port())], capture_output=True, text=True, timeout=10, check=True)
    return int(out.stdout.strip() or 0)


def sessions() -> list[dict]:
    """logind's graphical sessions, with whether each is locked."""
    out = subprocess.run(["loginctl", "list-sessions", "--json=short"], capture_output=True, text=True, timeout=10, check=True)
    found = []
    for s in json.loads(out.stdout or "[]"):
        props = subprocess.run(
            ["loginctl", "show-session", str(s["session"]), "-p", "Type", "-p", "Name", "-p", "LockedHint", "-p", "Active", "-p", "Class"],
            capture_output=True,
            text=True,
            timeout=10,
        ).stdout
        info = dict(line.split("=", 1) for line in props.splitlines() if "=" in line)
        if info.get("Type") in ("wayland", "x11") and info.get("Class") == "user":
            found.append({"user": info.get("Name", ""), "locked": info.get("LockedHint") == "yes", "active": info.get("Active") == "yes"})
    return found


def cmd_busy() -> int:
    reasons = []
    n = remote()
    if n:
        reasons.append("someone is on Remote Desktop" if n == 1 else f"{n} Remote Desktop connections")
    if any(s["active"] and not s["locked"] for s in sessions()):
        reasons.append("the desktop is unlocked")
    ps = subprocess.run(["ps", "-eo", "args="], capture_output=True, text=True, timeout=10).stdout
    if any(UPDATING.search(line.strip()) for line in ps.splitlines()):
        reasons.append("updates are installing")
    for reason in reasons:
        print(reason)
    return 0


def mtime(path: str) -> float | None:
    try:
        return os.stat(path).st_mtime
    except OSError:
        return None


def cmd_metrics() -> int:
    """After each run of dnf5-automatic (its unit's ExecStopPost, where
    SERVICE_RESULT says how it went) and hourly."""
    os.makedirs(STATE, exist_ok=True)
    if os.environ.get("SERVICE_RESULT") == "success" and os.environ.get("EXIT_STATUS", "0") == "0":
        with open(OK, "w"):
            pass
        os.utime(OK)
    success = mtime(OK) or mtime(SINCE) or time.time()
    enabled = subprocess.run(["systemctl", "is-enabled", "--quiet", TIMER]).returncode == 0
    # Exit 1: a package the running kernel or a core library needs was updated.
    reboot = subprocess.run(["dnf5", "-C", "-q", "needs-restarting"], capture_output=True, timeout=120).returncode == 1
    text = (
        "# HELP nb_unattended_upgrade_success_timestamp_seconds When dnf5-automatic last installed updates without error.\n"
        "# TYPE nb_unattended_upgrade_success_timestamp_seconds gauge\n"
        f"nb_unattended_upgrade_success_timestamp_seconds {int(success)}\n"
        "# HELP nb_unattended_upgrade_enabled 1 while daily updates are switched on.\n"
        "# TYPE nb_unattended_upgrade_enabled gauge\n"
        f"nb_unattended_upgrade_enabled {int(enabled)}\n"
        "# HELP node_reboot_required 1 when installed updates wait for a restart.\n"
        "# TYPE node_reboot_required gauge\n"
        f"node_reboot_required {int(reboot)}\n"
    )
    fd, tmp = tempfile.mkstemp(dir=TEXTFILE, prefix=".nullbill-updates.")
    with os.fdopen(fd, "w") as f:
        f.write(text)
    os.chmod(tmp, 0o644)
    os.replace(tmp, os.path.join(TEXTFILE, "nullbill-updates.prom"))
    return 0


DRM = "/sys/class/drm"


def card_driver(card: str) -> str:
    """The driver that draws on a card. A virtual card's PCI device is
    virtio-pci's; virtio_gpu drives the virtio device under it."""
    device = f"{DRM}/{card}/device"
    names = [os.path.basename(os.readlink(f"{device}/driver"))] if os.path.islink(f"{device}/driver") else [""]
    if names[0] == "virtio-pci":
        under = sorted(glob.glob(f"{device}/virtio*/driver"))
        names = [os.path.basename(os.readlink(link)) for link in under if os.path.islink(link)]
    return names[0] if names else ""


def remote_desktop(user: str) -> tuple[bool, bool]:
    """(the user's own program listens on the port, anything does).
    Through the guest agent, SELinux keeps the user's processes out of
    sight (pgrep found no krdpserver while it ran); the socket's owner,
    from the kernel's own answer to ss, is the user's KRDP."""
    listening = subprocess.run(["ss", "-Hltne", f"sport = :{port()}"], capture_output=True, text=True, timeout=10).stdout
    return f"uid:{pwd.getpwnam(user).pw_uid} " in listening, bool(listening.strip())


def cmd_report(user: str) -> int:
    """For verify: the session, Remote Desktop and the graphics."""
    found = sessions()
    krdp, listening = remote_desktop(user)
    drivers = {card: card_driver(card) for card in sorted(os.listdir(DRM)) if re.fullmatch(r"card\d+", card)} if os.path.isdir(DRM) else {}
    print(
        json.dumps(
            {
                "session": any(s["user"] == user for s in found),
                "locked": any(s["user"] == user and s["locked"] for s in found),
                "krdp": krdp,
                "listening": listening,
                "drivers": drivers,
            }
        )
    )
    return 0


def main(argv: list[str]) -> int:
    if argv[:1] == ["password"] and len(argv) == 2:
        return cmd_password(argv[1])
    if argv == ["busy"]:
        return cmd_busy()
    if argv == ["metrics"]:
        return cmd_metrics()
    if argv[:1] == ["report"] and len(argv) == 2:
        return cmd_report(argv[1])
    print(__doc__.split("\n\n", 1)[1], file=sys.stderr)
    return 2


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
