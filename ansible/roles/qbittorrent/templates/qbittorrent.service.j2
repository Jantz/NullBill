# Generated by nullbill.
[Unit]
Description=qBittorrent, the download client
After=network-online.target{% if qbittorrent_route == "vpn" %} nb-tunnel.service{% endif %}

Wants=network-online.target
{% if qbittorrent_route == "vpn" %}
# No tunnel, no client: it stops when the tunnel's unit does.
Requires=nb-tunnel.service
{% endif %}
# Without the kept disk the folder is an empty directory in this guest,
# and downloads would fill the guest's own disk.
ConditionPathIsMountPoint={{ qbittorrent_store }}

[Service]
User=qbt
Group=qbt
ExecStart=/usr/bin/qbittorrent-nox --profile=/var/lib/qbittorrent
Restart=on-failure
RestartSec=5
# It writes what it holds in memory before it ends.
TimeoutStopSec=90
NoNewPrivileges=yes
{% if qbittorrent_route == "vpn" %}
# Names are looked up at the VPN's own DNS servers, through the tunnel,
# and never at the home's.
BindReadOnlyPaths=/etc/nullbill/torrents-resolv.conf:/etc/resolv.conf
{% endif %}

[Install]
WantedBy=multi-user.target
