#!/usr/bin/env python3
"""Generated by nullbill. qBittorrent in this guest, for apply, verify, its
own systemd units and the owner (docs/adr/0020-download-client.md).

    nb-torrents first-config      write qBittorrent's settings before its first start
    nb-torrents wait [SECONDS]    until qBittorrent answers (default 120)
    nb-torrents settings          set what NullBill decides; prints changed or same
    nb-torrents busy              why this guest is in use, or nothing when it is not
    nb-torrents tick              pause or resume for room on the disk, write metrics
    nb-torrents space             room, or why downloads are paused
    nb-torrents paths             inside, or a line per download that is saved outside
                                  the downloads folder or that qBittorrent could not move
    nb-torrents reached           connected once another peer has connected to this
                                  client from outside, else what qBittorrent says
    nb-torrents tunnel up         the VPN: interface, address, and the routes that send
                                  the client's user through it and nowhere else
    nb-torrents tunnel down       take the interface away; the client's user then
                                  reaches nothing outside NullBill
    nb-torrents tunnel off        no VPN any more: interface, rules and routes gone
    nb-torrents tunnel status     up, or down with why
    nb-torrents tunnel through IP the client's user reaches IP through the tunnel
                                  and root does not reach it at all
    nb-torrents tunnel drop IP    take the tunnel down for a moment: the client's
                                  user must not reach IP; prints stopped or leaked

/etc/nullbill/torrents.json, written by the qbittorrent role, says where
files go, how much room to keep and which way traffic leaves.
"""

import base64
import hashlib
import hmac
import json
import os
import pwd
import re
import secrets
import subprocess
import sys
import tempfile
import time
import urllib.error
import urllib.parse
import urllib.request
from pathlib import Path

CONFIG = Path("/etc/nullbill/torrents.json")
PASSWORD = Path("/etc/nullbill/torrents-password")
WG_CONF = Path("/etc/nullbill/wg0.conf")
PROFILE = Path("/var/lib/qbittorrent")
QBT_CONF = PROFILE / "qBittorrent/config/qBittorrent.conf"
STATE = Path("/var/lib/nullbill")
# The downloads this script paused for room, to resume those and no others.
PAUSED = STATE / "torrents-paused.json"
# A digest of the password the client's page has now.
PASSWORD_SET = STATE / "torrents-password.mark"
# Where in qBittorrent's log this script has read to, and the last
# download it said it could not move.
LOG_READ = STATE / "torrents-log.json"
# qBittorrent's words (sessionimpl.cpp) when a finished download cannot be
# moved to where it is to be saved: mostly a folder its user cannot make.
MOVE_FAILED = "Failed to move torrent"
# A failed move is told for this long; qBittorrent does not try again.
MOVE_TOLD_S = 24 * 3600
# A failed move that no folder explains is told this long, as its alert is.
MOVE_RECENT_S = 3600
MOVE_LINE = re.compile(r'Torrent: "(?P<torrent>.*)"\. Source: ".*"\. Destination: "(?P<to>.*?)"\. Reason: "?(?P<reason>.*)')
NAME_CHARS = 60
TEXTFILES = Path("/var/lib/prometheus/node-exporter")
NB_BUSY = "/usr/local/sbin/nb-busy"
# The routing table of the client's user, and the rules that send it there.
TABLE = "51820"
PREF_LOCAL, PREF_USER = "100", "110"
GIB = 2**30
TIMEOUT_S = 10
# qBittorrent's names for a download that is still fetching or waiting to,
# and for a finished one that is uploading or waiting to.
DOWNLOADING = {"downloading", "metaDL", "forcedMetaDL", "forcedDL", "stalledDL", "queuedDL", "checkingDL", "allocating"}
WORKING = DOWNLOADING | {"checkingResumeData", "moving", "checkingUP"}
SEEDING = {"uploading", "stalledUP", "forcedUP", "queuedUP"}


class NotAnswering(Exception):
    pass


def config() -> dict:
    return json.loads(CONFIG.read_text())


def api(cfg: dict, path: str, data: dict | None = None) -> bytes:
    """qBittorrent's Web API from this guest itself, which it trusts
    without a sign-in (bypass_local_auth); everyone else signs in."""
    url = f"http://127.0.0.1:{cfg['port']}/api/v2/{path}"
    body = urllib.parse.urlencode(data).encode() if data is not None else None
    try:
        with urllib.request.urlopen(urllib.request.Request(url, data=body), timeout=TIMEOUT_S) as answer:
            return answer.read()
    except (OSError, urllib.error.URLError) as exc:
        raise NotAnswering(str(getattr(exc, "reason", exc))) from exc


def torrents(cfg: dict) -> list[dict]:
    return json.loads(api(cfg, "torrents/info"))


def as_client(cfg: dict, argv: list[str], timeout: int = 15) -> subprocess.CompletedProcess:
    user = pwd.getpwnam(cfg["user"])
    return subprocess.run(argv, user=user.pw_uid, group=user.pw_gid, extra_groups=[], capture_output=True, text=True, timeout=timeout)


def write_private(path: Path, text: str, uid: int = 0, gid: int = 0) -> None:
    path.parent.mkdir(parents=True, exist_ok=True)
    fd, tmp = tempfile.mkstemp(dir=path.parent)
    with os.fdopen(fd, "w") as f:
        f.write(text)
    os.chmod(tmp, 0o600)
    os.chown(tmp, uid, gid)
    os.replace(tmp, path)


def password_hash(password: str) -> str:
    """As qBittorrent stores its page's password: PBKDF2 with SHA-512,
    100000 rounds, a 16-byte salt and a 64-byte key, both in base64."""
    salt = secrets.token_bytes(16)
    key = hashlib.pbkdf2_hmac("sha512", password.encode(), salt, 100000, 64)
    return f"@ByteArray({base64.b64encode(salt).decode()}:{base64.b64encode(key).decode()})"


def digest(password: str, salt: str = "") -> str:
    """The mark of which password the page has: salt and PBKDF2 key in hex."""
    salt = salt or secrets.token_hex(16)
    return f"{salt}:{hashlib.pbkdf2_hmac('sha512', password.encode(), bytes.fromhex(salt), 100000).hex()}"


def marked(password: str) -> bool:
    """Is this the password the mark was made for?"""
    try:
        mark = PASSWORD_SET.read_text().strip()
        return hmac.compare_digest(mark, digest(password, mark.partition(":")[0]))
    except (OSError, ValueError):
        return False


def interface(cfg: dict) -> str:
    return cfg["tunnel"]["interface"] if cfg["route"] == "vpn" else ""


def first_config(cfg: dict) -> int:
    """Before qBittorrent first starts: its page's sign-in, since a new
    qBittorrent of this version would take a well-known password; where
    files go; and the one interface it may send on. Never rewrites a file
    qBittorrent has made its own (settings does the rest through its API)."""
    if QBT_CONF.exists():
        print("same")
        return 0
    password = PASSWORD.read_text().strip()
    store = cfg["store"]
    lines = [
        "[BitTorrent]",
        f"Session\\DefaultSavePath={store}",
        f"Session\\TempPath={store}/incomplete",
        "Session\\TempPathEnabled=true",
        f"Session\\Port={cfg['listen_port']}",
        *([f"Session\\Interface={interface(cfg)}", f"Session\\InterfaceName={interface(cfg)}"] if interface(cfg) else []),
        "",
        "[LegalNotice]",
        "Accepted=true",
        "",
        "[Network]",
        "PortForwardingEnabled=false",
        "",
        "[Preferences]",
        "WebUI\\Address=*",
        f"WebUI\\Port={cfg['port']}",
        "WebUI\\LocalHostAuth=false",
        f"WebUI\\Username={cfg['username']}",
        f'WebUI\\Password_PBKDF2="{password_hash(password)}"',
        "",
        # Feeds and their download rules work from the start; the owner
        # may switch them off again, and settings leaves that alone.
        "[RSS]",
        "Session\\EnableProcessing=true",
        "AutoDownloader\\EnableProcessing=true",
        "",
    ]
    user = pwd.getpwnam(cfg["user"])
    for directory in (PROFILE / "qBittorrent", QBT_CONF.parent):
        directory.mkdir(mode=0o750, exist_ok=True)
        os.chown(directory, user.pw_uid, user.pw_gid)
    write_private(QBT_CONF, "\n".join(lines), user.pw_uid, user.pw_gid)
    write_private(PASSWORD_SET, digest(password) + "\n")
    print("changed")
    return 0


def wait(cfg: dict, seconds: int) -> int:
    deadline = time.monotonic() + seconds
    why = ""
    while time.monotonic() < deadline:
        try:
            api(cfg, "app/version")
            return 0
        except NotAnswering as exc:
            why = str(exc)
            time.sleep(1)
    print(f"nb-torrents: qBittorrent did not answer within {seconds} s ({why})", file=sys.stderr)
    return 1


def settings(cfg: dict) -> int:
    store = cfg["store"]
    want = {
        "save_path": store,
        "temp_path": f"{store}/incomplete",
        "temp_path_enabled": True,
        # Nothing here answers UPnP, and behind a VPN nothing may be asked.
        "upnp": False,
        # The one port both firewall layers pass on from home.
        "listen_port": cfg["listen_port"],
        "random_port": False,
        "web_ui_upnp": False,
        "current_network_interface": interface(cfg),
        "current_interface_address": "",
        "bypass_local_auth": True,
        "web_ui_username": cfg["username"],
        "web_ui_port": cfg["port"],
    }
    have = json.loads(api(cfg, "app/preferences"))
    change = {key: value for key, value in want.items() if have.get(key) != value}
    password = PASSWORD.read_text().strip()
    if not marked(password):
        change["web_ui_password"] = password
    # Jellyfin passes over a folder that holds a file named .ignore.
    marker = f"{store}/incomplete/.ignore"
    made = False
    if not os.path.exists(marker):
        done = as_client(cfg, ["sh", "-c", 'mkdir -p "$1" && : > "$1/.ignore"', "sh", f"{store}/incomplete"])
        if done.returncode != 0:
            print(f"nb-torrents: cannot write to {store}: {done.stderr.strip()[:200]}", file=sys.stderr)
            return 1
        made = True
    if change:
        api(cfg, "app/setPreferences", {"json": json.dumps(change)})
        write_private(PASSWORD_SET, digest(password) + "\n")
    print("changed" if change or made else "same")
    return 0


def count(n: int, one: str, many: str) -> str:
    return f"1 {one}" if n == 1 else f"{n} {many}"


def busy(cfg: dict) -> int:
    """A line per reason this guest is in use. A client that does not
    answer counts as one: a guest is not stopped because it could not be
    asked."""
    try:
        states = [t["state"] for t in torrents(cfg)]
    except (NotAnswering, ValueError) as exc:
        print(f"cannot ask qBittorrent what it is doing ({exc})")
        return 0
    down = sum(1 for s in states if s in WORKING)
    up = sum(1 for s in states if s in SEEDING)
    if down:
        print(count(down, "download in progress", "downloads in progress"))
    if up:
        print(count(up, "finished download is being shared", "finished downloads are being shared"))
    try:
        done = subprocess.run([NB_BUSY, "connections", str(cfg["port"])], capture_output=True, text=True, timeout=TIMEOUT_S)
        if done.returncode == 0 and done.stdout.strip().isdigit() and int(done.stdout) > 0:
            print("its page is open in a browser")
    except (OSError, subprocess.TimeoutExpired):
        pass
    return 0


def paused() -> list[str]:
    try:
        return list(json.loads(PAUSED.read_text())["hashes"])
    except (OSError, ValueError, KeyError):
        return []


def free_bytes(cfg: dict) -> int | None:
    """Room on the disk the downloads go to; None while it is not mounted,
    when the folder is only an empty directory in this guest."""
    if not os.path.ismount(cfg["store"]):
        return None
    found = os.statvfs(cfg["store"])
    return found.f_bavail * found.f_frsize


def guard(cfg: dict, free: int | None) -> None:
    """Pause what downloads while the disk has less free than the owner
    keeps, and resume exactly those once it has that and a tenth more."""
    if free is None:
        return
    floor = cfg["keep_free_gib"] * GIB
    held = paused()
    if free < floor:
        active = [t["hash"] for t in torrents(cfg) if t["state"] in DOWNLOADING]
        if active:
            api(cfg, "torrents/pause", {"hashes": "|".join(active)})
            write_private(PAUSED, json.dumps({"hashes": sorted({*held, *active})}) + "\n")
    elif held and free >= floor + max(GIB, floor // 10):
        still = {t["hash"] for t in torrents(cfg) if t["state"] == "pausedDL"}
        resume = [h for h in held if h in still]
        if resume:
            api(cfg, "torrents/resume", {"hashes": "|".join(resume)})
        PAUSED.unlink(missing_ok=True)


def inside(path: str, store: str) -> bool:
    found = os.path.normpath(path)
    return found == store or found.startswith(store + "/")


def outside(cfg: dict) -> list[tuple[str, str]]:
    """(what, folder) for every download, and every category new downloads
    may take their folder from, that is saved outside the downloads folder:
    the client's user can write nowhere else in this guest, so such a
    download fetches into incomplete and stays there."""
    store = cfg["store"]
    found = []
    for t in torrents(cfg):
        for place in (t.get("save_path"), t.get("download_path")):
            if place and not inside(place, store):
                found.append((f'"{short(t.get("name") or t["hash"])}"', os.path.normpath(place)))
                break
    for name, category in sorted(json.loads(api(cfg, "torrents/categories")).items()):
        place = category.get("savePath") or ""
        # A folder without a leading slash lies under the downloads folder.
        if place.startswith("/") and not inside(place, store):
            found.append((f"the category {short(name)}", os.path.normpath(place)))
    return found


def log_read() -> dict:
    try:
        found = json.loads(LOG_READ.read_text())
    except (OSError, ValueError):
        return {}
    return found if isinstance(found, dict) else {}


def read_log(cfg: dict) -> dict:
    """Read what qBittorrent logged since the last call and keep the newest
    failed move ({"at", "message"} under "failed"). Its log starts again
    from 0 with qBittorrent, so the line read last is asked for again: when
    it is not the same line, the log is read from its start."""
    state = log_read()
    last, stamp = state.get("last", -1), state.get("stamp")

    def since(known: int) -> list[dict]:
        lines = json.loads(api(cfg, f"log/main?normal=true&info=true&warning=true&critical=true&last_known_id={known}"))
        return sorted((x for x in lines if isinstance(x, dict) and "id" in x), key=lambda x: x["id"])

    lines = since(last - 1) if last >= 0 else since(-1)
    if last >= 0:
        if lines and lines[0]["id"] == last and lines[0].get("timestamp") == stamp:
            lines = lines[1:]
        else:
            lines = since(-1)
    for line in lines:
        if MOVE_FAILED in str(line.get("message", "")):
            state["failed"] = {"at": int(line.get("timestamp") or time.time()), "message": str(line["message"])[:400]}
    if lines:
        state["last"], state["stamp"] = lines[-1]["id"], lines[-1].get("timestamp")
        write_private(LOG_READ, json.dumps(state) + "\n")
    return state


def failed_move(state: dict) -> dict | None:
    failed = state.get("failed")
    return failed if isinstance(failed, dict) and time.time() - failed.get("at", 0) < MOVE_TOLD_S else None


def short(name: str) -> str:
    """A download's name for one line of a check: no "; " (the page breaks
    a check's lines there) and no longer than a line takes."""
    name = " ".join(str(name).replace(";", ",").split())
    return name if len(name) <= NAME_CHARS else name[: NAME_CHARS - 1].rstrip() + "…"


def move_parts(message: str) -> dict | None:
    """qBittorrent's failed-move line taken apart: torrent, destination and
    the last words of its reason ("Permission denied")."""
    found = MOVE_LINE.search(message)
    if not found:
        return None
    reason = found["reason"].rstrip('". ').rsplit(". ", 1)[-1].rsplit(": ", 1)[-1]
    return {"torrent": found["torrent"], "to": os.path.normpath(found["to"]), "reason": reason}


def still_true(failed: dict, store: str, away: list[tuple[str, str]]) -> bool:
    """Whether a failed move is still worth telling. One to a folder outside
    the downloads folder is over once nothing is saved there any more (the
    owner set another location, or removed the download); any other counts
    for MOVE_RECENT_S, as its alert does."""
    parts = move_parts(failed["message"])
    if parts and not inside(parts["to"], store):
        return any(place == parts["to"] for _, place in away)
    return time.time() - failed["at"] < MOVE_RECENT_S


def paths(cfg: dict) -> int:
    """One short line per thing that is wrong now, or "inside"."""
    store = cfg["store"]
    away = outside(cfg)
    said = [f"{what} is set to save to {place}, outside {store}" for what, place in away]
    failed = failed_move(read_log(cfg))
    if failed and still_true(failed, store, away):
        when = time.strftime("%H:%M on %d %b", time.localtime(failed["at"]))
        parts = move_parts(failed["message"])
        if parts:
            said.append(f'at {when} qBittorrent could not move "{short(parts["torrent"])}" to {parts["to"]}: {short(parts["reason"])}')
        else:
            said.append(f"at {when} qBittorrent logged: {short(failed['message'])}")
    print("\n".join(said) if said else "inside")
    return 0


def reached(cfg: dict) -> int:
    """qBittorrent's own word on whether anyone got in: connected once a
    peer connected to it from outside, firewalled while none has."""
    print(json.loads(api(cfg, "transfer/info")).get("connection_status") or "unknown")
    return 0


def handshake_age(cfg: dict) -> float | None:
    """Seconds since the tunnel's last handshake; None when there was none."""
    ask = ["wg", "show", cfg["tunnel"]["interface"], "latest-handshakes"]
    done = subprocess.run(ask, capture_output=True, text=True, timeout=TIMEOUT_S)
    stamps = [int(line.split()[-1]) for line in done.stdout.splitlines() if line.split() and line.split()[-1].isdigit()]
    if done.returncode != 0 or not stamps or max(stamps) == 0:
        return None
    return time.time() - max(stamps)


def tunnel_up(cfg: dict) -> bool:
    age = handshake_age(cfg)
    return age is not None and age < cfg["tunnel"]["handshake_s"]


def tick(cfg: dict) -> int:
    lines = []
    free = free_bytes(cfg)
    try:
        guard(cfg, free)
        states = [t["state"] for t in torrents(cfg)]
        away, failed = outside(cfg), failed_move(read_log(cfg))
        lines += [
            "nb_torrents_up 1",
            f"nb_torrents_downloading {sum(1 for s in states if s in WORKING)}",
            f"nb_torrents_seeding {sum(1 for s in states if s in SEEDING)}",
            f"nb_torrents_outside_store {len(away)}",
            # 0 once a failed move is put right, so its alert ends with it.
            f"nb_torrents_move_failed_timestamp_seconds {failed['at'] if failed and still_true(failed, cfg['store'], away) else 0}",
        ]
    except (NotAnswering, ValueError):
        lines.append("nb_torrents_up 0")
    lines.append(f"nb_torrents_store_mounted {0 if free is None else 1}")
    if free is not None:
        lines.append(f"nb_torrents_free_bytes {free}")
    lines.append(f"nb_torrents_keep_free_bytes {cfg['keep_free_gib'] * GIB}")
    lines.append(f"nb_torrents_paused_for_space {1 if paused() else 0}")
    if cfg["route"] == "vpn":
        lines.append(f"nb_torrents_tunnel_up {1 if tunnel_up(cfg) else 0}")
    TEXTFILES.mkdir(parents=True, exist_ok=True)
    fd, tmp = tempfile.mkstemp(dir=TEXTFILES)
    with os.fdopen(fd, "w") as f:
        f.write("# Generated by nb-torrents.\n" + "\n".join(lines) + "\n")
    os.chmod(tmp, 0o644)
    os.replace(tmp, TEXTFILES / "torrents.prom")
    return 0


def space(cfg: dict) -> int:
    held = paused()
    if not held:
        print("room")
        return 0
    free = free_bytes(cfg)
    have = "the disk is not there" if free is None else f"{free / GIB:.1f} GiB free on the disk"
    what = count(len(held), "download is paused", "downloads are paused")
    print(f"{what}: {have}, and {cfg['keep_free_gib']} GiB are kept free; free some room, or keep less under Setup, What to run")
    return 0


def ip(*argv: str, check: bool = True) -> subprocess.CompletedProcess:
    done = subprocess.run(["ip", *argv], capture_output=True, text=True, timeout=TIMEOUT_S)
    if check and done.returncode != 0:
        raise RuntimeError(f"ip {' '.join(argv)}: {done.stderr.strip()}")
    return done


def rules(cfg: dict) -> None:
    """What the client's user sends goes by its own routing table, whose
    only way out is the tunnel and which says unreachable without it.
    NullBill's own network stays on the guest's ordinary routes: the page
    answers its visitors there. Set before the tunnel exists, and left in
    place when it goes."""
    uid = pwd.getpwnam(cfg["user"]).pw_uid
    wanted = {
        PREF_LOCAL: ["to", cfg["base"], "lookup", "main"],
        PREF_USER: ["uidrange", f"{uid}-{uid}", "lookup", TABLE],
    }
    for pref, rule in wanted.items():
        if not ip("rule", "show", "pref", pref).stdout.strip():
            ip("rule", "add", "pref", pref, *rule)
    ip("route", "replace", "unreachable", "default", "metric", "1000", "table", TABLE)


def up(cfg: dict) -> int:
    tunnel = cfg["tunnel"]
    name = tunnel["interface"]
    rules(cfg)
    if ip("link", "show", name, check=False).returncode != 0:
        ip("link", "add", name, "type", "wireguard")
    done = subprocess.run(["wg", "setconf", name, str(WG_CONF)], capture_output=True, text=True, timeout=TIMEOUT_S)
    if done.returncode != 0:
        raise RuntimeError(f"wg setconf: {done.stderr.strip()}")
    ip("-4", "address", "replace", tunnel["address"], "dev", name)
    ip("link", "set", name, "mtu", str(tunnel["mtu"]), "up")
    # Answers come in on the tunnel from addresses the ordinary routes
    # would send out the other way: a strict reverse-path check drops them.
    try:
        Path(f"/proc/sys/net/ipv4/conf/{name}/rp_filter").write_text("2\n")
    except OSError:
        pass
    ip("route", "replace", "default", "dev", name, "metric", "10", "table", TABLE)
    return 0


def down(cfg: dict) -> int:
    ip("link", "del", cfg.get("tunnel", {}).get("interface", "wg0"), check=False)
    return 0


def off(cfg: dict) -> int:
    down(cfg)
    for pref in (PREF_LOCAL, PREF_USER):
        while ip("rule", "show", "pref", pref).stdout.strip():
            ip("rule", "del", "pref", pref)
    ip("route", "flush", "table", TABLE, check=False)
    return 0


CONNECT = "import socket, sys; socket.create_connection((sys.argv[1], 443), int(sys.argv[2])).close()"


def reaches(cfg: dict, address: str, client: bool, seconds: int = 4) -> bool:
    argv = [sys.executable, "-c", CONNECT, address, str(seconds)]
    try:
        done = as_client(cfg, argv) if client else subprocess.run(argv, capture_output=True, text=True, timeout=15)
    except subprocess.TimeoutExpired:
        return False
    return done.returncode == 0


def route_of(cfg: dict, address: str) -> str:
    uid = pwd.getpwnam(cfg["user"]).pw_uid
    done = ip("-4", "route", "get", address, "uid", str(uid), check=False)
    return (done.stdout.strip() or done.stderr.strip()).splitlines()[0] if (done.stdout or done.stderr).strip() else ""


def through(cfg: dict, address: str) -> int:
    name = cfg["tunnel"]["interface"]
    way = route_of(cfg, address)
    if f" dev {name} " not in f"{way} ":
        print(f"the client's user is not routed through the tunnel: {way or 'no route'}")
    elif not reaches(cfg, address, client=True):
        print(f"the client's user cannot reach {address} through the tunnel")
    elif reaches(cfg, address, client=False):
        print(f"this guest reaches {address} outside the tunnel")
    else:
        print("through the tunnel only")
    return 0


def drop(cfg: dict, address: str) -> int:
    """The proof that a dropped tunnel stops the client: the interface goes
    down, which takes its routes with it; the client's user then has to be
    refused, by its routes here and by both firewalls behind them. The
    tunnel comes back whatever was found."""
    name = cfg["tunnel"]["interface"]
    try:
        ip("link", "set", name, "down")
        leaked = reaches(cfg, address, client=True)
        way = route_of(cfg, address)
    finally:
        up(cfg)
    if leaked:
        print(f"leaked: with the tunnel down the client's user reached {address} ({way})")
    else:
        print("stopped")
    return 0


def status(cfg: dict) -> int:
    name = cfg["tunnel"]["interface"]
    if ip("link", "show", name, check=False).returncode != 0:
        print("down: there is no tunnel interface; is nb-tunnel.service running?")
        return 0
    age = handshake_age(cfg)
    if age is None:
        server = cfg["tunnel"]["endpoint"]
        print(f"down: the VPN's server at {server} has not answered; is the WireGuard file still valid with your provider?")
    elif age >= cfg["tunnel"]["handshake_s"]:
        print(f"down: no answer from the VPN's server at {cfg['tunnel']['endpoint']} for {int(age)} s")
    else:
        print("up")
    return 0


USAGE = "usage: nb-torrents first-config | wait [SECONDS] | settings | busy | tick | space | paths | reached | tunnel ..."


def main(argv: list[str]) -> int:
    if not argv:
        print(USAGE, file=sys.stderr)
        return 2
    command, rest = argv[0], argv[1:]
    cfg = config()
    try:
        if command == "first-config":
            return first_config(cfg)
        if command == "wait":
            return wait(cfg, int(rest[0]) if rest else 120)
        if command == "settings":
            return settings(cfg)
        if command == "busy":
            return busy(cfg)
        if command == "tick":
            return tick(cfg)
        if command == "space":
            return space(cfg)
        if command == "paths":
            return paths(cfg)
        if command == "reached":
            return reached(cfg)
        if command == "tunnel" and rest and rest[0] == "off":
            return off(cfg)
        if command == "tunnel" and rest and cfg["route"] != "vpn":
            print("nb-torrents: this client does not go through a VPN", file=sys.stderr)
            return 1
        if command == "tunnel" and rest[:1] == ["up"]:
            return up(cfg)
        if command == "tunnel" and rest[:1] == ["down"]:
            return down(cfg)
        if command == "tunnel" and rest[:1] == ["status"]:
            return status(cfg)
        if command == "tunnel" and len(rest) == 2 and rest[0] == "through":
            return through(cfg, rest[1])
        if command == "tunnel" and len(rest) == 2 and rest[0] == "drop":
            return drop(cfg, rest[1])
    except (NotAnswering, RuntimeError, ValueError) as exc:
        print(f"nb-torrents: {exc}", file=sys.stderr)
        return 1
    print(USAGE, file=sys.stderr)
    return 2


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
