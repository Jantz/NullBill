; Generated by nullbill.
APP_NAME = Forgejo
RUN_USER = git
RUN_MODE = prod
WORK_PATH = /var/lib/forgejo

[server]
PROTOCOL = http
HTTP_ADDR = 127.0.0.1
HTTP_PORT = 3000
DOMAIN = {{ forgejo_domain }}
ROOT_URL = https://{{ forgejo_domain }}/
APP_DATA_PATH = /var/lib/forgejo/data
START_SSH_SERVER = true
BUILTIN_SSH_SERVER_USER = git
SSH_DOMAIN = {{ forgejo_domain }}
SSH_PORT = {{ forgejo_ssh_port }}
SSH_LISTEN_PORT = {{ forgejo_ssh_port }}
LFS_START_SERVER = true
LFS_JWT_SECRET_URI = file:/etc/forgejo/secrets/lfs_jwt_secret
; No avatars or other assets fetched from the internet.
OFFLINE_MODE = true

[database]
DB_TYPE = postgres
HOST = {{ forgejo_db_host }}:5432
NAME = {{ forgejo_db_name }}
USER = {{ forgejo_db_user }}
PASSWD = `{{ forgejo_db_password }}`
SSL_MODE = verify-full

[security]
INSTALL_LOCK = true
SECRET_KEY_URI = file:/etc/forgejo/secrets/secret_key
INTERNAL_TOKEN_URI = file:/etc/forgejo/secrets/internal_token

[oauth2]
JWT_SECRET_URI = file:/etc/forgejo/secrets/jwt_secret

[service]
; Accounts are made by the owner; nobody signs up, and nothing is public.
DISABLE_REGISTRATION = true
REQUIRE_SIGNIN_VIEW = true
DEFAULT_KEEP_EMAIL_PRIVATE = true

[session]
COOKIE_SECURE = true

[repository]
ROOT = /var/lib/forgejo/repositories

[log]
; To the journal, where the log shipper can read it.
MODE = console
LEVEL = Info

[actions]
ENABLED = true

[mailer]
ENABLED = false

[cron.update_checker]
ENABLED = false
