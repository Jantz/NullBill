#!/usr/bin/python3
"""Generated by nullbill. The owner's own Forgejo user, as apply's forgejo
stage keeps it, through Forgejo's API on 127.0.0.1.

  nb-forgejo-owner USER EMAIL < keys

Makes USER, an administrator, when Forgejo has no user of that name: its
random password is written once to PASSWORD_FILE (root only) and needs no
change at the first sign-in. Then the SSH keys NullBill gave USER (titled
"nullbill: ...") become the public keys on stdin, one per line: missing ones
are added, ones no longer listed deleted. Keys the owner added in Forgejo
stay. Prints a line per key Forgejo refused, then "changed" or "same".

The API calls use an administrator token of nullbill-admin, made once and
kept in TOKEN_FILE (root only; nb-forgejo can mint one anyway), acting as
USER through Forgejo's Sudo header.
"""

import json
import os
import re
import subprocess
import sys
import time
import urllib.error
import urllib.parse
import urllib.request

URL = "http://127.0.0.1:3000"
ADMIN = "nullbill-admin"
PASSWORD_FILE = "/etc/forgejo/owner-password"
TOKEN_FILE = "/etc/forgejo/nullbill-token"
TITLE = "nullbill: "
# Never through a proxy: this is Forgejo on the same guest.
OPENER = urllib.request.build_opener(urllib.request.ProxyHandler({}))


class Refused(Exception):
    def __init__(self, code: int, message: str):
        super().__init__(message)
        self.code = code


def die(message: str) -> None:
    print(f"nb-forgejo-owner: {message}", file=sys.stderr)
    sys.exit(1)


def call(method: str, path: str, token: str, body: object = None, sudo: str | None = None) -> object:
    headers = {"Authorization": f"token {token}", "Accept": "application/json"}
    if sudo:
        headers["Sudo"] = sudo
    data = None
    if body is not None:
        data = json.dumps(body).encode()
        headers["Content-Type"] = "application/json"
    request = urllib.request.Request(URL + path, data=data, headers=headers, method=method)
    try:
        with OPENER.open(request, timeout=30) as response:
            text = response.read()
    except urllib.error.HTTPError as err:
        try:
            message = json.loads(err.read() or b"{}").get("message", "")
        except ValueError:
            message = ""
        raise Refused(err.code, message or f"{method} {path}: {err.code}") from err
    return json.loads(text) if text else None


def forgejo(*args: str) -> str:
    out = subprocess.run(["/usr/local/sbin/nb-forgejo", *args], capture_output=True, text=True, check=False)
    if out.returncode != 0:
        die(f"forgejo {args[0]} {args[1] if len(args) > 1 else ''}: {(out.stderr or out.stdout).strip()[-300:]}")
    return out.stdout


def write_secret(path: str, value: str) -> None:
    fd = os.open(path + ".tmp", os.O_WRONLY | os.O_CREAT | os.O_TRUNC, 0o600)
    with os.fdopen(fd, "w") as f:
        f.write(value + "\n")
    os.replace(path + ".tmp", path)


def wait() -> None:
    deadline = time.monotonic() + 120
    while True:
        try:
            with OPENER.open(URL + "/api/healthz", timeout=5):
                return
        except (urllib.error.URLError, ConnectionError):
            pass
        if time.monotonic() > deadline:
            die("Forgejo does not answer on 127.0.0.1:3000; journalctl -u forgejo says why")
        time.sleep(2)


def token() -> str:
    """The kept token, or a new one when Forgejo no longer takes it."""
    try:
        with open(TOKEN_FILE) as f:
            kept = f.read().strip()
        call("GET", "/api/v1/user", kept)
        return kept
    except (FileNotFoundError, Refused):
        pass
    name = f"nullbill-{int(time.time())}"
    new = forgejo("admin", "user", "generate-access-token", "--username", ADMIN, "--token-name", name,
                  "--scopes", "write:admin,write:user", "--raw").strip()  # fmt: skip
    write_secret(TOKEN_FILE, new)
    return new


def ensure_user(admin: str, user: str, email: str) -> bool:
    try:
        call("GET", f"/api/v1/users/{urllib.parse.quote(user)}", admin)
        return False
    except Refused as err:
        if err.code != 404:
            raise
    out = forgejo("admin", "user", "create", "--admin", "--random-password", "--must-change-password=false",
                  "--username", user, "--email", email)  # fmt: skip
    found = re.search(r"^generated random password is '(.*)'$", out, re.M)
    if not found:
        die(f"forgejo made {user} but printed no password")
    write_secret(PASSWORD_FILE, found.group(1))
    return True


def sync_keys(admin: str, user: str, wanted: list[str]) -> bool:
    have = call("GET", "/api/v1/user/keys?limit=50", admin, sudo=user) or []
    ours = {" ".join(k["key"].split()[:2]): k for k in have if k.get("title", "").startswith(TITLE)}
    present = {" ".join(k["key"].split()[:2]) for k in have}
    changed = False
    for n, line in enumerate(wanted, 1):
        key = " ".join(line.split()[:2])
        if key in present:
            ours.pop(key, None)
            continue
        comment = " ".join(line.split()[2:]) or f"key {n}"
        try:
            call("POST", "/api/v1/user/keys", admin, {"title": (TITLE + comment)[:50], "key": key}, sudo=user)
            changed = True
        except Refused as err:
            print(f"refused: {comment}: {err}")
    for gone in ours.values():
        call("DELETE", f"/api/v1/user/keys/{gone['id']}", admin, sudo=user)
        changed = True
    return changed


def main(argv: list[str]) -> None:
    if os.getuid() != 0:
        die("run as root")
    if len(argv) != 2:
        die("usage: nb-forgejo-owner USER EMAIL < keys")
    user, email = argv
    wanted = [line.strip() for line in sys.stdin if line.strip()]
    wait()
    admin = token()
    made = ensure_user(admin, user, email)
    changed = sync_keys(admin, user, wanted)
    print("changed" if made or changed else "same")


if __name__ == "__main__":
    main(sys.argv[1:])
