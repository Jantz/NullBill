#!/usr/bin/python3
"""Generated by nullbill. Jellyfin's first-run setup and transcoding, through
its API on 127.0.0.1, as apply's media stage runs them.

  nb-jellyfin wait                 until Jellyfin answers (two minutes at most)
  nb-jellyfin setup USER           finish the first-run setup with USER as the
                                   admin and the password in PASSWORD_FILE
                                   (made here once), then make the API key
                                   apply and verify use (API_KEY_FILE)
  nb-jellyfin encoding none        transcode on the CPU
  nb-jellyfin encoding qsv DEVICE  transcode with Intel Quick Sync on DEVICE
  nb-jellyfin library NAME PATH    add a library NAME of PATH, once: never when a
                                   library holds PATH already, or after the
                                   owner removed the one made here (ADDED_DIR)

setup, encoding and library print "changed" or "same". Until the first-run setup is
done, anyone who reaches Jellyfin could make themselves its admin, so apply
runs setup right after Jellyfin first starts.
"""

import json
import os
import secrets
import sys
import time
import urllib.error
import urllib.parse
import urllib.request

URL = "http://127.0.0.1:8096"
PASSWORD_FILE = "/etc/nullbill/jellyfin-admin-password"
API_KEY_FILE = "/etc/nullbill/jellyfin-api-key"
# One file per path a library was added for, so a library the owner removed
# stays removed.
ADDED_DIR = "/var/lib/nullbill/jellyfin-libraries"
# Films and series found by name, the rest by folder: a kept disk holds
# whatever its owner put there.
COLLECTION = "mixed"
APP = "NullBill"
CLIENT = 'MediaBrowser Client="nullbill", Device="apply", DeviceId="nullbill-apply", Version="1"'
# Jellyfin answers in camelCase unless asked for the names its API documents.
ACCEPT = 'application/json; profile="PascalCase"'
# What Quick Sync decodes on Intel graphics from the 7th generation on
# (https://jellyfin.org/docs/general/post-install/transcoding/hardware-acceleration/intel).
QSV_DECODE = ["h264", "hevc", "mpeg2video", "vc1", "vp8", "vp9"]
# Never through a proxy: this is Jellyfin on the same guest.
OPENER = urllib.request.build_opener(urllib.request.ProxyHandler({}))


class Refused(Exception):
    pass


def call(method: str, path: str, body: object = None, token: str | None = None) -> object:
    headers = {"Authorization": f'MediaBrowser Token="{token}"' if token else CLIENT, "Accept": ACCEPT}
    data = None
    if body is not None:
        data = json.dumps(body).encode()
        headers["Content-Type"] = "application/json"
    request = urllib.request.Request(URL + path, data=data, headers=headers, method=method)
    try:
        with OPENER.open(request, timeout=30) as response:
            text = response.read()
    except urllib.error.HTTPError as err:
        if err.code in (401, 403):
            raise Refused(f"{method} {path}: {err.code}") from err
        raise
    return json.loads(text) if text else None


def die(message: str) -> None:
    print(f"nb-jellyfin: {message}", file=sys.stderr)
    sys.exit(1)


def wait() -> None:
    """Until the server itself answers. While it first starts, a stand-in on
    the same port answers 200 in camelCase, then 503 while it loads."""
    deadline = time.monotonic() + 120
    while True:
        try:
            if "StartupWizardCompleted" in call("GET", "/System/Info/Public"):
                return
        except (urllib.error.URLError, ConnectionError, ValueError):
            pass
        if time.monotonic() > deadline:
            die("Jellyfin does not answer on 8096; journalctl -u jellyfin says why")
        time.sleep(2)


def write_secret(path: str, value: str) -> None:
    os.makedirs(os.path.dirname(path), mode=0o700, exist_ok=True)
    fd = os.open(path + ".tmp", os.O_WRONLY | os.O_CREAT | os.O_TRUNC, 0o600)
    with os.fdopen(fd, "w") as f:
        f.write(value + "\n")
    os.replace(path + ".tmp", path)


def read_secret(path: str) -> str | None:
    try:
        with open(path) as f:
            return f.read().strip() or None
    except FileNotFoundError:
        return None


def key_works(key: str | None) -> bool:
    if not key:
        return False
    try:
        call("GET", "/System/Configuration", token=key)
        return True
    except Refused:
        return False


def setup(user: str) -> None:
    changed = False
    password = read_secret(PASSWORD_FILE)
    if not call("GET", "/System/Info/Public")["StartupWizardCompleted"]:
        if password is None:
            password = secrets.token_urlsafe(18)
            write_secret(PASSWORD_FILE, password)
        call("POST", "/Startup/Configuration", {"UICulture": "en-US", "MetadataCountryCode": "US", "PreferredMetadataLanguage": "en"})
        # Jellyfin makes its first user when the setup starts; this names it.
        call("GET", "/Startup/User")
        call("POST", "/Startup/User", {"Name": user, "Password": password})
        # Reachable beyond its own subnet (the owner comes in over Tailscale);
        # never through UPnP on the home router.
        call("POST", "/Startup/RemoteAccess", {"EnableRemoteAccess": True, "EnableAutomaticPortMapping": False})
        call("POST", "/Startup/Complete")
        changed = True
    if not key_works(read_secret(API_KEY_FILE)):
        if password is None:
            die(f"Jellyfin's first-run setup was done without NullBill; put the admin password in {PASSWORD_FILE}")
        try:
            token = call("POST", "/Users/AuthenticateByName", {"Username": user, "Pw": password})["AccessToken"]
        except Refused:
            die(f"Jellyfin refuses {user} with the password in {PASSWORD_FILE}; put the one you changed it to there")
        call("POST", f"/Auth/Keys?app={APP}", token=token)
        keys = [k for k in call("GET", "/Auth/Keys", token=token)["Items"] if k["AppName"] == APP]
        newest = max(keys, key=lambda k: k["DateCreated"])
        for old in keys:
            if old is not newest:
                call("DELETE", f"/Auth/Keys/{old['AccessToken']}", token=token)
        write_secret(API_KEY_FILE, newest["AccessToken"])
        changed = True
    print("changed" if changed else "same")


def encoding(kind: str, device: str | None) -> None:
    if kind == "qsv" and not device:
        die("encoding qsv needs the render node")
    if kind not in ("none", "qsv"):
        die(f"unknown encoding {kind}")
    key = read_secret(API_KEY_FILE)
    if not key_works(key):
        die("no working API key; run nb-jellyfin setup first")
    config = call("GET", "/System/Configuration/encoding", token=key)
    want: dict = {"HardwareAccelerationType": kind}
    if kind == "qsv":
        want |= {
            "VaapiDevice": device,
            "QsvDevice": "",
            "HardwareDecodingCodecs": QSV_DECODE,
            "EnableDecodingColorDepth10Hevc": True,
            "EnableDecodingColorDepth10Vp9": True,
            "EnableHardwareEncoding": True,
        }
    if all(config.get(k) == v for k, v in want.items()):
        print("same")
        return
    call("POST", "/System/Configuration/encoding", config | want, token=key)
    print("changed")


def library(name: str, path: str) -> None:
    key = read_secret(API_KEY_FILE)
    if not key_works(key):
        die("no working API key; run nb-jellyfin setup first")
    marker = os.path.join(ADDED_DIR, path.strip("/").replace("/", "_"))
    held = any(path in (f.get("Locations") or []) for f in call("GET", "/Library/VirtualFolders", token=key))
    if held or os.path.exists(marker):
        print("same")
        return
    query = urllib.parse.urlencode({"name": name, "collectionType": COLLECTION, "refreshLibrary": "true"})
    call("POST", f"/Library/VirtualFolders?{query}", {"LibraryOptions": {"PathInfos": [{"Path": path}]}}, token=key)
    os.makedirs(ADDED_DIR, mode=0o700, exist_ok=True)
    open(marker, "w").close()
    print("changed")


def main(argv: list[str]) -> None:
    if argv[:1] == ["wait"] and len(argv) == 1:
        wait()
    elif argv[:1] == ["setup"] and len(argv) == 2:
        setup(argv[1])
    elif argv[:1] == ["encoding"] and len(argv) in (2, 3):
        encoding(argv[1], argv[2] if len(argv) == 3 else None)
    elif argv[:1] == ["library"] and len(argv) == 3:
        library(argv[1], argv[2])
    else:
        die("usage: nb-jellyfin wait | setup USER | encoding none | encoding qsv DEVICE | library NAME PATH")


if __name__ == "__main__":
    main(sys.argv[1:])
