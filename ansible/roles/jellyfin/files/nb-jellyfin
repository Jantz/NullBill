#!/usr/bin/python3
"""Generated by nullbill. Jellyfin's first-run setup and transcoding, through
its API on 127.0.0.1, as apply's media stage runs them.

  nb-jellyfin hold                 until the first-run setup is done: Jellyfin
                                   listens on 127.0.0.1 alone (its network.xml),
                                   which the role sets before Jellyfin first starts
  nb-jellyfin wait                 until Jellyfin answers (two minutes at most)
  nb-jellyfin setup USER           finish the first-run setup with USER as the
                                   admin and the password in PASSWORD_FILE
                                   (made here once), then make the API key
                                   apply and verify use (API_KEY_FILE), and
                                   only then let Jellyfin listen on every address
                                   again (a restart)
  nb-jellyfin encoding none        transcode on the CPU
  nb-jellyfin encoding qsv DEVICE  transcode with Intel Quick Sync on DEVICE
  nb-jellyfin library NAME PATH    add a library NAME of PATH, once: never when a
                                   library holds PATH already, or after the
                                   owner removed the one made here (ADDED_DIR)
  nb-jellyfin scan                 have Jellyfin read the libraries added here,
                                   once for all of them
  nb-jellyfin busy                 a line per reason Jellyfin is in use, for
                                   nb-busy: nothing means it may be stopped

hold, setup, encoding and library print "changed" or "same"; scan prints
"started", "same" (nothing new to read) or "waiting" (Jellyfin is still
scanning; the next call tries again). Until the first-run setup is done,
anyone who reaches Jellyfin could make themselves its admin: the role holds
it to 127.0.0.1 before its package first starts it, and only setup, once the
admin and the API key exist, opens it to the network. A setup that fails
leaves it held.
"""

import json
import os
import secrets
import stat
import subprocess
import sys
import tempfile
import time
import urllib.error
import urllib.parse
import urllib.request
import xml.etree.ElementTree as ET

URL = "http://127.0.0.1:8096"
PASSWORD_FILE = "/etc/nullbill/jellyfin-admin-password"
API_KEY_FILE = "/etc/nullbill/jellyfin-api-key"
# One file per path a library was added for, so a library the owner removed
# stays removed.
ADDED_DIR = "/var/lib/nullbill/jellyfin-libraries"
# Present while a library added here has not been scanned yet.
SCAN_OWED = "/var/lib/nullbill/jellyfin-scan-owed"
# Jellyfin's task "Scan Media Library".
SCAN_TASK = "RefreshLibrary"
# How long scan waits for a scan that is already running, and for its own to
# show as started.
SCAN_WAIT_S = 300
SCAN_START_S = 30
# Films and series found by name, the rest by folder: a kept disk holds
# whatever its owner put there.
COLLECTION = "mixed"
APP = "NullBill"
CLIENT = 'MediaBrowser Client="nullbill", Device="apply", DeviceId="nullbill-apply", Version="1"'
# Jellyfin answers in camelCase unless asked for the names its API documents.
ACCEPT = 'application/json; profile="PascalCase"'
# What Quick Sync decodes on Intel graphics from the 7th generation on
# (https://jellyfin.org/docs/general/post-install/transcoding/hardware-acceleration/intel).
QSV_DECODE = ["h264", "hevc", "mpeg2video", "vc1", "vp8", "vp9"]
# Never through a proxy: this is Jellyfin on the same guest.
OPENER = urllib.request.build_opener(urllib.request.ProxyHandler({}))
# Jellyfin's settings (JELLYFIN_CONFIG_DIR in /etc/default/jellyfin).
CONFIG_DIR = "/etc/jellyfin"
SYSTEM_XML = "system.xml"
NETWORK_XML = "network.xml"
LOOPBACK = "127.0.0.1"
# Present while hold holds Jellyfin to LOOPBACK: the addresses it listened
# on before (JSON), which setup gives back.
HELD = "/var/lib/nullbill/jellyfin-held"
UNIT = "jellyfin"


class Refused(Exception):
    pass


def call(method: str, path: str, body: object = None, token: str | None = None) -> object:
    headers = {"Authorization": f'MediaBrowser Token="{token}"' if token else CLIENT, "Accept": ACCEPT}
    data = None
    if body is not None:
        data = json.dumps(body).encode()
        headers["Content-Type"] = "application/json"
    request = urllib.request.Request(URL + path, data=data, headers=headers, method=method)
    try:
        with OPENER.open(request, timeout=30) as response:
            text = response.read()
    except urllib.error.HTTPError as err:
        if err.code in (401, 403):
            raise Refused(f"{method} {path}: {err.code}") from err
        raise
    return json.loads(text) if text else None


def die(message: str) -> None:
    print(f"nb-jellyfin: {message}", file=sys.stderr)
    sys.exit(1)


def wait() -> None:
    """Until the server itself answers. While it first starts, a stand-in on
    the same port answers 200 in camelCase, then 503 while it loads."""
    deadline = time.monotonic() + 120
    while True:
        try:
            if "StartupWizardCompleted" in call("GET", "/System/Info/Public"):
                return
        except (urllib.error.URLError, ConnectionError, ValueError):
            pass
        if time.monotonic() > deadline:
            die("Jellyfin does not answer on 8096; journalctl -u jellyfin says why")
        time.sleep(2)


def write_secret(path: str, value: str) -> None:
    os.makedirs(os.path.dirname(path), mode=0o700, exist_ok=True)
    fd = os.open(path + ".tmp", os.O_WRONLY | os.O_CREAT | os.O_TRUNC, 0o600)
    with os.fdopen(fd, "w") as f:
        f.write(value + "\n")
    os.replace(path + ".tmp", path)


def read_secret(path: str) -> str | None:
    try:
        with open(path) as f:
            return f.read().strip() or None
    except FileNotFoundError:
        return None


def read_config(name: str) -> str | None:
    """A file of Jellyfin's settings, opened through no link (the directory
    is Jellyfin's user's); None when there is none."""
    try:
        fd = os.open(os.path.join(CONFIG_DIR, name), os.O_RDONLY | os.O_NOFOLLOW | os.O_NONBLOCK)
    except FileNotFoundError:
        return None
    with os.fdopen(fd, "rb") as f:
        if not stat.S_ISREG(os.fstat(f.fileno()).st_mode):
            die(f"{CONFIG_DIR}/{name} is not a plain file")
        return f.read(2**20).decode()


def write_config(name: str, text: str) -> None:
    """A new file in Jellyfin's settings, its directory's owner's, renamed
    over the old one: a link there is replaced, never followed."""
    folder = os.stat(CONFIG_DIR)
    fd, tmp = tempfile.mkstemp(dir=CONFIG_DIR, prefix=f".{name}.")
    try:
        with os.fdopen(fd, "w") as f:
            f.write(text)
            os.fchown(f.fileno(), folder.st_uid, folder.st_gid)
            os.fchmod(f.fileno(), 0o640)
        os.replace(tmp, os.path.join(CONFIG_DIR, name))
    except BaseException:
        os.unlink(tmp)
        raise


def wizard_done() -> bool:
    found = ET.fromstring(read_config(SYSTEM_XML) or "<ServerConfiguration/>").findtext("IsStartupWizardCompleted")
    return (found or "").strip().lower() == "true"


def hold() -> None:
    """Jellyfin listens on LOOPBACK alone while its first-run setup is
    open; the addresses it was set to are kept in HELD for setup."""
    if wizard_done():
        print("same")
        return
    os.makedirs(CONFIG_DIR, mode=0o755, exist_ok=True)
    root = ET.fromstring(read_config(NETWORK_XML) or "<NetworkConfiguration/>")
    addresses = root.find("LocalNetworkAddresses")
    if addresses is None:
        addresses = ET.SubElement(root, "LocalNetworkAddresses")
    had = [e.text or "" for e in addresses.findall("string")]
    changed = had != [LOOPBACK]
    if changed:
        for e in list(addresses):
            addresses.remove(e)
        ET.SubElement(addresses, "string").text = LOOPBACK
        ET.indent(root)
        write_config(NETWORK_XML, '<?xml version="1.0" encoding="utf-8"?>\n' + ET.tostring(root, encoding="unicode") + "\n")
    if not os.path.exists(HELD):
        os.makedirs(os.path.dirname(HELD), mode=0o755, exist_ok=True)
        with open(HELD, "w") as f:
            json.dump([] if had == [LOOPBACK] else had, f)
        changed = True
    print("changed" if changed else "same")


def release(key: str) -> bool:
    """After setup: the addresses Jellyfin listened on before hold, then a
    restart, since it binds them only when it starts. True when it did."""
    try:
        with open(HELD) as f:
            had = json.load(f)
    except FileNotFoundError:
        return False
    config = call("GET", "/System/Configuration/network", token=key)
    if config.get("LocalNetworkAddresses") != had:
        call("POST", "/System/Configuration/network", config | {"LocalNetworkAddresses": had}, token=key)
    done = subprocess.run(["systemctl", "restart", UNIT], capture_output=True, text=True, check=False)
    if done.returncode != 0:
        die(f"Jellyfin did not restart to listen on the network: {done.stderr.strip()[-200:]}")
    wait()
    os.unlink(HELD)
    return True


def key_works(key: str | None) -> bool:
    if not key:
        return False
    try:
        call("GET", "/System/Configuration", token=key)
        return True
    except Refused:
        return False


def setup(user: str) -> None:
    changed = False
    password = read_secret(PASSWORD_FILE)
    if not call("GET", "/System/Info/Public")["StartupWizardCompleted"]:
        if password is None:
            password = secrets.token_urlsafe(18)
            write_secret(PASSWORD_FILE, password)
        call("POST", "/Startup/Configuration", {"UICulture": "en-US", "MetadataCountryCode": "US", "PreferredMetadataLanguage": "en"})
        # Jellyfin makes its first user when the setup starts; this names it.
        call("GET", "/Startup/User")
        call("POST", "/Startup/User", {"Name": user, "Password": password})
        # Reachable beyond its own subnet (the owner comes in over Tailscale);
        # never through UPnP on the home router.
        call("POST", "/Startup/RemoteAccess", {"EnableRemoteAccess": True, "EnableAutomaticPortMapping": False})
        call("POST", "/Startup/Complete")
        changed = True
    if not key_works(read_secret(API_KEY_FILE)):
        if password is None:
            die(f"Jellyfin's first-run setup was done without NullBill; put the admin password in {PASSWORD_FILE}")
        try:
            token = call("POST", "/Users/AuthenticateByName", {"Username": user, "Pw": password})["AccessToken"]
        except Refused:
            die(f"Jellyfin refuses {user} with the password in {PASSWORD_FILE}; put the one you changed it to there")
        call("POST", f"/Auth/Keys?app={APP}", token=token)
        keys = [k for k in call("GET", "/Auth/Keys", token=token)["Items"] if k["AppName"] == APP]
        newest = max(keys, key=lambda k: k["DateCreated"])
        for old in keys:
            if old is not newest:
                call("DELETE", f"/Auth/Keys/{old['AccessToken']}", token=token)
        write_secret(API_KEY_FILE, newest["AccessToken"])
        changed = True
    # Only now may anyone but this guest reach it.
    if release(read_secret(API_KEY_FILE)):
        changed = True
    print("changed" if changed else "same")


def encoding(kind: str, device: str | None) -> None:
    if kind == "qsv" and not device:
        die("encoding qsv needs the render node")
    if kind not in ("none", "qsv"):
        die(f"unknown encoding {kind}")
    key = read_secret(API_KEY_FILE)
    if not key_works(key):
        die("no working API key; run nb-jellyfin setup first")
    config = call("GET", "/System/Configuration/encoding", token=key)
    want: dict = {"HardwareAccelerationType": kind}
    if kind == "qsv":
        want |= {
            "VaapiDevice": device,
            "QsvDevice": "",
            "HardwareDecodingCodecs": QSV_DECODE,
            "EnableDecodingColorDepth10Hevc": True,
            "EnableDecodingColorDepth10Vp9": True,
            "EnableHardwareEncoding": True,
        }
    if all(config.get(k) == v for k, v in want.items()):
        print("same")
        return
    call("POST", "/System/Configuration/encoding", config | want, token=key)
    print("changed")


def library(name: str, path: str) -> None:
    """Add the library and leave reading it to scan: Jellyfin starts no scan
    for a library that is added while a scan runs, so with two kept disks the
    second library stayed empty."""
    key = read_secret(API_KEY_FILE)
    if not key_works(key):
        die("no working API key; run nb-jellyfin setup first")
    marker = os.path.join(ADDED_DIR, path.strip("/").replace("/", "_"))
    held = any(path in (f.get("Locations") or []) for f in call("GET", "/Library/VirtualFolders", token=key))
    if held or os.path.exists(marker):
        print("same")
        return
    os.makedirs(ADDED_DIR, mode=0o700, exist_ok=True)
    # Before the library: a call that ends between the two still gets its scan.
    open(SCAN_OWED, "w").close()
    query = urllib.parse.urlencode({"name": name, "collectionType": COLLECTION, "refreshLibrary": "false"})
    call("POST", f"/Library/VirtualFolders?{query}", {"LibraryOptions": {"PathInfos": [{"Path": path}]}}, token=key)
    open(marker, "w").close()
    print("changed")


def scan_task(key: str) -> dict:
    return next(t for t in call("GET", "/ScheduledTasks", token=key) if t.get("Key") == SCAN_TASK)


def scan() -> None:
    """One scan for every library added since the last. Jellyfin drops a
    request to scan while it scans, so wait for a running scan to end, start
    one, and count it started only once Jellyfin shows it."""
    if not os.path.exists(SCAN_OWED):
        print("same")
        return
    key = read_secret(API_KEY_FILE)
    if not key_works(key):
        die("no working API key; run nb-jellyfin setup first")
    deadline = time.monotonic() + SCAN_WAIT_S
    while (task := scan_task(key)).get("State") != "Idle":
        if time.monotonic() > deadline:
            print("waiting")
            return
        time.sleep(2)
    before = (task.get("LastExecutionResult") or {}).get("StartTimeUtc")
    call("POST", f"/ScheduledTasks/Running/{task['Id']}", token=key)
    deadline = time.monotonic() + SCAN_START_S
    while True:
        task = scan_task(key)
        if task.get("State") != "Idle" or (task.get("LastExecutionResult") or {}).get("StartTimeUtc") != before:
            break
        if time.monotonic() > deadline:
            die("Jellyfin did not start the scan of its libraries")
        time.sleep(1)
    os.unlink(SCAN_OWED)
    print("started")


# A device counts as using Jellyfin this long after it last asked for
# anything; an app left open on a paused or finished title stops counting.
ACTIVE_S = 300
# nb-jellyfin's own sign-in, when it makes the API key.
OWN_DEVICE = "nullbill-apply"


def busy() -> None:
    """Something playing, a device that asked for something lately, or a
    task such as a library scan under way. Anything that stops Jellyfin from
    answering is printed as a reason too, so it is not stopped unasked."""
    key = read_secret(API_KEY_FILE)
    if not key:
        return  # not set up yet: nobody can be using it
    try:
        sessions = call("GET", f"/Sessions?activeWithinSeconds={ACTIVE_S}", token=key)
        tasks = call("GET", "/ScheduledTasks?isHidden=false", token=key)
    except (Refused, urllib.error.URLError, ConnectionError, ValueError) as err:
        print(f"cannot ask Jellyfin who is using it ({err})")
        return
    sessions = [s for s in sessions if s.get("DeviceId") != OWN_DEVICE]
    playing = sum(1 for s in sessions if s.get("NowPlayingItem"))
    browsing = len(sessions) - playing
    if playing:
        print(f"playing on {playing} device{'' if playing == 1 else 's'}")
    if browsing:
        print(f"open on {browsing} device{'' if browsing == 1 else 's'}")
    for task in tasks:
        if task.get("State") == "Running":
            print(f"at work: {task.get('Name', 'a task')}")


def main(argv: list[str]) -> None:
    if argv == ["hold"]:
        hold()
    elif argv[:1] == ["wait"] and len(argv) == 1:
        wait()
    elif argv[:1] == ["setup"] and len(argv) == 2:
        setup(argv[1])
    elif argv[:1] == ["encoding"] and len(argv) in (2, 3):
        encoding(argv[1], argv[2] if len(argv) == 3 else None)
    elif argv[:1] == ["library"] and len(argv) == 3:
        library(argv[1], argv[2])
    elif argv == ["scan"]:
        scan()
    elif argv == ["busy"]:
        busy()
    else:
        die("usage: nb-jellyfin hold | wait | setup USER | encoding none | encoding qsv DEVICE | library NAME PATH | scan | busy")


if __name__ == "__main__":
    main(sys.argv[1:])
