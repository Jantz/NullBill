# Generated by nullbill. What this guest's setup script runs with
# (nb-custom-setup); a unit can read it too, with EnvironmentFile=.
NB_SERVICE="{{ custom_service_name }}"
NB_DOMAIN="{{ custom_service_domain }}"
NB_ADDRESS="{{ custom_service_address }}"
NB_PORTS="{{ custom_service_ports | join(' ') }}"
NB_SETUP_TIMEOUT_S="{{ custom_service_timeout_s | int }}"
DEBIAN_FRONTEND="noninteractive"
{% if custom_service_proxy %}
# This guest has no route to the internet and resolves no outside names:
# programs reach the allow-listed names through the proxy, by these.
http_proxy="{{ custom_service_proxy }}"
https_proxy="{{ custom_service_proxy }}"
HTTP_PROXY="{{ custom_service_proxy }}"
HTTPS_PROXY="{{ custom_service_proxy }}"
no_proxy="localhost,127.0.0.1,.{{ custom_service_domain }}"
NO_PROXY="localhost,127.0.0.1,.{{ custom_service_domain }}"
{% endif %}
