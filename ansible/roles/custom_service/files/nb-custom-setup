#!/bin/sh
# Generated by nullbill. Runs this guest's setup script: the one the owner
# or the page's agent wrote for a service NullBill has no role for.
#
#   nb-custom-setup         run it, unless this version of it ran to its
#                           end before; prints "ran" or "unchanged"
#   nb-custom-setup again   run it regardless
#
# The script runs as root with the variables in env, no terminal and
# nothing to read, its output in LOG (the last run's only). When it ends
# well its SHA-256 is kept in MARK, which is what `nullbill verify` reads.
set -u
dir=/usr/local/lib/nb-custom
mark=/var/lib/nb-custom/setup.sha256
log=/var/log/nb-custom-setup.log

sum=$(sha256sum "$dir/setup.sh" | cut -d' ' -f1)
[ -n "$sum" ] || exit 1
if [ "${1:-}" != again ] && [ "$(cat "$mark" 2>/dev/null)" = "$sum" ]; then
  echo unchanged
  exit 0
fi
rm -f "$mark"
set -a
# shellcheck source=/dev/null
. "$dir/env"
set +a
cd /root || exit 1
echo "--- $(date -u +%Y-%m-%dT%H:%M:%SZ) setup.sh $sum" >"$log"
timeout --kill-after=30 "$NB_SETUP_TIMEOUT_S" "$dir/setup.sh" </dev/null >>"$log" 2>&1
rc=$?
echo "--- exit $rc" >>"$log"
if [ "$rc" -ne 0 ]; then
  if [ "$rc" -eq 124 ] || [ "$rc" -eq 137 ]; then
    echo "the setup script was still running after $NB_SETUP_TIMEOUT_S s and was ended" >&2
  else
    echo "the setup script failed (exit $rc)" >&2
  fi
  echo "the end of $log:" >&2
  tail -n 40 "$log" >&2
  exit "$rc"
fi
echo "$sum" >"$mark"
echo ran
