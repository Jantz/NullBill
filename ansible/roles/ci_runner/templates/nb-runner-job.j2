#!/bin/bash
# Generated by nullbill. Runs once at boot on a runner clone: fetch the job
# the dispatcher put this clone up for, run it as `runner`, power off.
# The golden image boots without a job while apply bakes it, and does
# nothing then.
set -euo pipefail
serial=$(cat {{ ci_runner_serial_file }} 2>/dev/null || true)
if ! [[ $serial =~ ^[0-9a-f]{32}$ ]]; then
  echo "no job in the SMBIOS serial; not a dispatched clone"
  exit 0
fi
# Whatever happens below, the clone ends, and the dispatcher destroys it.
trap '{{ ci_runner_poweroff }}' EXIT

job=/run/nb-runner
install -d -m 0700 -o runner -g runner "$job"
# The nonce is good for one fetch; curl retries only refused connections
# and errors before a response.
curl -fsS --retry 20 --retry-connrefused --retry-delay 3 --max-time 20 \
  "{{ ci_runner_dispatcher_url }}/handoff/$serial" >"$job/job.json"
python3 -I - "$job" <<'PY'
import json, os, sys
d = sys.argv[1]
job = json.load(open(f"{d}/job.json"))
os.umask(0o077)
open(f"{d}/token", "w").write(job["token"])
args = ["--url", job["url"], "--uuid", job["uuid"], "--token-url", f"file://{d}/token", "--handle", job["handle"]]
for label in job["labels"]:
    args += ["--label", label]
open(f"{d}/args", "w").write("\0".join(args))
os.remove(f"{d}/job.json")
PY
chown runner:runner "$job/token" "$job/args"
mapfile -d '' -t args <"$job/args"
cd /home/runner
runuser -u runner -- env HOME=/home/runner \
{% if ci_runner_proxy_url %}
  https_proxy={{ ci_runner_proxy_url }} http_proxy={{ ci_runner_proxy_url }} no_proxy={{ ci_runner_no_proxy }} \
{% endif %}
  /usr/local/bin/forgejo-runner one-job "${args[@]}"
