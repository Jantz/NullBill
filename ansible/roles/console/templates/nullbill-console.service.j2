# Generated by nullbill. The on-site screen on tty1; Ctrl+Alt+F2 switches to
# PVE's own text console, the way in when everything else is broken.
[Unit]
Description=NullBill on-site screen
After=systemd-user-sessions.service network-online.target
Wants=network-online.target
Conflicts=getty@tty1.service

[Service]
User={{ console_user }}
PAMName=nullbill-console
TTYPath=/dev/tty1
TTYReset=yes
TTYVHangup=yes
TTYVTDisallocate=yes
StandardInput=tty-fail
UtmpIdentifier=tty1
UtmpMode=user
# -d: no window decorations; -s: allow Ctrl+Alt+Fn to switch consoles.
# Chromium honours the key pin only with its own --user-data-dir.
ExecStart=/usr/bin/cage -d -s -- /usr/bin/chromium --kiosk --incognito --no-first-run --noerrdialogs \
  --ozone-platform=wayland --password-store=basic --disable-features=Translate \
  --user-data-dir=/var/lib/{{ console_user }}/chromium \
  --ignore-certificate-errors-spki-list={{ console_page_spki }} {{ console_url }}
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
