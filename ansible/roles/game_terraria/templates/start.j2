#!/bin/sh
# Generated by nullbill. Terraria as its unit starts it: as user game, its
# console on the FIFO nb-game writes to. Opened read-write, so the server
# never sees it end. The server looks for its libraries beside itself.
#
# While nb-game makes a new world (world new) it leaves a config for that
# one start, the server's own with the new world's size, difficulty and seed.
config=/etc/terraria/serverconfig.txt
[ -r /etc/terraria/new-world.txt ] && config=/etc/terraria/new-world.txt
cd {{ game_terraria_dir }} || exit 1
exec ./TerrariaServer.bin.x86_64 -config "$config" <>/run/terraria/console
