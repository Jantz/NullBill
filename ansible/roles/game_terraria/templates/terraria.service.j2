# Generated by nullbill.
[Unit]
Description=Terraria server
After=network-online.target
Wants=network-online.target

[Service]
User=game
Group=game
Environment=HOME=/var/lib/terraria
WorkingDirectory=/var/lib/terraria
UMask=0027
RuntimeDirectory=terraria
RuntimeDirectoryMode=0750
ExecStartPre=/usr/bin/mkfifo -m 0600 /run/terraria/console
ExecStart=/opt/terraria/start
# "exit" on the console: the server saves the world and exits. A signal
# alone ends it without saving.
ExecStop=/usr/local/sbin/nb-game stop $MAINPID
TimeoutStopSec=120
Restart=on-failure
RestartSec=10
NoNewPrivileges=true
ProtectSystem=strict
ReadWritePaths=/var/lib/terraria
ProtectHome=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
