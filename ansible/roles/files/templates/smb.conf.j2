# Generated by nullbill. Shares of disks kept from a previous OS; only
# {{ files_user }} may connect, over SMB3 with encryption.
[global]
   server role = standalone server
   workgroup = WORKGROUP
   server min protocol = SMB3
   server smb encrypt = required
   map to guest = never
   restrict anonymous = 2
   disable netbios = yes
   smb ports = 445
   load printers = no
   printing = bsd
   printcap name = /dev/null
   disable spoolss = yes
   usershare max shares = 0
   passdb backend = tdbsam
   # To the journal, with each logon, which the log shipper sends to Loki.
   logging = systemd
   log level = 1 auth_audit:3
{% for share in files_shares %}

[{{ share.name }}]
   path = {{ files_share_root }}/{{ share.name }}
   valid users = {{ files_user }}
   force user = {{ files_user }}
   read only = {{ 'yes' if share.read_only else 'no' }}
   browseable = yes
{% endfor %}
