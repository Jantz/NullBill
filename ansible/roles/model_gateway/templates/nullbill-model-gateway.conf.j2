# Generated by nullbill. HTTPS for LiteLLM, which listens on localhost only.
# tls_cert reloads nginx after each renewal.
server {
    listen {{ model_gateway_port }} ssl;
    server_name {{ model_gateway_domain }};
    ssl_certificate /etc/nullbill/tls/{{ model_gateway_tls_name }}.crt;
    ssl_certificate_key /etc/nullbill/tls/{{ model_gateway_tls_name }}.key;
    ssl_protocols TLSv1.2 TLSv1.3;

    # Answers stream token by token, and a local model can take minutes.
    client_max_body_size 64m;
    proxy_buffering off;
    proxy_request_buffering off;
    proxy_read_timeout 1h;

    location / {
        proxy_pass http://127.0.0.1:4001;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto https;
    }
}
