# Generated by nullbill. HTTPS for LiteLLM, which listens on localhost only.
# Clients that ask for {{ model_gateway_domain }} get step-ca's certificate,
# which tls_cert renews and reloads nginx for; browsers that open the
# address get the browser CA's.
{% for server in ([{'cert': '/etc/nullbill/tls/' ~ model_gateway_tls_name, 'default': ''}]
                  + ([{'cert': '/etc/nginx/nullbill/browser', 'default': ' default_server'}] if model_gateway_browser_cert | length > 0 else [])) %}
server {
    listen {{ model_gateway_port }} ssl{{ server.default }};
{% if not server.default %}
    server_name {{ model_gateway_domain }};
{% endif %}
    ssl_certificate {{ server.cert }}.crt;
    ssl_certificate_key {{ server.cert }}.key;
    ssl_protocols TLSv1.2 TLSv1.3;

    # Answers stream token by token, and a local model can take minutes.
    client_max_body_size 64m;
    proxy_buffering off;
    proxy_request_buffering off;
    proxy_read_timeout 1h;

    location / {
        proxy_pass http://127.0.0.1:4001;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto https;
    }
}
{% endfor %}
