# Generated by nullbill.
[Unit]
Description=LiteLLM model gateway
After=network-online.target
Wants=network-online.target

[Service]
User=litellm
Group=litellm
WorkingDirectory=/var/lib/litellm
Environment=HOME=/var/lib/litellm
EnvironmentFile=/etc/litellm/env
ExecStart={{ model_gateway_venv }}/bin/litellm --config /etc/litellm/config.yaml --host 127.0.0.1 --port 4001 --num_workers 1 --telemetry False
Restart=always
RestartSec=5
NoNewPrivileges=true
ProtectSystem=strict
ReadWritePaths=/var/lib/litellm
ProtectHome=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
