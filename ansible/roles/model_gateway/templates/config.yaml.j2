# Generated by nullbill. Keys come from the environment (/etc/litellm/env).
model_list:
{% for name in [model_gateway_model, 'local'] %}
  - model_name: {{ name }}
    litellm_params:
      model: openai/{{ model_gateway_model }}
      api_base: {{ model_gateway_backend }}
      api_key: os.environ/NB_INFERENCE_KEY
{% endfor %}

litellm_settings:
  # Local models think and write slowly; agents wait.
  request_timeout: 1800

general_settings:
  master_key: os.environ/NB_GATEWAY_KEY
