#!/bin/sh
# Generated by nullbill. For nb-busy, when local models run on demand: the
# gateway is in use while a client holds a connection (an answer can stream
# for minutes) and for two minutes after it last answered one.
set -eu
open=$(/usr/local/sbin/nb-busy connections {{ model_gateway_port }})
if [ "$open" -eq 1 ]; then echo "1 client connected"; fi
if [ "$open" -gt 1 ]; then echo "$open clients connected"; fi
log=/var/log/nginx/access.log
if [ -s "$log" ]; then
  age=$(($(date +%s) - $(stat -c %Y "$log")))
  if [ "$age" -lt 120 ]; then echo "answered a request $age s ago"; fi
fi
