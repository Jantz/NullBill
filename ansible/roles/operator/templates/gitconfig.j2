# Generated by nullbill. The agent's commits carry the owner's noreply
# identity, which the repository's pre-push hook requires.
[user]
{% if operator_git_name %}
	name = {{ operator_git_name }}
	email = {{ operator_git_email }}
{% endif %}
[credential "https://github.com"]
	helper = "!f() { test \"$1\" = get && test -r /etc/nullbill/agent/github-token && echo username=x-access-token && echo password=$(cat /etc/nullbill/agent/github-token); }; f"
[init]
	defaultBranch = main
