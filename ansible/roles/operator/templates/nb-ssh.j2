#!/usr/bin/env bash
# Generated by nullbill. nb-ssh GUEST [COMMAND...]: SSH to an agent-managed
# guest as the agent user with a certificate from step-ca's agent
# provisioner, fetched again when under 5 minutes of it remain.
set -euo pipefail
conf=/etc/nullbill/agent
key=$HOME/.ssh/nb-agent
[ $# -ge 1 ] || { echo "usage: nb-ssh GUEST [COMMAND...]" >&2; exit 2; }
mkdir -p -m 700 "$HOME/.ssh"
valid_to=$(ssh-keygen -L -f "$key-cert.pub" 2>/dev/null | sed -n 's/^ *Valid: from .* to //p' || true)
if [ -z "$valid_to" ] || [ "$(date -d "$valid_to" +%s)" -lt $(($(date +%s) + 300)) ]; then
  step ssh certificate agent "$key" --ca-url {{ operator_ca_url }} --root "$conf/ca-root.pem" \
    --provisioner agent --provisioner-password-file "$conf/step-password" \
    --not-after {{ operator_ssh_cert_lifetime }} --no-password --insecure --no-agent --force >/dev/null 2>&1 ||
    { echo "nb-ssh: step-ca refused a certificate" >&2; exit 1; }
fi
exec ssh -i "$key" -o CertificateFile="$key-cert.pub" -o IdentitiesOnly=yes \
  -o StrictHostKeyChecking=accept-new -l agent "$@"
