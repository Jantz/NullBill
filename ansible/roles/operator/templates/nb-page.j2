#!/usr/bin/env bash
# Generated by nullbill. nb-page: the runtime agent's way into the NullBill
# page, which accepts its token from this container only.
#   nb-page verify         start `nullbill verify`, follow its output, exit 1 on FAIL
#   nb-page apply [STAGE]  run setup, or one stage of it, and follow it (owner's switch)
#   nb-page upgrade        move NullBill to main's newest commit (owner's switch)
#   nb-page jobs           list the page's jobs (id, action, state, exit code)
#   nb-page job ID         a job's output: any job while the switch is on, else verify's
# The page's key is pinned, so a different server is refused.
set -euo pipefail
url={{ operator_page_url }}
page() {
  curl -sS --noproxy '*' -k --pinnedpubkey 'sha256//{{ operator_page_spki }}' \
    -H "Authorization: Bearer $(cat /etc/nullbill/agent/page-token)" -H 'X-NullBill: 1' "$@"
}
follow() {
  local id=$1 offset=0 job misses=0 rc
  while :; do
    # The page restarts during an upgrade; its job carries on.
    rc=0
    job=$(page --fail-with-body "${url}api/agent/jobs/$id?offset=$offset") || rc=$?
    if [ "$rc" != 0 ]; then
      # 22 is an HTTP error from the page itself; anything else is no answer.
      [ "$rc" != 22 ] && [ "$misses" -lt 24 ] || { echo "nb-page: job $id: $job (curl exit $rc)" >&2; return 1; }
      misses=$((misses + 1))
      sleep 5
      continue
    fi
    misses=0
    printf '%s' "$(jq -r .text <<<"$job")"
    offset=$(jq -r .offset <<<"$job")
    case $(jq -r .state <<<"$job") in
      running) sleep 5 ;;
      done) return 0 ;;
      *) return 1 ;;
    esac
  done
}
start() { # action body
  local job
  job=$(page --fail-with-body -X POST -H 'Content-Type: application/json' -d "$2" "${url}api/agent/$1") ||
    { echo "nb-page: the page did not start $1: $job" >&2; exit 1; }
  follow "$(jq -r .id <<<"$job")"
}
case "${1:-}" in
  verify | upgrade) [ $# -eq 1 ] || { echo "usage: nb-page $1" >&2; exit 2; }; start "$1" '{}' ;;
  apply)
    [ $# -le 2 ] || { echo "usage: nb-page apply [STAGE]" >&2; exit 2; }
    start apply "$(jq -cn --arg stage "${2:-}" 'if $stage == "" then {} else {stage: $stage} end')"
    ;;
  jobs) page --fail-with-body "${url}api/agent/jobs" | jq -r '.[] | "\(.id)\t\(.action)\t\(.state)\t\(.rc)"' ;;
  job) [ $# -eq 2 ] || { echo "usage: nb-page job ID" >&2; exit 2; }; follow "$2" ;;
  *) echo "usage: nb-page verify | apply [STAGE] | upgrade | jobs | job ID" >&2; exit 2 ;;
esac
