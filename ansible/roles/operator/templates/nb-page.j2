#!/usr/bin/env bash
# Generated by nullbill. nb-page: the runtime agent's way into the NullBill
# page, which accepts its token from this container only.
#   nb-page verify   start `nullbill verify`, follow its output, exit 1 on FAIL
#   nb-page jobs     list the page's jobs (id, action, state, exit code)
#   nb-page job ID   the output of a verify job
# The page's key is pinned, so a different server is refused.
set -euo pipefail
url={{ operator_page_url }}
page() {
  curl -sS --noproxy '*' -k --pinnedpubkey 'sha256//{{ operator_page_spki }}' \
    -H "Authorization: Bearer $(cat /etc/nullbill/agent/page-token)" -H 'X-NullBill: 1' "$@"
}
follow() {
  local id=$1 offset=0 job
  while :; do
    job=$(page --fail-with-body "${url}api/agent/jobs/$id?offset=$offset")
    printf '%s' "$(jq -r .text <<<"$job")"
    offset=$(jq -r .offset <<<"$job")
    case $(jq -r .state <<<"$job") in
      running) sleep 5 ;;
      done) return 0 ;;
      *) return 1 ;;
    esac
  done
}
case "${1:-}" in
  verify)
    job=$(page --fail-with-body -X POST -H 'Content-Type: application/json' -d '{}' "${url}api/agent/verify") ||
      { echo "nb-page: the page did not start verify: $job" >&2; exit 1; }
    follow "$(jq -r .id <<<"$job")"
    ;;
  jobs) page --fail-with-body "${url}api/agent/jobs" | jq -r '.[] | "\(.id)\t\(.action)\t\(.state)\t\(.rc)"' ;;
  job) [ $# -eq 2 ] || { echo "usage: nb-page job ID" >&2; exit 2; }; follow "$2" ;;
  *) echo "usage: nb-page verify | jobs | job ID" >&2; exit 2 ;;
esac
