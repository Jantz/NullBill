#!/bin/sh
# Generated by nullbill. Minecraft as its unit starts it: from
# /var/lib/minecraft as user game, its console on the FIFO nb-game writes
# to. Opened read-write, so the server never sees it end.
#
# jdk.net.hosts.file: Java looks names up in that file and nowhere else. It
# names Mojang's services at this guest's own address, where nb-tls-tunnel
# carries each connection out through the egress proxy; the server ignores
# Java's proxy settings (it asks for a direct connection by name).
exec /opt/minecraft/java-{{ game_minecraft_java_version }}/bin/java \
  -Xmx{{ game_minecraft_heap_mib }}M \
  -Djdk.net.hosts.file=/etc/minecraft/hosts \
  -jar /opt/minecraft/server-{{ game_minecraft_version }}.jar --nogui \
  <>/run/minecraft/console
