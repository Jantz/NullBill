# Generated by nullbill.
[Unit]
Description=Minecraft server
After=network-online.target nb-tls-tunnel.service
Wants=network-online.target nb-tls-tunnel.service

[Service]
User=game
Group=game
Environment=HOME=/var/lib/minecraft
WorkingDirectory=/var/lib/minecraft
UMask=0027
RuntimeDirectory=minecraft
RuntimeDirectoryMode=0750
ExecStartPre=/usr/bin/mkfifo -m 0600 /run/minecraft/console
ExecStart=/opt/minecraft/start
# "stop" on the console: the server saves the world and exits.
ExecStop=/usr/local/sbin/nb-game stop $MAINPID
TimeoutStopSec=120
Restart=on-failure
RestartSec=10
NoNewPrivileges=true
ProtectSystem=strict
ReadWritePaths=/var/lib/minecraft
ProtectHome=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
