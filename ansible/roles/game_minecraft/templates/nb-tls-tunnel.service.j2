# Generated by nullbill.
[Unit]
Description=Minecraft's way to Mojang's services through the egress proxy
After=network-online.target
Wants=network-online.target

[Service]
User=game
Group=game
# Port 443, as the server asks for it.
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
ExecStart=/usr/local/sbin/nb-tls-tunnel serve {{ game_minecraft_proxy }}
Restart=always
RestartSec=5
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
