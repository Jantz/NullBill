#!/usr/bin/env python3
"""Generated by nullbill. The way out for a program that ignores proxy
settings, through the egress proxy's allow-list all the same.

    nb-tls-tunnel serve PROXY_HOST:PORT
    nb-tls-tunnel check NAME

serve listens on 127.0.0.1:443. The program is told that the names it
asks for are at this address, so it connects here and starts TLS. The first bytes
carry the name it wants (SNI, unencrypted); this asks the egress proxy to
CONNECT to that name and then only carries bytes. TLS runs between the
program and the real server, whose certificate the program checks as
always, and the proxy's allow-list decides which names pass.

check opens TLS to NAME through the tunnel with the certificate verified
and prints ok, for nullbill verify.
"""

import asyncio
import re
import socket
import ssl
import sys

LISTEN = ("127.0.0.1", 443)
HELLO_TIMEOUT_S = 10
NAME = re.compile(r"[a-z0-9]([a-z0-9-]*[a-z0-9])?(\.[a-z0-9]([a-z0-9-]*[a-z0-9])?)+")


def server_name(hello: bytes) -> str | None:
    """The SNI host name in a TLS ClientHello handshake message."""
    try:
        if hello[0] != 1:
            return None
        at = 4 + 2 + 32  # type and length, version, random
        at += 1 + hello[at]  # session id
        at += 2 + int.from_bytes(hello[at : at + 2])  # cipher suites
        at += 1 + hello[at]  # compression methods
        end = at + 2 + int.from_bytes(hello[at : at + 2])
        at += 2
        while at + 4 <= end:
            kind, size = int.from_bytes(hello[at : at + 2]), int.from_bytes(hello[at + 2 : at + 4])
            at += 4
            if kind == 0:  # server_name: a list holding one host_name entry
                if hello[at + 2] != 0:
                    return None
                length = int.from_bytes(hello[at + 3 : at + 5])
                return hello[at + 5 : at + 5 + length].decode("ascii")
            at += size
    except (IndexError, UnicodeDecodeError):
        pass
    return None


async def read_hello(reader: asyncio.StreamReader) -> tuple[bytes, bytes]:
    """The raw records read so far and the ClientHello they carry, which may
    be split over several handshake records."""
    raw = hello = b""
    while len(hello) < 4 or len(hello) < 4 + int.from_bytes(hello[1:4]):
        header = await reader.readexactly(5)
        if header[0] != 22 or len(raw) > 65536:  # 22: a handshake record
            raise ValueError("not a TLS handshake")
        body = await reader.readexactly(int.from_bytes(header[3:5]))
        raw += header + body
        hello += body
    return raw, hello


async def pipe(reader: asyncio.StreamReader, writer: asyncio.StreamWriter) -> None:
    try:
        while data := await reader.read(65536):
            writer.write(data)
            await writer.drain()
    except OSError:
        pass
    finally:
        writer.close()


async def handle(proxy: tuple[str, int], reader: asyncio.StreamReader, writer: asyncio.StreamWriter) -> None:
    try:
        raw, hello = await asyncio.wait_for(read_hello(reader), HELLO_TIMEOUT_S)
        name = server_name(hello)
        if not name or not NAME.fullmatch(name):
            raise ValueError("no server name in the TLS handshake")
        up_reader, up_writer = await asyncio.open_connection(*proxy)
        up_writer.write(f"CONNECT {name}:443 HTTP/1.1\r\nHost: {name}:443\r\n\r\n".encode())
        await up_writer.drain()
        answer = await asyncio.wait_for(up_reader.readuntil(b"\r\n\r\n"), HELLO_TIMEOUT_S)
        status = answer.split(b"\r\n", 1)[0].decode("latin-1")
        if len(status.split()) < 2 or status.split()[1] != "200":
            up_writer.close()
            raise ValueError(f"the proxy refused {name}: {status}")
    except (ValueError, OSError, asyncio.IncompleteReadError, asyncio.LimitOverrunError, TimeoutError) as err:
        print(f"refused: {err}", flush=True)
        writer.close()
        return
    print(f"tunnel to {name}", flush=True)
    up_writer.write(raw)
    await asyncio.gather(pipe(reader, up_writer), pipe(up_reader, writer))


async def serve(proxy: tuple[str, int]) -> None:
    server = await asyncio.start_server(lambda r, w: handle(proxy, r, w), *LISTEN)
    async with server:
        await server.serve_forever()


def check(name: str) -> None:
    context = ssl.create_default_context()
    with socket.create_connection(LISTEN, HELLO_TIMEOUT_S) as sock, context.wrap_socket(sock, server_hostname=name):
        print("ok")


def main(argv: list[str]) -> int:
    if len(argv) == 3 and argv[1] == "serve":
        host, _, port = argv[2].rpartition(":")
        asyncio.run(serve((host, int(port))))
    elif len(argv) == 3 and argv[1] == "check":
        try:
            check(argv[2])
        except (OSError, ssl.SSLError) as err:
            print(f"nb-tls-tunnel: {argv[2]}: {err}", file=sys.stderr)
            return 1
    else:
        print(__doc__.split("\n\n")[1], file=sys.stderr)
        return 2
    return 0


if __name__ == "__main__":
    sys.exit(main(sys.argv))
