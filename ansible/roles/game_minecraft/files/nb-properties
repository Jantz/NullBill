#!/usr/bin/env python3
"""Generated by nullbill. Set keys in a Java properties file and leave the
rest of it alone.

    nb-properties FILE < {"key": value, ...}

Prints changed or same. Minecraft rewrites server.properties at every
start, in its own order and escaping and with every option it knows, so
the file cannot be a template: this compares what the keys mean and
rewrites a line only when its value differs.
"""

import json
import os
import re
import sys
from pathlib import Path

ESCAPES = {"t": "\t", "n": "\n", "r": "\r", "f": "\f"}


def unescape(text: str) -> str:
    def one(match: re.Match) -> str:
        code = match[1]
        return chr(int(code[1:], 16)) if code[0] == "u" and len(code) == 5 else ESCAPES.get(code, code)

    return re.sub(r"\\(u[0-9a-fA-F]{4}|.)", one, text)


def escape(text: str) -> str:
    out = []
    for i, char in enumerate(text):
        if char == "\\":
            out.append("\\\\")
        elif char in "\t\n\r\f":
            out.append("\\" + {v: k for k, v in ESCAPES.items()}[char])
        elif char == " " and i == 0:
            out.append("\\ ")
        elif not " " <= char <= "~":
            units = char.encode("utf-16-be")
            out += [f"\\u{int.from_bytes(units[j : j + 2]):04x}" for j in range(0, len(units), 2)]
        else:
            out.append(char)
    return "".join(out)


def parse(line: str) -> tuple[str, str] | None:
    """A line's key and value, or None for a comment or a blank line."""
    stripped = line.lstrip()
    if not stripped or stripped[0] in "#!":
        return None
    # The key ends at the first =, : or blank that no backslash escapes.
    match = re.match(r"((?:\\.|[^\\=:\s])*)\s*[=:]?\s*(.*)", stripped)
    return unescape(match[1]), unescape(match[2])


def text_of(value: object) -> str:
    return str(value).lower() if isinstance(value, bool) else str(value)


def main(argv: list[str]) -> int:
    if len(argv) != 2:
        print(__doc__.split("\n\n")[1], file=sys.stderr)
        return 2
    path = Path(argv[1])
    want = {key: text_of(value) for key, value in json.load(sys.stdin).items()}
    lines = path.read_text().splitlines() if path.exists() else []
    seen, changed = set(), False
    for i, line in enumerate(lines):
        parsed = parse(line)
        if parsed is None or parsed[0] not in want:
            continue
        key = parsed[0]
        seen.add(key)
        if parsed[1] != want[key]:
            lines[i] = f"{escape(key)}={escape(want[key])}"
            changed = True
    for key in sorted(want.keys() - seen):
        lines.append(f"{escape(key)}={escape(want[key])}")
        changed = True
    if changed:
        tmp = path.with_name(path.name + ".nullbill")
        tmp.write_text("\n".join(lines) + "\n")
        if path.exists():
            stat = path.stat()
            os.chown(tmp, stat.st_uid, stat.st_gid)
            os.chmod(tmp, stat.st_mode & 0o777)
        os.replace(tmp, path)
    print("changed" if changed else "same")
    return 0


if __name__ == "__main__":
    sys.exit(main(sys.argv))
