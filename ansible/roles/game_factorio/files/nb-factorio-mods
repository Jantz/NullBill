#!/usr/bin/env python3
"""Generated by nullbill. Turn the mods that come with the server on or off.

    nb-factorio-mods DATA_DIR MOD_LIST on|off

The headless server brings the Space Age expansion's mods beside the base
game and turns on every mod its list does not name. on enables them all;
off enables only those a player needs no expansion for (their info.json
has no expansion_required). Prints changed or same. Factorio rewrites the
list in its own layout, so this compares what it says.
"""

import json
import sys
from pathlib import Path


def main(argv: list[str]) -> int:
    if len(argv) != 4 or argv[3] not in ("on", "off"):
        print(__doc__.split("\n\n")[1], file=sys.stderr)
        return 2
    data, path, expansion = Path(argv[1]), Path(argv[2]), argv[3] == "on"
    want = {}
    for info in sorted(data.glob("*/info.json")):
        mod = json.loads(info.read_text())
        want[mod["name"]] = expansion or not mod.get("expansion_required", False)
    want.pop("core", None)  # the engine's own data, never in the list
    try:
        have = {m["name"]: m["enabled"] for m in json.loads(path.read_text())["mods"]}
    except (OSError, ValueError, KeyError):
        have = {}
    # Mods the owner added stay as they are.
    if all(have.get(name) == enabled for name, enabled in want.items()):
        print("same")
        return 0
    mods = have | want
    path.write_text(json.dumps({"mods": [{"name": n, "enabled": e} for n, e in mods.items()]}, indent=2) + "\n")
    print("changed")
    return 0


if __name__ == "__main__":
    sys.exit(main(sys.argv))
