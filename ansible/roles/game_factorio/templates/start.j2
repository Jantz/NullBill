#!/bin/sh
# Generated by nullbill. Factorio as its unit starts it: as user game, its
# console on the FIFO nb-game writes to. Opened read-write, so the server
# never sees it end. It loads the newest save, autosaves included.
exec /opt/factorio/{{ game_factorio_version }}/bin/x64/factorio \
  --config /etc/factorio/config.ini \
  --start-server-load-latest \
  --server-settings /etc/factorio/server-settings.json \
  --server-adminlist /var/lib/factorio/server-adminlist.json \
  --port {{ game_factorio_port }} \
  --rcon-bind 127.0.0.1:{{ game_factorio_rcon_port }} \
  --rcon-password "$(cat /etc/factorio/rcon-password)" \
  <>/run/factorio/console
