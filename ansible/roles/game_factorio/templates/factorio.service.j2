# Generated by nullbill.
[Unit]
Description=Factorio server
After=network-online.target
Wants=network-online.target

[Service]
User=game
Group=game
Environment=HOME=/var/lib/factorio
WorkingDirectory=/var/lib/factorio
UMask=0027
RuntimeDirectory=factorio
RuntimeDirectoryMode=0750
ExecStartPre=/usr/bin/mkfifo -m 0600 /run/factorio/console
ExecStart=/opt/factorio/start
# On SIGTERM the server saves the map and exits.
TimeoutStopSec=120
Restart=on-failure
RestartSec=10
NoNewPrivileges=true
ProtectSystem=strict
ReadWritePaths=/var/lib/factorio
ProtectHome=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
