# Generated by nullbill. The driver makes no device nodes by itself; PVE
# needs them in place before it starts the inference container, which it is
# given (pct config devN) at boot.
[Unit]
Description=NVIDIA device nodes for the inference container
After=systemd-modules-load.service
Before=pve-guests.service

[Service]
Type=oneshot
RemainAfterExit=true
# /dev/nvidiactl and /dev/nvidia<N> for every card.
ExecStart=/usr/bin/nvidia-smi --list-gpus
# /dev/nvidia-uvm and /dev/nvidia-uvm-tools, which CUDA and Vulkan compute use.
ExecStart=/usr/bin/nvidia-modprobe --unified-memory --create-nvidia-device-file=0

[Install]
WantedBy=multi-user.target
