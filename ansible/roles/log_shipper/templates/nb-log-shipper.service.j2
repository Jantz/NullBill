# Generated by nullbill.
[Unit]
Description=NullBill log shipper (journal to Loki)
After=network-online.target systemd-journald.service
Wants=network-online.target

[Service]
User=nb-shipper
Group=nb-shipper
SupplementaryGroups=systemd-journal
ExecStart=/usr/local/sbin/nb-log-shipper /etc/nullbill/shipper/config.json
StateDirectory=nb-log-shipper
Restart=always
RestartSec=5
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
