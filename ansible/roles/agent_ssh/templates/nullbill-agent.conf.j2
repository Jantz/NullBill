# Generated by nullbill. Certificates signed by the CA's SSH user key log
# in only as a user whose principals file names a principal on the
# certificate. Only {{ agent_ssh_user }} has one, so no certificate logs in
# as root. Other users keep their authorized_keys.
TrustedUserCAKeys /etc/ssh/nullbill_user_ca.pub
AuthorizedPrincipalsFile /etc/ssh/auth_principals/%u

# The agent's access ends when its certificate expires: it cannot add a key
# of its own, use a password, or open tunnels through the guest. Every
# session runs one command, which nb-agent-command records first.
Match User {{ agent_ssh_user }}
    ForceCommand /usr/local/sbin/nb-agent-command
    PermitTTY no
    AuthorizedKeysFile none
    AuthenticationMethods publickey
    PasswordAuthentication no
    KbdInteractiveAuthentication no
    DisableForwarding yes
    PermitUserRC no
Match all
