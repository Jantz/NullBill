#!/usr/bin/env bash
# Block staged secrets and deny-listed identifiers.
set -euo pipefail
cd "$(git rev-parse --show-toplevel)"

if ! command -v gitleaks >/dev/null; then
  echo "pre-commit: gitleaks is not installed; refusing to commit" >&2
  exit 1
fi
gitleaks git --pre-commit --staged --redact --no-banner -c .gitleaks.toml

# Added lines and file names of the staged change; empty for an empty commit.
git diff --cached --no-color --unified=0 | { grep -E '^(\+|diff --git)' || true; } | tools/denylist-scan
